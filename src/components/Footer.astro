---
import { Icon } from "astro-icon/components";

const links = [
  { label: "Home", href: "#hero" },
  { label: "Projects", href: "#projects" },
  { label: "Experience", href: "#experience" },
  { label: "Contact", href: "#contact" },
];

const socials = [
  {
    label: "GitHub",
    href: "https://github.com/GaboInsane6489",
    icon: "tabler:brand-github",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/gabriel-gonzalez-fullstack/",
    icon: "tabler:brand-linkedin",
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/dreamsfallen6488/",
    icon: "tabler:brand-instagram",
  },
  {
    label: "YouTube",
    href: "https://www.youtube.com/@Gabo6489Gaming-pe2tg",
    icon: "tabler:brand-youtube",
  },
];
---

<footer
  class="relative w-full overflow-hidden border-t border-white/5 bg-[#0A0908] pt-24 pb-12 text-white"
>
  <div class="pointer-events-none absolute inset-0 z-0">
    <div
      class="absolute inset-0 [background-image:linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] [background-size:32px_32px]"
    >
    </div>

    <div
      class="absolute inset-0 [background-image:linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.02),rgba(0,255,0,0.01),rgba(0,0,255,0.02))] [background-size:100%_4px,3px_100%]"
    >
    </div>

    <div
      class="absolute -top-24 -left-24 h-96 w-96 rounded-full bg-amber-500/5 blur-[120px]"
    >
    </div>
    <div
      class="absolute -right-24 -bottom-24 h-96 w-96 rounded-full bg-blue-500/5 blur-[120px]"
    >
    </div>

    <div
      class="absolute top-0 left-0 h-[2px] w-full bg-gradient-to-r from-transparent via-amber-500/40 to-transparent"
    >
      <div class="absolute inset-0 animate-pulse bg-amber-400 blur-[2px]"></div>
    </div>
  </div>

  <div class="relative z-10 mx-auto max-w-[1600px] px-6 lg:px-12">
    <div class="grid grid-cols-1 gap-16 lg:grid-cols-12 lg:gap-12">
      <div class="space-y-8 lg:col-span-5">
        <div class="flex items-center gap-5">
          <div
            class="group relative h-14 w-14 transition-transform duration-500 hover:scale-110"
          >
            <div
              class="animate-spin-slow absolute inset-0 rounded-xl border border-amber-500/20 bg-amber-500/5 [animation-duration:10s]"
            >
            </div>
            <div
              class="absolute inset-2 flex items-center justify-center overflow-hidden rounded-lg border border-white/10 bg-[#0D0C0B] shadow-2xl"
            >
              <img
                src="/images/LogoPortafolio.webp"
                alt="Logo"
                class="h-8 w-8 object-contain transition-transform duration-500 group-hover:scale-125"
              />
            </div>
          </div>
          <div class="flex flex-col">
            <h2
              class="text-2xl font-black tracking-tighter text-white uppercase italic sm:text-3xl"
            >
              Gabriel González
            </h2>
            <div
              class="flex items-center gap-2 font-mono text-[9px] font-bold tracking-[0.4em] text-amber-500"
            >
              <span
                class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-amber-500"
              ></span>
              DIGITAL ARCHITECT // MASTER_DEV
            </div>
          </div>
        </div>

        <p
          class="max-w-md font-sans text-sm leading-relaxed font-light text-gray-400 sm:text-base"
        >
          Construyendo el futuro a través de <span
            class="text-gray-100 underline decoration-amber-500/30 underline-offset-4"
            >código de alto rendimiento</span
          >. Especialista en orquestación de sistemas y diseño técnico
          minimalista.
        </p>

        <a
          href="mailto:gabrielgg2005ve@gmail.com"
          class="group relative inline-flex items-center gap-4 overflow-hidden rounded-xl border border-white/5 bg-white/[0.02] px-6 py-3 transition-all hover:border-amber-500/30"
        >
          <div
            class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-amber-500/5 to-transparent transition-transform duration-500 group-hover:translate-x-full"
          >
          </div>
          <Icon
            name="tabler:mail"
            size={18}
            class="text-amber-500 transition-transform group-hover:rotate-12"
          />
          <span
            class="font-mono text-xs tracking-widest text-gray-300 group-hover:text-white"
            >gabrielgg2005ve@gmail.com</span
          >
        </a>
      </div>

      <div class="lg:col-span-3">
        <h4
          class="mb-10 flex items-center gap-3 font-mono text-[10px] font-bold tracking-[0.5em] text-gray-600 uppercase"
        >
          <span class="h-[1px] w-4 bg-gray-800"></span> // SYSTEM_INDEX
        </h4>
        <ul class="space-y-5">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="group flex items-center text-gray-500 transition-all hover:text-white"
                >
                  <span class="font-mono text-[11px] tracking-[0.2em] uppercase transition-all group-hover:tracking-[0.3em]">
                    {link.label}
                  </span>
                  <Icon
                    name="tabler:chevron-right"
                    size={12}
                    class="ml-2 -translate-x-2 text-amber-500 opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-4">
        <h4
          class="mb-10 flex items-center gap-3 font-mono text-[10px] font-bold tracking-[0.5em] text-gray-600 uppercase"
        >
          <span class="h-[1px] w-4 bg-gray-800"></span> // EXTERNAL_NODES
        </h4>
        <div class="grid grid-cols-2 gap-4 sm:gap-6">
          {
            socials.map((social) => (
              <a
                href={social.href}
                target="_blank"
                class="group relative flex flex-col gap-3 rounded-2xl border border-white/5 bg-white/[0.01] p-4 transition-all duration-500 hover:-translate-y-2 hover:border-amber-500/20 hover:bg-white/[0.03]"
              >
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-black/50 text-gray-500 shadow-inner group-hover:text-amber-500 group-hover:shadow-amber-500/10">
                  <Icon name={social.icon} size={22} />
                </div>
                <span class="font-mono text-[10px] tracking-widest text-gray-500 uppercase group-hover:text-white">
                  {social.label}
                </span>
                <div class="absolute top-2 right-2 h-1 w-1 rounded-full bg-white/10 group-hover:bg-amber-500" />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div
      class="mt-24 flex flex-col items-center justify-between gap-10 border-t border-white/5 pt-12 md:flex-row"
    >
      <div class="space-y-2 text-center md:text-left">
        <p
          class="font-mono text-[10px] tracking-[0.3em] text-gray-500 uppercase"
        >
          &copy; {new Date().getFullYear()} Gabriel González // <span
            class="text-amber-500/40">SECURED_ENCLAVE</span
          >
        </p>
        <div class="h-1 w-24 overflow-hidden rounded-full bg-white/5">
          <div class="animate-loading-bar h-full w-1/3 bg-amber-500/50"></div>
        </div>
      </div>

      <div class="flex flex-wrap justify-center gap-6">
        <div
          class="flex items-center gap-3 rounded-full border border-white/5 bg-black/40 px-6 py-2.5 shadow-xl backdrop-blur-sm"
        >
          <div class="relative h-2 w-2">
            <div
              class="absolute inset-0 animate-ping rounded-full bg-green-500 opacity-20"
            >
            </div>
            <div
              class="h-full w-full rounded-full bg-green-500 shadow-[0_0_10px_rgba(34,197,94,0.8)]"
            >
            </div>
          </div>
          <span
            class="font-mono text-[10px] tracking-tighter text-gray-400 uppercase"
            >KERNEL_STATUS: OPTIMAL</span
          >
          <div class="mx-2 h-4 w-px bg-white/10"></div>
          <span class="font-mono text-[10px] text-amber-500/70"
            >LATENCY: 14MS</span
          >
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  @keyframes loading-bar {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(300%);
    }
  }
  .animate-loading-bar {
    animation: loading-bar 3s infinite linear;
  }
  .animate-spin-slow {
    animation: spin 10s linear infinite;
  }
  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
</style>
