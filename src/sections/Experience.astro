---
import { Icon } from "astro-icon/components";
import EmblaCarousel from "../components/ui/EmblaCarousel.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const HarryPotterHeadForumImages = Array.from(
  { length: 15 },
  (_, i) => `/images/HarryPotterHead${i + 1}.webp`,
);
---

<section
  id="experience"
  class="relative border-t border-white/5 py-10 lg:py-20 overflow-clip"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(165,166,246,0.08),transparent_50%),radial-gradient(circle_at_80%_80%,rgba(246,165,165,0.05),transparent_50%)]"
  >
  </div>

  <div class="relative mx-auto w-full max-w-[1400px] px-6">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="space-y-6 lg:sticky lg:top-32 lg:col-span-4 lg:h-fit">
        <div class="reveal flex items-center gap-3">
          <span class="h-[1px] w-8 bg-lofi-accent/40"></span>
          <span
            class="font-mono text-[10px] font-black tracking-[0.3em] text-lofi-accent uppercase"
          >
            {t("exp.badge")}
          </span>
        </div>
        <h2
          class="reveal font-serif text-3xl leading-tight text-white md:text-5xl"
        >
          {t("exp.title1")}
          <br class="hidden lg:block" />
          <span
            class="bg-gradient-to-r from-lofi-accent to-lofi-soft bg-clip-text text-transparent italic"
            >{t("exp.title2")}</span
          >
        </h2>
        <p
          class="reveal max-w-sm font-mono text-[11px] leading-relaxed text-slate-300"
          set:html={t("exp.description")}
        />

        <!-- NEW: Experience HUD Modules -->
        <div class="reveal delay-100 flex flex-col gap-6 pt-4">
          <!-- Stats Grid: System Uptime -->
          <div class="grid grid-cols-2 gap-3">
             {[
               { label: "EXP_LEVEL", val: "3+ YRS" },
               { label: "PROJECTS", val: "15+ UNIT" },
               { label: "STACK_MASTER", val: "FULLSTACK" },
               { label: "SYS_UPTIME", val: "99.9%" }
             ].map((stat) => (
               <div class="group/stat relative overflow-hidden rounded-lg border border-white/5 bg-white/[0.02] p-3 transition-all hover:border-lofi-accent/30 hover:bg-lofi-accent/5">
                 <div class="flex flex-col gap-1">
                   <span class="font-mono text-[8px] font-bold text-white/50 uppercase tracking-widest">{stat.label}</span>
                   <span class="font-mono text-[11px] font-black text-lofi-accent group-hover/stat:text-white transition-colors">{stat.val}</span>
                 </div>
                 <div class="absolute -right-2 -bottom-2 opacity-0 group-hover/stat:opacity-10 transition-opacity">
                    <Icon name="tabler:settings-2" size={24} class="rotate-45" />
                 </div>
               </div>
             ))}
          </div>

          <!-- Active Protocol HUD -->
          <div class="relative overflow-hidden rounded-xl border border-lofi-accent/20 bg-lofi-accent/5 p-4">
             <div class="flex items-center gap-3">
                <div class="relative flex h-3 w-3">
                   <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-lofi-pop opacity-75"></span>
                   <span class="relative inline-flex h-3 w-3 rounded-full bg-lofi-pop"></span>
                </div>
                <div class="flex flex-col">
                   <span class="font-mono text-[8px] font-black text-lofi-pop/80 tracking-[0.3em] uppercase drop-shadow-[0_0_5px_rgba(246,165,165,0.4)]">SYSTEM_PROTOCOL_ACTIVE</span>
                   <span class="font-mono text-[10px] font-bold text-white uppercase italic tracking-tight">Main Mission: Scalability & Architecture</span>
                </div>
             </div>
             
             <!-- Decorative HUD Line -->
             <div class="mt-3 h-px w-full bg-gradient-to-r from-lofi-accent/50 via-lofi-accent/20 to-transparent"></div>
          </div>

          <!-- NEW: Tech Stack Pulse -->
          <div class="relative overflow-hidden rounded-xl border border-white/5 bg-white/[0.01] p-4">
             <div class="mb-3 flex justify-between items-center">
                <span class="font-mono text-[9px] font-black text-lofi-accent tracking-widest uppercase drop-shadow-[0_0_8px_rgba(165,166,246,0.3)]">{t("exp.pulse.title")}</span>
                <span class="font-mono text-[8px] text-white/70">{t("exp.pulse.calibration")}</span>
             </div>
             <div class="space-y-3">
                {[
                  { label: "CORE_JS", val: 95, color: "bg-amber-400" },
                  { label: "ENGINEERING", val: 88, color: "bg-lofi-accent" },
                  { label: "CLOUD_SYN", val: 82, color: "bg-lofi-pop" }
                ].map((bar) => (
                  <div class="space-y-1">
                    <div class="flex justify-between font-mono text-[7px] text-white/60 uppercase tracking-tighter">
                      <span>{bar.label}</span>
                      <span>{bar.val}%</span>
                    </div>
                    <div class="h-1 w-full bg-white/5 rounded-full overflow-hidden">
                      <div class={`h-full ${bar.color} opacity-100 drop-shadow-[0_0_5px_currentColor] rounded-full`} style={`width: ${bar.val}%`}></div>
                    </div>
                  </div>
                ))}
             </div>
          </div>
        </div>

        <!-- NEW: Operational Logs (Fills vertical space) -->
        <div class="reveal delay-200 mt-6 rounded-lg border border-white/5 bg-white/[0.02] p-3 font-mono text-[9px] backdrop-blur-md">
           <div class="mb-2 flex items-center gap-2 border-b border-white/5 pb-2">
              <div class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
              <span class="text-white/40 uppercase tracking-widest">{t("exp.logs.title")}</span>
           </div>
           <ul class="space-y-1.5 text-white/90">
              <li class="flex gap-2">
                 <span class="text-white/20">[01]</span>
                 <span class="text-emerald-500/70">{t("exp.logs.item1")}</span>
              </li>
              <li class="flex gap-2">
                 <span class="text-white/20">[02]</span>
                 <span class="text-lofi-accent/70">{t("exp.logs.item2")}</span>
              </li>
              <li class="flex gap-2">
                 <span class="text-white/20">[03]</span>
                 <span class="text-lofi-pop/70">{t("exp.logs.item3")}</span>
              </li>
              <li class="flex gap-2">
                 <span class="text-white/20">[04]</span>
                 <span class="text-amber-400/70">{t("exp.logs.item4")}</span>
              </li>
           </ul>
        </div>


        <!-- Visual Schematic Filler (Background) -->
        <div class="reveal delay-300 pointer-events-none relative mt-4 h-40 w-full opacity-60">
          <svg width="100%" height="100%" viewBox="0 0 400 160" class="text-lofi-accent">
            <path d="M 0 20 L 380 20 L 380 140 L 20 140 Z" fill="none" stroke="currentColor" stroke-width="0.5" stroke-dasharray="4 4" />
            <circle cx="20" cy="20" r="2" fill="currentColor" />
            <circle cx="380" cy="20" r="2" fill="currentColor" />
            <circle cx="380" cy="140" r="2" fill="currentColor" />
            <circle cx="20" cy="140" r="2" fill="currentColor" />
            <path d="M 40 40 L 100 40 M 40 50 L 120 50" stroke="currentColor" stroke-width="0.5" />
            <rect x="250" y="40" width="80" height="40" fill="currentColor" fill-opacity="0.05" stroke="currentColor" stroke-width="0.5" />
            <text x="255" y="55" font-family="monospace" font-size="8" fill="currentColor" fill-opacity="0.5">PROC_CORE_LOAD</text>
            <path d="M 20 140 L 60 100 L 100 120 L 140 80" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.3" />
          </svg>
        </div>
      </div>

      <div
        class="relative ml-2 space-y-10 pl-8 md:pl-12 lg:col-span-8 lg:ml-0 lg:pl-16"
      >
        <!-- Dynamic Timeline Path -->
        <div class="absolute top-0 left-0 h-full w-px bg-gradient-to-b from-lofi-pop/50 via-white/10 to-transparent origin-top scale-y-0 transition-transform duration-[2000ms] cubic-bezier(0.16, 1, 0.3, 1) reveal-line"></div>
        <div class="reveal reveal-right group relative">
          <!-- Tactical Timeline Node -->
          <div
            class="absolute top-2 -left-[50px] h-4 w-4 rounded-full border border-lofi-pop bg-white/[0.02] backdrop-blur-sm transition-all duration-300 lg:-left-[74px] lg:h-6 lg:w-6 shadow-[0_0_15px_rgba(246,165,165,0.4)]"
          >
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="h-1.5 w-1.5 animate-pulse rounded-full bg-lofi-pop">
              </div>
            </div>
            <div
              class="absolute top-1/2 -right-20 h-px w-16 bg-gradient-to-r from-lofi-pop/20 to-transparent lg:-right-24 lg:w-20"
            >
            </div>
          </div>

          <div class="space-y-6">
            <div
              class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
            >
              <div class="space-y-1">
                <span
                  class="font-mono text-[8px] font-bold tracking-[0.2em] text-lofi-accent drop-shadow-[0_0_5px_currentColor] uppercase"
                  >MISSION_ACTIVE // PRD_STP</span
                >
                <h3
                  class="font-serif text-2xl text-white transition-colors group-hover:text-lofi-soft md:text-3xl"
                >
                  {t("exp.garcia.role")}
                </h3>
              </div>
              <div class="flex flex-col items-end gap-1">
                <span
                  class="w-fit rounded border border-lofi-accent/20 bg-lofi-accent/5 px-3 py-1 font-mono text-[10px] font-bold tracking-tighter text-lofi-accent"
                >
                  {t("exp.garcia.date")}
                </span>
                <span
                  class="font-mono text-[8px] font-bold text-slate-400 uppercase"
                  >AUTH: SENIOR_ENGINEER</span
                >
              </div>
            </div>

            <div
              class="flex items-center gap-3 rounded-lg border border-white/5 bg-white/[0.02] p-4 group-hover:border-lofi-accent/10"
            >
              <div
                class="flex h-10 w-10 items-center justify-center rounded-lg bg-lofi-accent/5 text-lofi-accent/30"
              >
                <Icon name="tabler:briefcase" size={20} />
              </div>
              <div class="flex flex-col">
                <span
                  class="font-mono text-[9px] font-bold text-lofi-accent drop-shadow-[0_0_5px_currentColor] uppercase"
                  >ENTITY_NODE</span
                >
                <span
                  class="font-bold text-white transition-colors group-hover:text-lofi-soft"
                  >Instalaciones García</span
                >
              </div>
            </div>

            <p
              class="max-w-2xl font-mono text-[12px] leading-relaxed font-medium text-slate-300"
              set:html={t("exp.garcia.desc")}
            />
            
            <div class="flex items-center gap-2 pt-2">
               <span class="px-2 py-0.5 rounded border border-lofi-accent/30 bg-lofi-accent/10 text-[9px] font-bold text-lofi-accent uppercase tracking-widest">ACHIEVEMENT_UNLOCKED</span>
               <span class="font-mono text-[10px] text-white/60 italic">{t("exp.garcia.achievement")}</span>
            </div>
          </div>
        </div>

        <div class="reveal reveal-right group relative delay-100">
          <div
            class="absolute top-2 -left-[50px] h-4 w-4 rounded-full border border-white/20 bg-white/[0.02] backdrop-blur-sm transition-all duration-300 lg:-left-[74px] lg:h-6 lg:w-6"
          >
          </div>

          <div class="space-y-6">
            <div
              class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
            >
              <div class="space-y-1">
                <span
                  class="font-mono text-[8px] font-bold tracking-[0.2em] text-slate-400 uppercase"
                  >MISSION_LOG // ARC_2.4</span
                >
                <h3
                  class="font-serif text-2xl text-white transition-colors group-hover:text-white md:text-3xl"
                >
                  {t("exp.hph.role")}
                </h3>
              </div>
              <div class="flex flex-col items-end gap-1">
                <span
                  class="w-fit rounded border border-white/20 bg-white/5 px-3 py-1 font-mono text-[10px] font-black text-slate-300"
                >
                  {t("exp.hph.date")}
                </span>
                <span
                  class="font-mono text-[8px] font-bold text-slate-500 uppercase"
                  >DEP_ID: HPH_FORUM</span
                >
              </div>
            </div>

            <div
              class="flex items-center gap-3 rounded-lg border border-white/5 bg-white/[0.02] p-4 group-hover:border-white/10"
            >
              <div
                class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/5 text-gray-600"
              >
                <Icon name="tabler:users-group" size={20} />
              </div>
              <div class="flex flex-col">
                <span
                  class="font-mono text-[9px] font-bold text-slate-500 uppercase"
                  >COMMUNITY_INFRA</span
                >
                <span class="font-bold text-slate-200">Harry Potter Head</span>
              </div>
            </div>

            <p
              class="max-w-2xl font-mono text-[12px] leading-relaxed text-slate-400"
              set:html={t("exp.hph.desc")}
            />

            <div class="flex items-center gap-2 pt-2">
               <span class="px-2 py-0.5 rounded border border-lofi-pop/30 bg-lofi-pop/10 text-[9px] font-bold text-lofi-pop uppercase tracking-widest animate-pulse">ACHIEVEMENT_UNLOCKED</span>
               <span class="font-mono text-[10px] text-white/60 italic">{t("exp.hph.achievement")}</span>
            </div>

            <div
              class="reveal reveal-scale mt-6 max-w-2xl overflow-hidden rounded-2xl border border-white/10 bg-white/[0.02] backdrop-blur-sm shadow-xl group-hover:scale-[1.01]"
            >
              <div class="aspect-video sm:aspect-auto">
                <EmblaCarousel images={HarryPotterHeadForumImages} />
              </div>
              <div
                class="flex items-center justify-between bg-white/[0.02] backdrop-blur-sm px-5 py-3 font-mono text-[10px] font-black tracking-[0.2em] text-gray-600 uppercase"
              >
                <span class="flex items-center gap-2 italic">
                  <Icon
                    name="tabler:archive"
                    size={14}
                    class="text-lofi-accent/40"
                  />
                  {t("exp.hph.archive")}
                </span>
                <span class="opacity-80">v2.4.0 // LATEST_STABLE</span>
              </div>
            </div>
          </div>
        </div>

        <div class="reveal reveal-right group relative delay-200">
          <div
            class="absolute top-2 -left-[50px] h-4 w-4 rounded-full border border-lofi-mid bg-white/[0.02] backdrop-blur-sm transition-all duration-300 lg:-left-[74px] lg:h-6 lg:w-6"
          >
          </div>
          <div class="space-y-6">
            <div
              class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
            >
              <div class="space-y-1">
                <span
                  class="font-mono text-[8px] font-black tracking-[0.2em] text-lofi-mid/60 uppercase"
                  >ACADEMIC_ORCHESTRATION</span
                >
                <h3 class="font-serif text-2xl text-white md:text-3xl">
                  {t("exp.ucab.role")}
                </h3>
              </div>
              <span
                class="w-fit rounded border border-lofi-mid/30 bg-lofi-mid/10 px-3 py-1 font-mono text-[10px] font-black text-lofi-mid uppercase"
              >
                UCAB • 3RD SEMESTER
              </span>
            </div>

            <div
              class="flex items-center gap-3 rounded-lg border border-lofi-mid/5 bg-lofi-mid/5 p-4 group-hover:border-lofi-mid/10"
            >
              <div
                class="flex h-10 w-10 items-center justify-center rounded-lg bg-lofi-mid/10 text-lofi-mid/40 transition-colors group-hover:text-lofi-mid"
              >
                <Icon name="tabler:school" size={20} />
              </div>
              <div class="flex flex-col">
                <span
                  class="font-mono text-[9px] font-bold text-lofi-mid/40 uppercase"
                  >INSTITUTION_NODE</span
                >
                <span class="font-bold text-slate-300">UCAB</span>
              </div>
            </div>

            <p
              class="max-w-2xl font-mono text-[12px] leading-relaxed font-medium text-slate-400 italic"
              set:html={t("exp.ucab.desc")}
            />

            <div class="flex items-center gap-2 pt-2 opacity-60 grayscale hover:grayscale-0 hover:opacity-100 transition-all">
               <span class="px-2 py-0.5 rounded border border-white/20 bg-white/5 text-[9px] font-bold text-white uppercase tracking-widest">ACADEMIC_MILESTONE</span>
               <span class="font-mono text-[10px] text-white/40 italic">{t("exp.ucab.achievement")}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .reveal-line.active {
    transform: scale-y(1);
  }

  /* Soft reveal curve for experience blocks */
  :global(.reveal.active) {
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>

<script>
  const setupExperience = () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('active');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    const line = document.querySelector('.reveal-line');
    if (line) observer.observe(line);
  };

  setupExperience();
  document.addEventListener("astro:after-swap", setupExperience);
</script>
