---
import { Icon } from "astro-icon/components";
---

<section
  id="certificates"
  class="relative overflow-hidden rounded-2xl border border-white/10 bg-slate-900/50 shadow-2xl"
>
  <video
    src="/videos/Amiya-Room-Arknights.mp4"
    class="absolute inset-0 z-0 h-full w-full object-cover opacity-60 blur-[2px]"
    autoplay
    loop
    muted
    playsinline></video>

  <div
    class="absolute inset-0 z-10 bg-gradient-to-t from-slate-950 via-slate-900/40 to-transparent"
  >
  </div>

  <div
    class="relative z-20 flex flex-col gap-8 p-8 md:flex-row md:items-center md:p-12"
  >
    <div class="flex flex-1 flex-col items-center justify-center text-center">
      <h2
        class="mb-6 text-sm font-bold tracking-[0.3em] text-blue-400 uppercase"
      >
        Credentials
      </h2>
      <div class="group relative">
        <img
          src="/images/FullStackCertificate.webp"
          alt="Certificate Full Stack"
          class="w-full max-w-[280px] rounded-lg shadow-2xl transition-all duration-500 group-hover:scale-105 group-hover:rotate-1"
        />
        <div
          class="absolute inset-0 rounded-lg bg-white/10 opacity-0 transition-opacity group-hover:opacity-100"
        >
        </div>
      </div>
    </div>

    <div class="flex-[1.5] text-white">
      <header class="mb-6">
        <h3 class="text-3xl font-bold tracking-tight md:text-4xl">
          Certificado <span class="text-blue-400">Full Stack</span> Developer
        </h3>
        <p class="mt-4 leading-relaxed text-slate-300">
          Culminé un programa intensivo de un año con honores, destacando por el <strong
            class="text-white">mejor proyecto de la cohorte</strong
          >. Desarrollé soluciones integrales a problemas reales mediante un
          enfoque práctico y técnico.
        </p>
      </header>

      <ul class="grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
        {
          [
            { name: "Fundamentos", icon: "tabler:cpu" },
            { name: "HTML & CSS", icon: "tabler:brand-html5" },
            { name: "JavaScript Pro", icon: "tabler:brand-javascript" },
            { name: "Backend (Node/Mongo)", icon: "tabler:database" },
            { name: "Frontend (React/Redux)", icon: "tabler:brand-react" },
            { name: "Proyecto Final", icon: "tabler:brand-github" },
          ].map((item) => (
            <li class="flex items-center gap-2 rounded-lg border border-white/5 bg-white/5 p-3 transition-colors hover:bg-white/10">
              <Icon name={item.icon} class="text-xl text-blue-400" />
              <span class="text-slate-200">{item.name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
