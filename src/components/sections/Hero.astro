---
import { Icon } from "astro-icon/components";
---

<section
  class="relative flex min-h-screen w-full items-center justify-center overflow-hidden border-b border-white/5 pt-32 pb-20 lg:pt-0 lg:pb-0"
  id="hero"
>
  <div
    class="grid-bg pointer-events-none absolute inset-0 opacity-15 md:opacity-25"
  >
  </div>

  <div class="relative mx-auto w-full max-w-[1300px] px-6 sm:px-12 lg:px-16">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-8">
      <div
        class="reveal relative order-first col-span-1 flex justify-center opacity-0 transition-all delay-700 duration-1000 lg:order-last lg:col-span-5"
      >
        <div
          class="relative z-10 w-full max-w-[200px] rounded-2xl border border-white/10 bg-[#0A0908]/50 p-1.5 backdrop-blur-xl sm:max-w-[240px] md:max-w-[280px] lg:max-w-[320px]"
        >
          <div
            class="overflow-hidden rounded-xl border border-white/5 bg-[#050505] shadow-2xl"
          >
            <div
              class="flex items-center justify-between border-b border-white/5 bg-[#0F0F0F] px-4 py-2"
            >
              <div class="flex gap-1.5">
                <div class="h-1.5 w-1.5 rounded-full bg-red-500/20"></div>
                <div class="h-1.5 w-1.5 rounded-full bg-yellow-500/20"></div>
                <div class="h-1.5 w-1.5 rounded-full bg-green-500/20"></div>
              </div>
              <div
                class="font-mono text-[7px] tracking-[0.2em] text-gray-600 uppercase"
              >
                env:production
              </div>
            </div>

            <div class="group relative aspect-[4/5] overflow-hidden">
              <img
                src="/images/FotoPerfil.webp"
                alt="Gabriel Gonzalez Profile"
                class="h-full w-full object-cover opacity-80 grayscale transition-all duration-700 group-hover:opacity-100 group-hover:grayscale-0"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-[#050505] via-transparent to-transparent"
              >
              </div>
              <div
                class="absolute bottom-3 left-3 rounded-lg border border-white/5 bg-black/60 px-2.5 py-1.5 font-mono text-[8px] text-amber-500 backdrop-blur-md"
              >
                <span class="animate-pulse">></span> online_active
              </div>
            </div>
          </div>
        </div>
        <div
          class="absolute -inset-10 -z-10 rounded-full bg-amber-500/10 opacity-20 blur-[60px]"
        >
        </div>
      </div>

      <div
        class="flex flex-col items-center justify-center space-y-8 text-center lg:col-span-7 lg:items-start lg:text-left"
      >
        <div class="space-y-6">
          <div
            class="reveal translate-y-4 opacity-0 transition-all duration-700 ease-out"
          >
            <div
              class="inline-flex items-center gap-2 rounded-full border border-amber-500/20 bg-amber-500/5 px-3 py-1.5 backdrop-blur-md"
            >
              <span class="relative flex h-2 w-2">
                <span
                  class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-75"
                ></span>
                <span
                  class="relative inline-flex h-2 w-2 rounded-full bg-amber-500"
                ></span>
              </span>
              <span
                class="font-mono text-[9px] font-bold tracking-[0.2em] text-amber-500 uppercase"
                >Status: Ready for Deployment</span
              >
            </div>
          </div>

          <h1
            class="reveal translate-y-4 font-sans text-[clamp(2.5rem,8vw,4rem)] leading-[1.05] font-extrabold tracking-tighter text-white opacity-0 transition-all delay-150 duration-700"
          >
            Building Next-Gen <br />
            <span
              class="bg-gradient-to-r from-white via-white/80 to-white/40 bg-clip-text text-transparent"
              >Web Experiences</span
            >
          </h1>

          <p
            class="reveal mx-auto max-w-lg translate-y-4 text-base leading-relaxed font-light text-gray-400 opacity-0 transition-all delay-300 duration-700 md:text-lg lg:mx-0"
          >
            Computer Engineering student and <span
              class="font-medium text-white">Full Stack Developer</span
            >. I build structured, maintainable, and efficient applications from
            the ground up.
          </p>
        </div>

        <div
          class="reveal flex w-full translate-y-4 flex-col gap-4 opacity-0 transition-all delay-[450ms] duration-700 sm:flex-row sm:justify-center lg:justify-start"
        >
          <a
            href="#projects"
            class="group relative flex items-center justify-center gap-3 overflow-hidden rounded-xl bg-white px-8 py-4 text-[10px] font-black tracking-widest text-black transition-all hover:bg-amber-400 active:scale-95 sm:w-auto sm:py-3.5"
          >
            <span>EXPLORE WORK</span>
            <Icon
              name="tabler:arrow-right"
              size={18}
              class="transition-transform group-hover:translate-x-1"
            />
          </a>
          <a
            href="#contact"
            class="group flex items-center justify-center gap-3 rounded-xl border border-white/10 bg-white/5 px-8 py-4 text-[10px] font-black tracking-widest text-white transition-all hover:bg-white/10 active:scale-95 sm:w-auto sm:py-3.5"
          >
            <span>CONNECT</span>
          </a>
        </div>

        <div
          class="reveal grid w-full max-w-sm grid-cols-2 gap-6 border-t border-white/5 pt-8 opacity-0 transition-opacity delay-[600ms] duration-1000 sm:max-w-md sm:grid-cols-3 lg:max-w-none"
        >
          <div class="flex flex-col items-center space-y-1.5 lg:items-start">
            <span
              class="font-mono text-[8px] tracking-[0.2em] text-gray-600 uppercase"
              >Education</span
            >
            <span class="block text-[10px] font-medium text-gray-300"
              >UCAB Engineering</span
            >
          </div>
          <div class="flex flex-col items-center space-y-1.5 lg:items-start">
            <span
              class="font-mono text-[8px] tracking-[0.2em] text-gray-600 uppercase"
              >Mindset</span
            >
            <span class="block text-[10px] font-medium text-amber-500"
              >Scalable Logic</span
            >
          </div>
          <div
            class="col-span-2 flex flex-col items-center space-y-1.5 sm:col-span-1 lg:items-start"
          >
            <span
              class="font-mono text-[8px] tracking-[0.2em] text-gray-600 uppercase"
              >Tools</span
            >
            <span class="block text-[10px] font-medium text-gray-300"
              >Next.js · Supabase · Git</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
