---
import { Icon } from "astro-icon/components";
import EmblaCarousel from "../components/ui/EmblaCarousel.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const luzInteriorImages = Array.from(
  { length: 11 },
  (_, i) => `/images/LuzInterior${i + 1}.webp`,
);
const InstalacionesGarciasImages = Array.from(
  { length: 13 },
  (_, i) => `/images/InstalacionesGarcias${i + 1}.webp`,
);
---

<section id="projects" class="relative overflow-hidden pb-16 lg:pb-24">
  <div
    class="pointer-events-none absolute top-0 left-1/2 h-full w-full -translate-x-1/2 bg-[radial-gradient(circle_at_top,rgba(252,211,77,0.05),transparent_60%)]"
  >
  </div>

  <div class="relative mx-auto w-full max-w-[1400px] px-6">
    <div
      class="mb-10 flex flex-col justify-between gap-6 md:flex-row md:items-end lg:mb-16"
    >
      <div class="reveal space-y-4">
        <div class="flex items-center gap-3">
          <span class="h-px w-8 bg-amber-500/50"></span>
          <span
            class="font-mono text-[10px] font-bold tracking-[0.4em] text-amber-500 uppercase"
            >{t("projects.badge")}</span
          >
        </div>
        <h2
          class="font-serif text-5xl leading-[1.1] text-white md:text-7xl lg:text-8xl"
        >
          {t("projects.title1")}
          <span
            class="bg-gradient-to-r from-amber-400 to-amber-600 bg-clip-text text-transparent italic"
            >{t("projects.title2")}</span
          >
        </h2>
      </div>
      <p
        class="reveal max-w-[280px] font-mono text-[11px] leading-relaxed text-slate-300 md:text-right"
        set:html={t("projects.description")}
      />
    </div>

    <div class="space-y-20 md:space-y-32">
      <article
        class="group relative grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center"
      >
        <!-- Project Data Content -->
        <div
          class="reveal reveal-left order-2 flex flex-col justify-center space-y-6 lg:order-1 lg:col-span-5 lg:space-y-8"
        >
          <div class="space-y-4">
            <div class="flex items-center gap-3 text-amber-500/80">
              <Icon name="tabler:terminal-2" class="text-xl" />
              <span
                class="font-mono text-[10px] font-black tracking-widest text-amber-500 uppercase drop-shadow-[0_0_8px_rgba(245,158,11,0.3)]"
                >{t("projects.marti.badge")}</span
              >
            </div>
            <h3
              class="font-serif text-[clamp(1.75rem,5vw,2.5rem)] text-white md:text-6xl"
            >
              Martí Academy OS
            </h3>
            <p
              class="text-lg leading-relaxed text-slate-300"
              set:html={t("projects.marti.description")}
            />
          </div>

          <!-- Status Indicator -->
          <div class="flex items-center gap-4">
            <div
              class="flex items-center gap-2 rounded border border-amber-500/20 bg-amber-500/5 px-2 py-0.5 font-mono text-[9px] text-amber-500 uppercase"
            >
              <span class="relative flex h-1.5 w-1.5">
                <span
                  class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-500 opacity-75"
                ></span>
                <span
                  class="relative inline-flex h-1.5 w-1.5 rounded-full bg-amber-500"
                ></span>
              </span>
              STABLE_DEPLOYMENT
            </div>
            <span
              class="font-mono text-[9px] font-bold tracking-tighter text-slate-400"
              >ID: 0x92_Marti</span
            >
          </div>

          <!-- Stack Modules -->
          <div class="grid grid-cols-2 gap-3 sm:flex sm:flex-wrap">
            <div
              class="flex items-center gap-2 rounded-lg border border-white/5 bg-white/[0.02] px-3 py-2 transition-all hover:border-amber-500/20"
            >
              <Icon
                name="tabler:brand-nextjs"
                class="text-amber-500/60"
                size={14}
              />
              <span
                class="font-mono text-[10px] font-bold text-slate-300 uppercase transition-colors group-hover:text-white"
                >MOD: NEXT_CORE</span
              >
            </div>
            <div
              class="flex items-center gap-2 rounded-lg border border-white/5 bg-white/[0.02] px-3 py-2 transition-all hover:border-amber-500/20"
            >
              <Icon
                name="tabler:database"
                class="text-amber-500/60"
                size={14}
              />
              <span
                class="font-mono text-[10px] font-bold text-slate-300 uppercase transition-colors group-hover:text-white"
                >MOD: SQL_ORCH</span
              >
            </div>
          </div>

          <div class="pt-4">
            <a
              href="https://github.com/GaboInsane6489/Marti-Academy-OS"
              target="_blank"
              rel="noopener noreferrer"
              class="group/link flex items-center gap-4 font-mono text-[10px] font-black tracking-[0.3em] text-amber-500 uppercase"
            >
              <span
                class="border-b border-amber-500/30 pb-1 transition-all group-hover/link:border-amber-500"
              >
                {t("projects.marti.cta")}
              </span>
              <Icon
                name="tabler:arrow-up-right"
                class="transition-transform group-hover/link:translate-x-1 group-hover/link:-translate-y-1"
              />
            </a>
          </div>
        </div>

        <!-- Project Visual Viewer -->
        <div
          class="reveal reveal-right relative order-1 lg:order-2 lg:col-span-7"
        >
          <div
            class="relative aspect-[16/10] overflow-hidden rounded-[2rem] border border-amber-500/10 bg-[#0A0908] p-1 shadow-2xl transition-all duration-700 hover:border-amber-500/30"
          >
            <div
              class="grid-bg pointer-events-none absolute inset-0 opacity-10"
            >
            </div>
            <div
              class="flex h-full w-full items-center justify-center opacity-40"
            >
              <Icon
                name="tabler:access-point"
                class="animate-pulse text-amber-500/20"
                size={120}
              />
              <div class="absolute inset-0 flex items-center justify-center">
                <div
                  class="rounded-lg border border-amber-500/20 bg-black/80 px-4 py-2 font-mono text-[8px] tracking-[0.5em] text-amber-400 uppercase backdrop-blur-sm"
                >
                  [LOADING_SYSTEM_INTEL...]
                </div>
              </div>
            </div>
          </div>
          <div
            class="absolute -inset-10 -z-10 bg-amber-500/5 opacity-0 blur-[100px] transition-opacity duration-1000 group-hover:opacity-100"
          >
          </div>
        </div>
      </article>

      <article
        class="group relative grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center"
      >
        <!-- Visual Component (Luz Interior) -->
        <div class="reveal reveal-left order-1 lg:col-span-7">
          <div
            class="relative overflow-hidden rounded-[2rem] border border-amber-500/10 bg-[#0A0908] p-1 shadow-2xl transition-all duration-700 hover:border-amber-500/30"
          >
            <EmblaCarousel images={luzInteriorImages} />
          </div>
        </div>

        <!-- Meta Content (Luz Interior) -->
        <div
          class="reveal reveal-right order-2 flex flex-col justify-center space-y-6 lg:col-span-5 lg:space-y-8 lg:pl-8"
        >
          <div class="space-y-4 text-center lg:text-left">
            <div
              class="flex items-center justify-center gap-3 text-amber-500/80 lg:justify-start"
            >
              <Icon name="tabler:crystal-ball" class="text-xl" />
              <span
                class="font-mono text-[10px] font-black tracking-widest text-amber-500 uppercase drop-shadow-[0_0_8px_rgba(245,158,11,0.3)]"
                >{t("projects.luz.badge")}</span
              >
            </div>
            <h3
              class="font-serif text-[clamp(1.75rem,5vw,2.5rem)] text-white md:text-6xl"
            >
              Mi Luz Interior
            </h3>
            <p
              class="text-lg leading-relaxed text-slate-300"
              set:html={t("projects.luz.description")}
            />
          </div>

          <div class="flex items-center justify-center gap-4 lg:justify-start">
            <div
              class="flex items-center gap-2 rounded border border-amber-500/20 bg-amber-500/5 px-2 py-0.5 font-mono text-[9px] text-amber-500 uppercase"
            >
              <span class="relative flex h-1.5 w-1.5">
                <span
                  class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-500 opacity-75"
                ></span>
                <span
                  class="relative inline-flex h-1.5 w-1.5 rounded-full bg-amber-500"
                ></span>
              </span>
              LIVE_ACCESS
            </div>
            <span
              class="font-mono text-[9px] font-bold tracking-tighter text-slate-400"
              >NODE_ID: 0xLuz_PRD</span
            >
          </div>

          <!-- Stack Modules -->
          <div class="flex flex-wrap justify-center gap-3 lg:justify-start">
            <div
              class="flex items-center gap-2 rounded-lg border border-white/5 bg-white/[0.02] px-3 py-2 transition-all hover:border-amber-500/20"
            >
              <Icon
                name="tabler:brand-react"
                class="text-amber-500/60"
                size={14}
              />
              <span
                class="font-mono text-[10px] font-bold text-slate-300 uppercase transition-colors group-hover:text-white"
                >MOD: UI_SYSTEM</span
              >
            </div>
            <div
              class="flex items-center gap-2 rounded-lg border border-white/5 bg-white/[0.02] px-3 py-2 transition-all hover:border-amber-500/20"
            >
              <Icon
                name="tabler:circles-relation"
                class="text-amber-500/60"
                size={14}
              />
              <span
                class="font-mono text-[10px] font-bold text-slate-300 uppercase transition-colors group-hover:text-white"
                >MOD: CORE_LOGIC</span
              >
            </div>
          </div>

          <div class="flex justify-center lg:justify-start">
            <a
              href="https://github.com/GaboInsane6489/LuzInterior"
              target="_blank"
              rel="noopener noreferrer"
              class="group/link flex items-center gap-4 border border-amber-500/20 bg-amber-500/5 px-6 py-3 font-mono text-[10px] font-black tracking-[0.3em] text-amber-400 uppercase transition-all hover:bg-amber-500/10"
            >
              {t("projects.luz.cta")}
              <Icon
                name="tabler:brand-github"
                class="transition-transform group-hover/link:rotate-12"
              />
            </a>
          </div>
        </div>
      </article>

      <article
        class="group relative grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center"
      >
        <!-- Content Installaciones Garcia -->
        <div
          class="reveal reveal-left order-2 flex flex-col justify-center space-y-6 lg:order-1 lg:col-span-5 lg:space-y-8"
        >
          <div class="space-y-4">
            <div class="flex items-center gap-3 text-amber-500/80">
              <Icon name="tabler:manual-gearbox" class="text-xl" />
              <span
                class="font-mono text-[10px] font-black tracking-widest text-amber-500 uppercase drop-shadow-[0_0_8px_rgba(245,158,11,0.3)]"
                >{t("projects.garcia.badge")}</span
              >
            </div>
            <h3
              class="font-serif text-[clamp(1.75rem,5vw,2.5rem)] text-white md:text-6xl"
            >
              Instalaciones García
            </h3>
            <p
              class="text-lg leading-relaxed text-slate-300"
              set:html={t("projects.garcia.description")}
            />
          </div>

          <div class="flex items-center gap-4">
            <div
              class="flex items-center gap-2 rounded border border-amber-500/20 bg-amber-500/5 px-2 py-0.5 font-mono text-[9px] text-amber-500 uppercase"
            >
              <span class="relative flex h-1.5 w-1.5">
                <span
                  class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-500 opacity-75"
                ></span>
                <span
                  class="relative inline-flex h-1.5 w-1.5 rounded-full bg-amber-500"
                ></span>
              </span>
              STABLE_PRD
            </div>
            <span
              class="font-mono text-[9px] font-bold tracking-tighter text-slate-400"
              >ENV: PRODUCTION</span
            >
          </div>

          <!-- Stack Modules -->
          <div class="grid grid-cols-2 gap-3 sm:flex sm:flex-wrap">
            <div
              class="flex items-center gap-2 rounded-lg border border-white/5 bg-white/[0.02] px-3 py-2 transition-all hover:border-amber-500/20"
            >
              <Icon
                name="tabler:layout-dashboard"
                class="text-amber-500/60"
                size={14}
              />
              <span
                class="font-mono text-[10px] font-bold text-slate-300 uppercase transition-colors group-hover:text-white"
                >MOD: ADMIN_HUD</span
              >
            </div>
            <div
              class="flex items-center gap-2 rounded-lg border border-white/5 bg-white/[0.02] px-3 py-2 transition-all hover:border-amber-500/20"
            >
              <Icon
                name="tabler:brand-typescript"
                class="text-amber-500/60"
                size={14}
              />
              <span
                class="font-mono text-[10px] font-bold text-slate-300 uppercase transition-colors group-hover:text-white"
                >MOD: TYPE_STABILITY</span
              >
            </div>
          </div>

          <div class="pt-4">
            <a
              href="https://github.com/GaboInsane6489/instalacionesgarciasfronted"
              target="_blank"
              rel="noopener noreferrer"
              class="group/link flex items-center gap-4 font-mono text-[10px] font-black tracking-[0.3em] text-amber-500 uppercase"
            >
              <span
                class="border-b border-amber-500/30 pb-1 transition-all group-hover/link:border-amber-500"
              >
                {t("projects.garcia.cta")}
              </span>
              <Icon
                name="tabler:device-laptop"
                class="transition-transform group-hover/link:translate-x-1"
              />
            </a>
          </div>
        </div>

        <!-- Viewer Installaciones Garcia -->
        <div class="reveal reveal-right order-1 lg:order-2 lg:col-span-7">
          <div
            class="relative overflow-hidden rounded-[2rem] border border-amber-500/10 bg-[#0A0908] p-1 shadow-2xl transition-all duration-700 hover:border-amber-500/30"
          >
            <EmblaCarousel images={InstalacionesGarciasImages} />
          </div>
        </div>
      </article>
    </div>
  </div>
</section>
