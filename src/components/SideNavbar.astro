---
import { Icon } from "astro-icon/components";

const sections = [
  { label: "Beginning", href: "#hero", icon: "tabler:point-filled" },
  { label: "About Me", href: "#about-me", icon: "tabler:user-code" },
  { label: "Projects", href: "#projects", icon: "tabler:folder" },
  { label: "Experience", href: "#experience", icon: "tabler:briefcase" },
  { label: "Tech Stack", href: "#tech-stack", icon: "tabler:stack-2" },
  { label: "Education", href: "#education", icon: "tabler:school" },
];
---

<aside
  class="fixed top-0 left-0 z-[100] flex h-screen w-20 flex-col items-center border-r border-white/5 bg-[#0A0A0A]/90 backdrop-blur-xl"
>
  <div
    class="group relative flex h-24 w-full flex-none items-center justify-center"
  >
    <div
      class="absolute inset-0 flex items-center justify-center opacity-0 blur transition duration-500 group-hover:opacity-100"
    >
      <div class="h-8 w-8 rounded-full bg-amber-500/20"></div>
    </div>
    <a
      href="#hero"
      class="relative flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5 transition-all group-hover:border-amber-500/50"
    >
      <Icon name="tabler:bolt" class="text-amber-400" size={20} />
    </a>
  </div>

  <nav
    class="flex min-h-0 w-full flex-1 flex-col items-center justify-center gap-y-4 lg:gap-y-6"
  >
    {
      sections.map((section) => (
        <a
          href={section.href}
          class="nav-link group relative flex w-full items-center justify-center py-2 text-gray-600 transition-all duration-300 hover:text-amber-200"
          data-section={section.href.replace("#", "")}
        >
          <span class="pointer-events-none absolute left-14 z-[110] scale-75 rounded-md border border-[#4D4543] bg-[#2C2421] px-3 py-1.5 text-[9px] font-bold tracking-widest text-amber-200 uppercase opacity-0 shadow-2xl transition-all group-hover:left-16 group-hover:scale-100 group-hover:opacity-100">
            {section.label}
          </span>

          <Icon
            name={section.icon}
            size={22}
            class="relative z-10 transition-transform group-hover:scale-110"
          />

          <div class="active-indicator absolute right-0 h-6 w-[2px] rounded-l-full bg-amber-400 opacity-0 transition-all duration-500" />
        </a>
      ))
    }
  </nav>

  <div
    class="flex h-24 w-full flex-none items-center justify-center border-t border-white/5"
  >
    <div
      class="cursor-pointer text-gray-800 transition-colors hover:text-amber-500"
    >
      <Icon name="tabler:settings" size={20} />
    </div>
  </div>
</aside>

<style is:global>
  body {
    padding-left: 0;
  }

  /* En móviles podrías quitar el padding si el navbar cambia de posición */
  @media (max-width: 768px) {
    body {
      padding-left: 0;
    }
  }

  html {
    scroll-behavior: smooth;
  }
</style>

<script>
  function initScrollSpy() {
    const observerOptions = {
      root: null,
      rootMargin: "-25% 0px -65% 0px",
      threshold: 0,
    };

    const updateActiveState = (id: string | null) => {
      if (!id) return;

      document.querySelectorAll(".nav-link").forEach((link) => {
        const isCurrent = link.getAttribute("data-section") === id;
        link.classList.toggle("text-amber-400", isCurrent);
        link.classList.toggle("text-gray-600", !isCurrent);

        const indicator = link.querySelector(
          ".active-indicator",
        ) as HTMLElement | null;
        if (indicator) {
          indicator.style.opacity = isCurrent ? "1" : "0";
        }
      });
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          updateActiveState(entry.target.id);
        }
      });
    }, observerOptions);

    document.querySelectorAll("section[id]").forEach((section) => {
      observer.observe(section);
    });
  }

  initScrollSpy();
  document.addEventListener("astro:after-swap", initScrollSpy);
</script>
