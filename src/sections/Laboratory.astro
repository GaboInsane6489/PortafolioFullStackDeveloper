---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="laboratory"
  class="flex justify-center px-4 py-24 sm:px-8 lg:py-32"
>
  <div
    class="reveal reveal-scale relative mx-auto w-full max-w-[1400px] overflow-hidden rounded-[2.5rem] border border-emerald-500/20 bg-[#0A0908] shadow-[0_0_50px_rgba(16,185,129,0.1)]"
  >
    <video
      class="absolute inset-0 h-full w-full object-cover opacity-60 transition-transform duration-[20s] hover:scale-105"
      src="/videos/Hacker-Room-Rainy-Night.mp4"
      autoplay
      muted
      loop
      playsinline></video>

    <div
      class="absolute inset-0 bg-gradient-to-r from-[#0A0908] via-[#0A0908]/40 to-transparent"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-[#0A0908] via-transparent to-transparent"
    >
    </div>

    <div class="relative z-10 px-8 py-16 sm:px-12 lg:px-20 lg:py-24">
      <div class="mb-16">
        <div class="reveal flex items-center gap-4">
          <span class="flex h-px w-12 bg-emerald-500/50"></span>
          <span
            class="font-mono text-[10px] font-black tracking-[0.4em] text-emerald-500 uppercase"
            >{t("lab.badge")}</span
          >
        </div>
        <h2
          class="reveal mt-6 font-serif text-5xl leading-tight text-white md:text-7xl"
        >
          {t("lab.title1")}
          <span
            class="bg-gradient-to-r from-emerald-400 to-emerald-600 bg-clip-text text-transparent italic"
            >{t("lab.title2")}</span
          >
        </h2>
        <p
          class="reveal mt-6 max-w-xl text-lg leading-relaxed font-light text-gray-400"
        >
          {t("lab.description")}
        </p>
      </div>

      <div
        class="grid grid-cols-1 items-stretch gap-12 lg:grid-cols-2 lg:gap-16"
      >
        <div
          class="reveal reveal-right group relative overflow-hidden rounded-2xl border border-emerald-500/20 bg-black/70 backdrop-blur-md transition-all duration-500 hover:border-emerald-500/40"
        >
          <div
            class="flex items-center justify-between border-b border-emerald-500/20 bg-emerald-500/5 px-6 py-3"
          >
            <div class="flex gap-2">
              <div class="h-2.5 w-2.5 rounded-full bg-red-500/40"></div>
              <div class="h-2.5 w-2.5 rounded-full bg-yellow-500/40"></div>
              <div class="h-2.5 w-2.5 rounded-full bg-emerald-500/40"></div>
            </div>
            <span
              class="font-mono text-[9px] font-bold tracking-[0.2em] text-emerald-500/40 uppercase"
              >session@power_user — bash</span
            >
          </div>

          <div class="p-8">
            <div class="absolute top-10 right-10 opacity-10">
              <Icon name="tabler:cpu" class="h-24 w-24 text-emerald-500" />
            </div>

            <h3
              class="mb-10 flex items-center gap-3 font-mono text-xs font-black tracking-[0.2em] text-emerald-400 uppercase"
            >
              <Icon name="tabler:terminal-2" size={18} class="animate-pulse" />
              <span>{t("lab.specs.title")}</span>
            </h3>

            <div
              class="relative z-10 space-y-5 font-mono text-[11px] md:text-sm"
            >
              {
                [
                  {
                    label: t("lab.specs.cpu"),
                    val: "AMD Ryzen 9 7950X",
                    icon: "tabler:cpu",
                  },
                  {
                    label: t("lab.specs.ram"),
                    val: "32GB DDR5 6000MHz",
                    icon: "tabler:database-export",
                  },
                  {
                    label: t("lab.specs.gpu"),
                    val: "NVIDIA RTX 4090 24GB",
                    icon: "tabler:device-desktop",
                  },
                  {
                    label: t("lab.specs.os"),
                    val: "Arch Linux (Hyprland)",
                    icon: "tabler:prompt",
                  },
                ].map((spec) => (
                  <div class="group/row flex items-center justify-between border-b border-white/[0.03] pb-3 transition-colors hover:border-emerald-500/30">
                    <div class="flex items-center gap-3">
                      <Icon
                        name={spec.icon}
                        class="text-gray-500 group-hover/row:text-emerald-500/50"
                        size={14}
                      />
                      <span class="text-gray-500 group-hover/row:text-gray-300">
                        {spec.label}
                      </span>
                    </div>
                    <span class="text-emerald-100/70 group-hover/row:text-emerald-300">
                      {spec.val}
                    </span>
                  </div>
                ))
              }
            </div>

            <div
              class="mt-10 flex items-center gap-3 font-mono text-emerald-500/60"
            >
              <span class="font-bold text-emerald-500">root@lab:~#</span>
              <span class="text-white/80">neofetch</span>
              <span class="h-4 w-2 animate-pulse bg-emerald-500"></span>
            </div>
          </div>
        </div>

        <div
          class="reveal reveal-left flex flex-col justify-between space-y-10 lg:pl-4"
        >
          <div
            class="flex items-end justify-between border-b border-white/10 pb-6"
          >
            <div class="space-y-1">
              <h3 class="font-serif text-4xl text-white">
                {t("lab.active.title")}
              </h3>
              <p
                class="flex items-center gap-2 font-mono text-[10px] tracking-widest text-gray-400"
              >
                <Icon
                  name="tabler:loader"
                  class="animate-spin text-emerald-500"
                  size={14}
                />
                {t("lab.active.monitor")}
              </p>
            </div>
            <div class="text-right">
              <span
                class="block font-mono text-5xl font-black tracking-tighter text-emerald-500"
                >84%</span
              >
            </div>
          </div>

          <div class="space-y-8">
            {
              [
                {
                  name: "AI Agents & LLM Orchestration",
                  status: "Running",
                  color: "bg-emerald-500",
                  text: "text-emerald-400",
                  w: "w-[75%]",
                },
                {
                  name: "Rust / Systems Programming",
                  status: "Compiling",
                  color: "bg-amber-500",
                  text: "text-amber-400",
                  w: "w-[45%]",
                },
                {
                  name: "WebGL / Three.js Shaders",
                  status: "Rendering",
                  color: "bg-blue-500",
                  text: "text-blue-400",
                  w: "w-[30%]",
                },
              ].map((skill) => (
                <div class="group">
                  <div class="mb-3 flex justify-between font-mono text-[11px] tracking-widest uppercase">
                    <span class="text-gray-400 transition-colors group-hover:text-white">
                      {skill.name}
                    </span>
                    <span class={`${skill.text} animate-pulse`}>
                      {skill.status}
                    </span>
                  </div>
                  <div class="h-1.5 w-full overflow-hidden rounded-full bg-white/10">
                    <div
                      class={`relative h-full ${skill.w} ${skill.color} rounded-full`}
                    >
                      <div class="absolute inset-0 w-full animate-[shimmer_2s_infinite] bg-gradient-to-r from-transparent via-white/30 to-transparent" />
                    </div>
                  </div>
                </div>
              ))
            }
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div
              class="group rounded-2xl border border-white/10 bg-black/40 p-5 transition-all hover:border-emerald-500/30 hover:bg-black/60"
            >
              <div
                class="mb-3 font-mono text-[9px] font-black tracking-[0.3em] text-gray-500 uppercase"
              >
                Primary_Editor
              </div>
              <div class="flex items-center gap-3 font-mono text-sm text-white">
                <Icon name="tabler:code" class="text-blue-400" size={20} />
                <span>VS Code</span>
              </div>
            </div>
            <div
              class="group rounded-2xl border border-white/10 bg-black/40 p-5 transition-all hover:border-emerald-500/30 hover:bg-black/60"
            >
              <div
                class="mb-3 font-mono text-[9px] font-black tracking-[0.3em] text-gray-500 uppercase"
              >
                Theme
              </div>
              <div class="flex items-center gap-3 font-mono text-sm text-white">
                <Icon
                  name="tabler:color-swatch"
                  class="text-purple-400"
                  size={20}
                />
                <span>Tokyo Night</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes shimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }
</style>
