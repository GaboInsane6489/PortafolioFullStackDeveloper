---
import { Icon } from "astro-icon/components";

const links = [
  { label: "// home", href: "#hero" },
  { label: "// projects", href: "#projects" },
  { label: "// experience", href: "#experience" },
  { label: "// contact", href: "#contact" },
];
---

<div
  id="mobileMenu"
  class="pointer-events-none fixed inset-0 z-[150] flex flex-col items-center justify-center gap-8 bg-[#0A0908]/98 opacity-0 backdrop-blur-xl transition-all duration-500 ease-in-out lg:hidden"
>
  {
    links.map((link, index) => (
      <a
        href={link.href}
        style={`transition-delay: ${index * 100}ms`}
        class="mobile-link translate-y-4 font-mono text-3xl tracking-[0.2em] text-white uppercase opacity-0 transition-all duration-500 active:scale-95 active:text-amber-500"
      >
        {link.label}
      </a>
    ))
  }

  <div
    class="mt-8 flex translate-y-4 gap-8 opacity-0 transition-all delay-500 duration-700"
    id="mobileSocials"
  >
    <a
      href="https://github.com/GaboInsane6489"
      target="_blank"
      class="text-gray-500 transition-colors active:text-white"
    >
      <Icon name="tabler:brand-github" size={28} />
    </a>
    <a href="#" class="text-gray-500 transition-colors active:text-white">
      <Icon name="tabler:brand-linkedin" size={28} />
    </a>
  </div>
</div>

<nav
  id="topNav"
  class="fixed top-0 left-0 z-[200] w-full border-b border-white/5 bg-transparent transition-all duration-500 ease-in-out"
>
  <div
    class="mx-auto flex max-w-[1600px] items-center justify-between px-6 py-5 transition-all duration-500 lg:px-12"
    id="navContainer"
  >
    <a
      href="/"
      class="group relative z-[210] flex items-center gap-4 transition-transform active:scale-95"
    >
      <div
        class="h-10 w-10 overflow-hidden rounded-xl border border-white/10 bg-white/5 transition-colors group-hover:border-amber-500/50"
      >
        <img
          src="/images/LogoPortafolio.webp"
          alt="Logo"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="hidden flex-col md:flex">
        <span
          class="text-[10px] font-bold tracking-[0.3em] text-white transition-colors group-hover:text-amber-400"
          >GABRIEL GONZÁLEZ</span
        >
        <span
          class="font-mono text-[8px] tracking-widest text-gray-500 uppercase"
          >System Architect</span
        >
      </div>
    </a>

    <div class="hidden items-center gap-10 lg:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="group relative font-mono text-[11px] tracking-[0.15em] text-gray-400 transition-colors hover:text-white"
          >
            <span class="relative z-10">{link.label}</span>
            <span class="absolute -bottom-1 left-0 h-[1px] w-0 bg-amber-500 transition-all duration-300 group-hover:w-full" />
          </a>
        ))
      }
    </div>

    <button
      id="menuBtn"
      class="group relative z-[210] flex h-11 w-11 items-center justify-center rounded-xl border border-white/10 bg-white/5 transition-all active:scale-90 active:bg-amber-500/10 lg:hidden"
      aria-label="Menu"
    >
      <div
        class="relative flex h-5 w-6 flex-col items-end justify-between overflow-hidden"
      >
        <span
          id="line1"
          class="h-[2px] w-6 rounded-full bg-gray-200 transition-all duration-300 ease-out"
        ></span>
        <span
          id="line2"
          class="h-[2px] w-4 rounded-full bg-gray-200 transition-all duration-300 ease-out group-hover:w-6"
        ></span>
        <span
          id="line3"
          class="h-[2px] w-6 rounded-full bg-gray-200 transition-all duration-300 ease-out"
        ></span>
      </div>
    </button>
  </div>
</nav>

<style>
  .nav-scrolled {
    background-color: rgba(10, 9, 8, 0.8) !important;
    backdrop-filter: blur(16px) !important;
    -webkit-backdrop-filter: blur(16px) !important;
    padding-top: 0.6rem !important;
    padding-bottom: 0.6rem !important;
  }

  /* --- ANIMACIÓN DEL ICONO --- */

  /* Línea Superior: Baja y rota */
  .menu-active #line1 {
    transform: translateY(9px) rotate(45deg);
    background-color: #f59e0b;
  }

  /* Línea Media: Se desliza hacia afuera y desaparece */
  .menu-active #line2 {
    transform: translateX(100%);
    opacity: 0;
  }

  /* Línea Inferior: Sube y rota invertido */
  .menu-active #line3 {
    transform: translateY(-9px) rotate(-45deg);
    background-color: #f59e0b;
  }

  /* --- Otros Estilos --- */
  #mobileMenu.is-visible {
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  #mobileMenu.is-visible .mobile-link,
  #mobileMenu.is-visible #mobileSocials {
    transform: translateY(0);
    opacity: 1;
  }
</style>

<script>
  // El script se mantiene igual
  const setupNav = () => {
    const nav = document.getElementById("topNav");
    const btn = document.getElementById("menuBtn");
    const menu = document.getElementById("mobileMenu");
    const mobileLinks = document.querySelectorAll(".mobile-link");

    const handleScroll = () => {
      window.scrollY > 20
        ? nav?.classList.add("nav-scrolled")
        : nav?.classList.remove("nav-scrolled");
    };

    const toggleMenu = () => {
      const isOpen = menu?.classList.contains("is-visible");
      menu?.classList.toggle("is-visible");
      btn?.classList.toggle("menu-active");
      document.body.style.overflow = isOpen ? "" : "hidden";
    };

    window.addEventListener("scroll", handleScroll);
    btn?.addEventListener("click", toggleMenu);

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        menu?.classList.remove("is-visible");
        btn?.classList.remove("menu-active");
        document.body.style.overflow = "";
      });
    });

    handleScroll();
  };

  setupNav();
  document.addEventListener("astro:after-swap", setupNav);
</script>
