---
import { Icon } from "astro-icon/components";

interface Props {
  images: string[];
  autoplay?: boolean;
  interval?: number;
}

const { images, autoplay = true, interval = 4000 } = Astro.props as Props;
---

<div
  class="embla-wrapper group relative"
  data-autoplay={String(autoplay)}
  data-interval={interval}
>
  <!-- Progress bar -->
  <div class="mb-2 h-[3px] w-full overflow-hidden bg-white/10">
    <div
      class="embla-progress h-full w-0 bg-white transition-[width] duration-100 ease-linear"
    >
    </div>
  </div>

  <!-- Viewport -->
  <div class="embla overflow-hidden">
    <div class="embla__container flex">
      {
        images.map((src, index) => (
          <div class="embla__slide flex-[0_0_100%] px-2">
            <img
              src={src}
              alt={`Slide ${index + 1}`}
              class="h-120 w-full rounded-lg object-cover md:h-96"
              loading="lazy"
            />
          </div>
        ))
      }
    </div>
  </div>

  <!-- Prev -->
  <button
    type="button"
    aria-label="Previous slide"
    class="embla-prev absolute top-1/2 left-3 -translate-y-1/2 cursor-pointer rounded-full bg-black/60 px-4 py-2 text-white transition hover:bg-black/80"
  >
    <Icon name="tabler:chevron-left" size="24" />
  </button>

  <!-- Next -->
  <button
    type="button"
    aria-label="Next slide"
    class="embla-next absolute top-1/2 right-3 -translate-y-1/2 cursor-pointer rounded-full bg-black/60 px-4 py-2 text-white transition hover:bg-black/80"
  >
    <Icon name="tabler:chevron-right" size="24" />
  </button>
</div>

<!-- IMPORTANTE: Solo se importa una vez por página -->
<script>
  // 1. Usamos una ruta RELATIVA (sin el / inicial)
  // Ajusta la cantidad de ../ según donde esté tu archivo .astro
  import { initEmbla } from "../scripts/embla-init.ts";

  // 2. Ejecutamos la lógica de inicialización
  const setup = () => {
    if (!(window as any).__EMBLA_INITIALIZED__) {
      (window as any).__EMBLA_INITIALIZED__ = true;
      initEmbla();
    }
  };

  // 3. Lo ejecutamos al cargar y si usas View Transitions
  setup();
  document.addEventListener("astro:page-load", setup);
</script>
