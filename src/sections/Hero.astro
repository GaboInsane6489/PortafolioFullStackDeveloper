---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  class="relative flex min-h-[100dvh] w-full flex-col justify-start overflow-hidden border-b border-white/5 pt-24 pb-10 md:justify-start md:pt-32 lg:justify-center lg:pt-20 lg:pb-10"
  id="hero"
>
  <div
    class="grid-bg pointer-events-none absolute inset-0 opacity-15 md:opacity-25"
  >
  </div>

  <div class="relative mx-auto w-full max-w-[1300px] px-6 sm:px-12 lg:px-16">
    <div
      class="grid grid-cols-1 items-center gap-4 md:grid-cols-12 md:gap-8 lg:gap-6"
    >
      <div
        class="reveal relative order-first col-span-1 flex justify-center opacity-0 transition-all delay-700 duration-1000 md:order-last md:col-span-5"
      >
        <div
          class="relative z-10 w-full max-w-[160px] cursor-pointer rounded-2xl border border-white/10 bg-[#0A0908]/50 p-1.5 backdrop-blur-md transition-all duration-300 active:scale-[0.98] active:ring-2 active:ring-amber-500/30 sm:max-w-[220px] md:max-w-[260px] md:backdrop-blur-xl lg:max-w-[300px]"
        >
          <div
            class="overflow-hidden rounded-xl border border-white/5 bg-[#050505] shadow-2xl"
          >
            <div
              class="flex items-center justify-between border-b border-white/5 bg-[#0F0F0F] px-4 py-2"
            >
              <div class="flex gap-1.5">
                <div class="h-1.5 w-1.5 rounded-full bg-red-500/20"></div>
                <div class="h-1.5 w-1.5 rounded-full bg-yellow-500/20"></div>
                <div class="h-1.5 w-1.5 rounded-full bg-green-500/20"></div>
              </div>
              <div
                class="font-mono text-[clamp(9px,1.2vw,11px)] tracking-[0.2em] text-gray-600 uppercase"
              >
                env:production
              </div>
            </div>

            <div class="group relative aspect-[4/5] overflow-hidden">
              <img
                src="/images/FotoPerfil.webp"
                alt="Gabriel Gonzalez Profile"
                class="h-full w-full object-cover opacity-80 grayscale transition-all duration-700 group-hover:opacity-100 group-hover:grayscale-0"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-[#050505] via-transparent to-transparent"
              >
              </div>
              <div
                class="absolute bottom-3 left-3 rounded-lg border border-white/5 bg-black/60 px-2.5 py-1.5 font-mono text-[clamp(10px,1.5vw,12px)] text-amber-500 backdrop-blur-md"
              >
                <span class="animate-pulse">></span> online_active
              </div>
            </div>
          </div>
        </div>
        <div
          class="absolute -inset-10 -z-10 rounded-full bg-amber-500/10 opacity-20 blur-[60px]"
        >
        </div>
      </div>

      <div
        class="flex flex-col items-center justify-center space-y-4 text-center md:col-span-7 md:items-start md:space-y-4 md:text-left lg:space-y-4"
      >
        <div class="space-y-4 lg:space-y-3">
          <div
            class="reveal translate-y-4 opacity-0 transition-all duration-700 ease-out"
          >
            <div
              class="inline-flex items-center gap-2 rounded-full border border-amber-500/20 bg-amber-500/5 px-3 py-1.5 backdrop-blur-md"
            >
              <span class="relative flex h-2 w-2">
                <span
                  class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-75"
                ></span>
                <span
                  class="relative inline-flex h-2 w-2 rounded-full bg-amber-500"
                ></span>
              </span>
              <span
                class="font-mono text-[clamp(10px,1.5vw,12px)] font-bold tracking-[0.2em] text-amber-500 uppercase"
                >{t("nav.status")}</span
              >
            </div>
          </div>

          <h1
            class="reveal translate-y-4 font-sans text-[clamp(1.5rem,6vw,2.2rem)] leading-[1.1] font-bold tracking-tighter text-white opacity-0 transition-all delay-150 duration-700 md:text-[clamp(2.5rem,5vw,3rem)] lg:text-5xl"
          >
            {t("hero.description1")}
            <br />
            <span
              class="bg-gradient-to-r from-white via-white/80 to-white/40 bg-clip-text text-transparent"
              >{t("hero.description2")}</span
            >
          </h1>

          <p
            class="reveal mx-auto max-w-lg translate-y-4 font-mono text-xs font-medium tracking-[0.1em] text-amber-500/80 uppercase opacity-0 transition-all delay-300 duration-700 md:text-sm lg:mx-0"
          >
            {t("hero.tagline")}
          </p>
        </div>

        <div
          class="reveal flex w-full translate-y-4 flex-col gap-4 opacity-0 transition-all delay-[450ms] duration-700 sm:flex-row sm:justify-center md:justify-start lg:justify-start"
        >
          <a
            href="#projects"
            class="group relative flex items-center justify-center gap-3 overflow-hidden rounded-xl bg-white px-8 py-4 text-[10px] font-black tracking-widest text-black transition-all hover:bg-amber-400 active:scale-95 sm:w-auto sm:py-3.5"
          >
            <span>EXPLORE WORK</span>
            <Icon
              name="tabler:arrow-right"
              size={18}
              class="transition-transform group-hover:translate-x-1"
            />
          </a>
          <a
            href="#contact"
            class="group flex items-center justify-center gap-3 rounded-xl border border-white/10 bg-white/5 px-8 py-4 text-[10px] font-black tracking-widest text-white transition-all hover:bg-white/10 active:scale-95 sm:w-auto sm:py-3.5"
          >
            <span class="uppercase">{t("hero.cta")}</span>
          </a>
        </div>

        <div
          class="reveal grid w-full max-w-sm grid-cols-2 gap-6 border-t border-white/5 pt-6 opacity-0 transition-opacity delay-[600ms] duration-1000 sm:max-w-md sm:grid-cols-3 md:pt-8 lg:max-w-none lg:pt-5"
        >
          <div class="flex flex-col items-center space-y-1.5 lg:items-start">
            <span
              class="font-mono text-[clamp(10px,1.5vw,12px)] tracking-[0.2em] text-gray-600 uppercase"
              >Education</span
            >
            <span
              class="block text-[clamp(12px,1.8vw,14px)] font-medium text-gray-300"
              >UCAB Engineering</span
            >
          </div>
          <div class="flex flex-col items-center space-y-1.5 lg:items-start">
            <span
              class="font-mono text-[clamp(10px,1.5vw,12px)] tracking-[0.2em] text-gray-600 uppercase"
              >Mindset</span
            >
            <span
              class="block text-[clamp(12px,1.8vw,14px)] font-medium text-amber-500"
              >Scalable Logic</span
            >
          </div>
          <div
            class="col-span-2 flex flex-col items-center space-y-1.5 sm:col-span-1 lg:items-start"
          >
            <span
              class="font-mono text-[clamp(10px,1.5vw,12px)] tracking-[0.2em] text-gray-600 uppercase"
              >Tools</span
            >
            <span
              class="block text-[clamp(12px,1.8vw,14px)] font-medium text-gray-300"
              >Next.js · Supabase · Git</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
