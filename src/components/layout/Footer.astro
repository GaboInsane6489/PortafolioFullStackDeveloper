---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  { label: t("nav.startup"), href: "#hero" },
  { label: t("nav.projects"), href: "#projects" },
  { label: t("nav.exp"), href: "#experience" },
  { label: t("nav.lab"), href: "#laboratory" },
];

const socials = [
  {
    label: "GitHub",
    href: "https://github.com/GaboInsane6489",
    icon: "tabler:brand-github",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/gabriel-gonzalez-fullstack/",
    icon: "tabler:brand-linkedin",
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/dreamsfallen6488/",
    icon: "tabler:brand-instagram",
  },
  {
    label: "YouTube",
    href: "https://www.youtube.com/@Gabo6489Gaming-pe2tg",
    icon: "tabler:brand-youtube",
  },
];
---

<footer
  class="relative w-full overflow-hidden border-t border-lofi-accent/30 bg-[#0A0908] pt-16 pb-12 text-white md:pt-24 md:pb-16"
>
  <!-- --- HACKER-LEVEL BACKGROUND: Vibrant Schematic + Digital Stream --- -->
  <div class="pointer-events-none absolute inset-0 z-0 select-none">
    <!-- Schematic Mesh Pattern (More Vibrant) -->
    <svg width="100%" height="100%" class="absolute inset-0 opacity-[0.08]">
      <pattern id="footer-schematic-v2" width="120" height="120" patternUnits="userSpaceOnUse">
        <path d="M 120 0 L 0 0 0 120" fill="none" stroke="currentColor" stroke-width="1"/>
        <circle cx="0" cy="0" r="2" fill="currentColor" />
        <path d="M 30 30 L 60 30 L 60 60" fill="none" stroke="currentColor" stroke-width="0.5"/>
        <path d="M 90 90 L 110 90" fill="none" stroke="currentColor" stroke-width="0.5"/>
      </pattern>
      <rect width="100%" height="100%" fill="url(#footer-schematic-v2)" class="text-lofi-accent" />
    </svg>

    <!-- Digital Binary Flow (Static but high-end) -->
    <div class="absolute inset-0 flex flex-wrap gap-4 px-10 py-10 opacity-[0.02] font-mono text-[10px] text-lofi-accent whitespace-nowrap overflow-hidden">
       {Array.from({ length: 12 }).map(() => (
         <div class="flex flex-col gap-2">
            <span>01010101_SYS_ROOT</span>
            <span>ERROR_NOT_FOUND_RETRYING</span>
            <span>PACKET_SENT_0x1A2B3C</span>
            <span>PING_PONG_VENEZUELA_NODE</span>
         </div>
       ))}
    </div>

    <!-- Original Grid (Intensified) -->
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] [background-size:40px_40px]"
    >
    </div>
    
    <!-- Scanline Overlay (Prominent) -->
    <div
      class="absolute inset-0 bg-[linear-gradient(transparent_50%,rgba(165,166,246,0.05)_50%),linear-gradient(90deg,rgba(165,166,246,0.03),transparent,rgba(165,166,246,0.03))] [background-size:100%_4px,2px_100%]"
    >
    </div>

    <!-- Vibrant Purple Glows -->
    <div
      class="absolute -top-40 -left-40 h-[600px] w-[600px] rounded-full bg-lofi-accent/10 blur-[120px]"
    >
    </div>
    <div
      class="absolute -bottom-40 -right-40 h-[600px] w-[600px] rounded-full bg-lofi-pop/10 blur-[120px]"
    >
    </div>

    <!-- Top Vibrant Glow Line -->
    <div
      class="absolute top-0 left-0 h-[1px] w-full bg-gradient-to-r from-transparent via-lofi-accent to-transparent"
    >
      <div class="absolute inset-0 animate-pulse bg-lofi-accent shadow-[0_0_15px_#A5A6F6] blur-[2px]"></div>
    </div>
  </div>

  <div class="relative z-10 mx-auto max-w-[1440px] px-6 lg:px-12">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- BRANDING SECTION -->
      <div
        class="reveal flex flex-col items-center space-y-12 text-center lg:col-span-5 lg:items-start lg:text-left"
      >
        <div
          class="flex flex-col items-center gap-7 sm:flex-row lg:items-start"
        >
          <div
            class="group relative h-16 w-16 transition-transform active:scale-95 md:h-14 md:w-14"
          >
            <div
              class="animate-spin-slow absolute inset-0 rounded-xl border-2 border-lofi-accent/40 bg-lofi-accent/10 [animation-duration:20s]"
            >
            </div>
            <div
              class="absolute inset-2 flex items-center justify-center overflow-hidden rounded-lg border border-white/20 bg-[#0D0C0B] shadow-[0_0_20px_rgba(165,166,246,0.2)]"
            >
              <img
                src="/images/LogoPortafolio.webp"
                alt="Logo"
                class="h-8 w-8 object-contain transition-transform group-hover:scale-110"
              />
            </div>
          </div>
          <div class="flex flex-col">
            <h2
              class="group/name relative text-3xl font-black tracking-tighter text-white uppercase italic md:text-3xl"
            >
              <span class="relative z-10">Gabriel González</span>
              <span class="absolute inset-0 -z-10 translate-x-1 translate-y-1 text-lofi-accent/30 blur-sm">Gabriel González</span>
            </h2>
            <div
              class="flex items-center justify-center gap-2 font-mono text-[10px] font-black tracking-[0.5em] text-lofi-accent lg:justify-start"
            >
              <span
                class="inline-block h-2 w-2 animate-pulse rounded-full bg-lofi-accent shadow-[0_0_8px_#A5A6F6]"
              ></span>
              SYSTEM ARCHITECT // V_1.5
            </div>
          </div>
        </div>

        <p
          class="max-w-md font-sans text-base leading-relaxed font-normal text-white/80"
          set:html={t("footer.tagline")}
        />

        <a
          href="mailto:gabrielgg2005ve@gmail.com"
          class="group relative inline-flex w-full items-center justify-center gap-4 overflow-hidden rounded-xl border-2 border-lofi-accent/20 bg-lofi-accent/[0.03] px-8 py-4 transition-all hover:border-lofi-accent/60 hover:bg-lofi-accent/10 hover:shadow-[0_0_40px_rgba(165,166,246,0.2)] active:scale-[0.98] sm:w-auto md:py-4"
        >
          <Icon name="tabler:terminal-2" size={20} class="text-white drop-shadow-[0_0_8px_#A5A6F6]" />
          <span class="font-mono text-xs font-black tracking-widest text-white group-hover:drop-shadow-[0_0_8px_white]"
            >GABRIELGG2005VE@GMAIL.COM</span
          >
        </a>
      </div>

      <!-- INDEX SECTION -->
      <div
        class="reveal delay-100 grid grid-cols-2 gap-8 sm:gap-12 lg:col-span-3 lg:block lg:space-y-12"
      >
        <h4
          class="col-span-2 flex items-center gap-3 font-mono text-[11px] font-black tracking-[0.6em] text-white uppercase lg:col-auto lg:mb-12"
        >
          <span class="h-px w-8 bg-lofi-accent"></span> {t("footer.index")}
        </h4>
        <ul
          class="col-span-2 grid grid-cols-2 gap-5 lg:col-auto lg:block lg:space-y-5"
        >
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="group flex items-center py-2 text-white/60 transition-all hover:text-white lg:py-0"
                >
                  <span class="font-mono text-[11px] font-bold tracking-widest lowercase group-hover:translate-x-2 transition-transform">
                     <span class="mr-2 text-lofi-accent opacity-0 transition-opacity group-hover:opacity-100">$</span>{link.label}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- NODES SECTION -->
      <div class="reveal delay-200 lg:col-span-4">
        <h4
          class="mb-12 flex items-center gap-3 font-mono text-[11px] font-black tracking-[0.6em] text-white uppercase"
        >
          <span class="h-px w-8 bg-lofi-accent"></span> {t("footer.nodes")}
        </h4>
        <div class="grid grid-cols-2 gap-4">
          {
            socials.map((social, i) => (
              <a
                href={social.href}
                target="_blank"
                style={`transition-delay: ${i * 100}ms`}
                class="footer-node group relative flex flex-col gap-4 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04] p-5 transition-all active:scale-95 lg:hover:-translate-y-2 lg:hover:border-lofi-accent/50 lg:hover:bg-lofi-accent/[0.05] lg:hover:shadow-[0_0_30px_rgba(165,166,246,0.1)]"
              >
                <!-- Scanner Line FX (Intense) -->
                <div class="absolute inset-0 -translate-y-full bg-gradient-to-b from-transparent via-lofi-accent/20 to-transparent transition-transform duration-[1500ms] group-hover:translate-y-full"></div>
                
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-black/60 text-white group-hover:scale-110 group-hover:text-lofi-accent transition-all shadow-[inset_0_0_10px_rgba(0,0,0,0.5)]">
                  <Icon name={social.icon} size={22} />
                </div>
                <span class="font-mono text-[11px] font-black tracking-widest text-white/70 group-hover:text-white transition-colors">
                  {social.label.toUpperCase()}
                </span>
                <div class="absolute top-4 right-4 h-1.5 w-1.5 rounded-full bg-white/20 group-hover:bg-lofi-accent group-hover:shadow-[0_0_10px_#A5A6F6] transition-all" />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <!-- BOTTOM HUD BAR -->
    <div
      class="mt-20 flex flex-col items-center justify-between gap-10 border-t border-white/10 pt-12 md:mt-24 md:flex-row"
    >
      <div class="flex flex-col items-center space-y-5 md:items-start">
        <p
          class="font-mono text-[11px] font-black tracking-[0.4em] text-white uppercase"
        >
          &copy; {new Date().getFullYear()} G_GONZÁLEZ // <span
            class="text-lofi-accent shadow-[0_0_8px_#A5A6F6]">{t("footer.secured")}</span>
        </p>
        <div class="h-1 w-48 overflow-hidden rounded-full bg-white/5">
          <div class="animate-loading-bar h-full w-1/2 bg-lofi-accent shadow-[0_0_10px_#A5A6F6]"></div>
        </div>
      </div>

      <div
        class="flex w-full flex-col items-center gap-6 sm:flex-row sm:justify-center md:w-auto"
      >
        <!-- Real-time Clock HUD -->
        <div class="flex items-center gap-5 rounded-2xl border-2 border-white/5 bg-black/50 px-8 py-4 shadow-2xl backdrop-blur-xl">
          <div class="flex items-center gap-3 border-r border-white/20 pr-5">
             <div class="relative h-2.5 w-2.5">
                <div class="absolute inset-0 animate-ping rounded-full bg-green-500 opacity-40"></div>
                <div class="h-full w-full rounded-full bg-green-500 shadow-[0_0_12px_#10B981]"></div>
             </div>
             <div class="flex flex-col">
                <span class="font-mono text-[8px] font-black text-white/30 uppercase tracking-widest">Sys_Status</span>
                <span class="font-mono text-[10px] font-black text-white uppercase tracking-tighter">OPTIMAL_v1.5</span>
             </div>
          </div>

          <div class="flex flex-col">
            <span class="font-mono text-[8px] leading-none text-white/30 uppercase tracking-[0.3em] mb-1">GEO_TEMPORAL_NODE</span>
            <span id="footer-clock" class="font-mono text-xs font-black tabular-nums text-white uppercase tracking-[0.2em] group-hover:text-lofi-accent transition-colors">VENEZUELA // 00:00:00</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  @keyframes loading-bar {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(300%); }
  }
  .animate-loading-bar {
    animation: loading-bar 5s infinite ease-in-out;
  }
  .animate-spin-slow {
    animation: spin 30s linear infinite;
  }
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  
  a { -webkit-tap-highlight-color: transparent; }

  .footer-node {
    opacity: 0;
    transform: translateY(15px) scale(0.98);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal.active .footer-node {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
</style>

<script>
  function updateClock() {
    const clockElement = document.getElementById('footer-clock');
    if (!clockElement) return;

    const now = new Date();
    const options = {
      timeZone: 'America/Caracas',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    };
    
    // @ts-ignore
    const timeString = new Intl.DateTimeFormat('en-US', options).format(now);
    clockElement.textContent = `VENEZUELA // ${timeString}`;
  }

  setInterval(updateClock, 1000);
  updateClock();
  document.addEventListener('astro:page-load', updateClock);
</script>
