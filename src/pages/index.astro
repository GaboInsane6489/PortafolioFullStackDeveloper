---
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
import { Icon } from "astro-icon/components";
import EmblaCarousel from "../components/EmblaCarousel.astro";

const luzInteriorImages = Array.from(
  { length: 11 },
  (_, i) => `/images/LuzInterior${i + 1}.webp`,
);

const InstalacionesGarciasImages = Array.from(
  { length: 13 },
  (_, i) => `/images/InstalacionesGarcias${i + 1}.webp`,
);

const HarryPotterHeadForumImages = Array.from(
  { length: 15 },
  (_, i) => `/images/HarryPotterHead${i + 1}.webp`,
);
---

<PortfolioLayout>
  <!-- ===================================================== -->
  <!-- HERO / PROFILE -->
  <!-- ===================================================== -->
  <section
    class="relative w-full border-t border-white/5 py-28 lg:py-36"
    id="hero"
  >
    <div class="mx-auto w-full max-w-[1300px] px-8 sm:px-12 lg:px-16 xl:px-20">
      <div class="grid grid-cols-1 items-center gap-20 lg:grid-cols-12">
        <!-- PROFILE TEXT -->
        <div class="space-y-10 lg:col-span-7">
          <div class="flex items-center gap-4">
            <div class="h-px w-12 bg-white"></div>
            <span
              class="text-[10px] font-bold tracking-[0.6em] text-gray-400 uppercase"
            >
              Full Stack Developer
            </span>
          </div>

          <h1
            class="font-serif text-5xl leading-[0.9] tracking-tighter text-white/80 sm:text-6xl md:text-7xl xl:text-8xl"
          >
            Gabriel González
            <br />
            <span class="font-light text-white/40 italic">
              Building scalable digital systems
            </span>
          </h1>

          <p class="max-w-2xl text-lg leading-relaxed text-gray-400 md:text-xl">
            I design and develop modern, maintainable and performance-oriented
            web applications. My focus is clean architecture, scalable systems,
            and high-quality user experiences.
          </p>

          <div
            class="text-[10px] font-bold tracking-[0.4em] text-gray-500 uppercase"
          >
            Clean Architecture · Performance · Scalability · UX
          </div>
        </div>

        <!-- PROFILE IMAGE -->
        <div class="flex justify-center lg:col-span-5 lg:justify-end">
          <div class="group relative">
            <div
              class="absolute -inset-6 -z-10 translate-x-4 translate-y-4 border border-white/10 transition-all duration-700 group-hover:translate-x-0 group-hover:translate-y-0"
            >
            </div>

            <img
              src="/images/FotoPerfil.webp"
              alt="Gabriel González Profile Picture"
              class="w-[280px] border border-white/5 object-cover sm:w-[320px] md:w-[360px]"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================== -->
  <!-- ABOUT ME -->
  <!-- ===================================================== -->
  <section class="border-t border-white/5 py-32" id="about-me">
    <div
      class="mx-auto w-full max-w-[1000px] space-y-16 px-8 sm:px-12 lg:px-16"
    >
      <div class="space-y-8">
        <div class="flex items-center gap-4">
          <div class="h-px w-12 bg-white"></div>
          <span
            class="text-[10px] font-bold tracking-[0.6em] text-gray-400 uppercase"
          >
            Professional Summary
          </span>
        </div>

        <h2
          class="font-serif text-4xl leading-tight tracking-tighter text-white/80 md:text-6xl"
        >
          Engineering with structure,
          <br />
          <span class="font-light text-white/40 italic">
            not improvisation
          </span>
        </h2>
      </div>

      <div class="space-y-8 text-lg leading-loose text-gray-400">
        <p>
          I am a Full Stack Developer focused on building modern, maintainable,
          and performance-oriented web applications. I work across both frontend
          and backend, prioritizing clean architecture, best practices, and
          solutions designed to scale in an organized way.
        </p>

        <p>
          Throughout my training as a University-certified Full Stack Developer
          and my hands-on experience, I have built and maintained real-world
          projects in collaborative environments.
        </p>

        <p>
          Notable examples include <span class="font-medium text-white"
            >Instalaciones García</span
          >, a scalable service management system, and my work on
          <span class="font-medium text-white"> Harry Potter Foro</span>, where
          I implemented complex features such as achievement systems,
          notifications, database migrations, and event-driven logic directly in
          a production environment.
        </p>
        <div class="group relative">
          <div
            class="absolute -inset-6 -z-10 translate-x-4 translate-y-4 border border-white/30 transition-all duration-700 group-hover:translate-x-0 group-hover:translate-y-0"
          >
          </div>
          <div class="flex justify-center">
            <video
              src="/videos/Programando.mp4"
              class="h-auto w-full border border-white/5 shadow-2xl transition-all duration-500 hover:scale-105 hover:border-white/10 hover:shadow-2xl"
              autoplay
              loop
              muted></video>
          </div>
        </div>

        <p>
          I have real work experience collaborating in teams that follow
          professional workflows: ticket systems, branching strategies, clean
          commits, pull requests, squash merges, code reviews, and controlled
          deployments.
        </p>

        <p>
          My role has involved fixing real production bugs, improving existing
          logic, and ensuring system stability.
        </p>
      </div>

      <div
        class="space-y-2 border-t border-white/5 pt-10 text-sm text-gray-500"
      >
        <p>Location: Caracas, Venezuela</p>
        <p>High-tech workspace · Server architecture environment</p>
        <p>Open to remote opportunities</p>
      </div>
    </div>
  </section>

  <!-- ===================================================== -->
  <!-- FEATURED PROJECT -->
  <!-- ===================================================== -->
  <section id="projects" class="border-t border-white/5 py-32">
    <div class="mx-auto w-full max-w-[1200px] px-8 sm:px-12 lg:px-16">
      <div class="max-w-3xl space-y-10">
        <div class="flex items-center gap-4">
          <div class="h-px w-12 bg-white"></div>
          <span
            class="text-[10px] font-bold tracking-[0.6em] text-gray-400 uppercase"
          >
            Featured Project
          </span>
        </div>

        <h2
          class="font-serif text-4xl leading-[0.9] tracking-tighter text-white/80 md:text-6xl"
        >
          Luz Interior
          <br />
          <span class="font-light text-white/40 italic">
            Modular architecture & scalable system design
          </span>
        </h2>

        <p class="max-w-xl text-lg leading-relaxed text-gray-400">
          A structured digital platform built with reusable components, modular
          architecture, and performance-focused implementation.
        </p>
      </div>

      <div class="mt-20 grid grid-cols-1 items-start gap-20 lg:grid-cols-2">
        <div class="max-w-xl space-y-10">
          <div>
            <h3 class="mb-4 font-serif text-xl">Tech Stack</h3>
            <ul class="space-y-3 text-gray-400">
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-javascript" size="18" />
                JavaScript
              </li>
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-react" size="18" />
                React
              </li>
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-tailwind" size="18" />
                TailwindCSS
              </li>
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-supabase" size="18" />
                Supabase
              </li>
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-vercel" size="18" />
                Vercel
              </li>
            </ul>
          </div>
        </div>

        <div>
          <EmblaCarousel images={luzInteriorImages} />
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-white/5 py-32">
    <div class="mx-auto w-full max-w-[1200px] px-8 sm:px-12 lg:px-16">
      <div class="max-w-3xl space-y-10">
        <div class="flex items-center gap-4">
          <div class="h-px w-12 bg-white"></div>
          <span
            class="text-[10px] font-bold tracking-[0.6em] text-gray-400 uppercase"
          >
            Featured Project
          </span>
        </div>

        <h2
          class="font-serif text-4xl leading-[0.9] tracking-tighter text-white/80 md:text-6xl"
        >
          Instalaciones Garcia
          <br />
          <span class="font-light text-white/40 italic">
            Service management system for a real company
          </span>
        </h2>

        <p class="max-w-xl text-lg leading-relaxed text-gray-400">
          A comprehensive service management platform designed for a real
          company, featuring a modern interface, efficient service tracking, and
          streamlined client communication.
        </p>
      </div>

      <div class="mt-20 grid grid-cols-1 items-start gap-20 lg:grid-cols-2">
        <div class="max-w-xl space-y-10">
          <div>
            <h3 class="mb-4 font-serif text-xl">Tech Stack</h3>
            <ul class="space-y-3 text-gray-400">
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-astro" size="18" />
                Astro
              </li>
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-javascript" size="18" />
                JavaScript
              </li>
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-react" size="18" />
                React
              </li>
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-tailwind" size="18" />
                TailwindCSS
              </li>
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-supabase" size="18" />
                Supabase
              </li>
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-vercel" size="18" />
                Vercel
              </li>
            </ul>
          </div>
        </div>

        <div>
          <EmblaCarousel images={InstalacionesGarciasImages} />
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================== -->
  <!-- Experience -->
  <!-- ===================================================== -->
  <section id="experience" class="border-t border-white/5 py-32">
    <div class="mx-auto w-full max-w-[1200px] px-8 sm:px-12 lg:px-16">
      <div class="max-w-3xl space-y-10">
        <div class="flex items-center gap-4">
          <div class="h-px w-12 bg-white"></div>
          <span
            class="text-[10px] font-bold tracking-[0.6em] text-gray-400 uppercase"
          >
            Experience
          </span>
        </div>

        <h2
          class="font-serif text-4xl leading-[0.9] tracking-tighter text-white/80 md:text-6xl"
        >
          Harry Potter Head Forum
          <br />
          <span class="font-light text-white/40 italic">
            Real experience in a production environment with real users and real
            problems
          </span>
        </h2>

        <p class="max-w-xl text-lg leading-relaxed text-gray-400">
          I have real work experience collaborating in teams that follow
          professional workflows: ticket systems, branching strategies, clean
          commits, pull requests, squash merges, code reviews, and controlled
          deployments.
        </p>
      </div>

      <div class="mt-20 grid grid-cols-1 items-start gap-20 lg:grid-cols-2">
        <div class="max-w-xl space-y-10">
          <div>
            <h3 class="mb-4 font-serif text-xl">Tech Stack</h3>
            <ul class="space-y-3 text-gray-400">
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-php" size="18" />
                PHP
              </li>
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-laravel" size="18" />
                Laravel
              </li>
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-mysql" size="18" />
                MySQL
              </li>
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-git" size="18" />
                Git
              </li>
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-javascript" size="18" />
                JavaScript
              </li>
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-react" size="18" />
                React
              </li>
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-tailwind" size="18" />
                TailwindCSS
              </li>
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-supabase" size="18" />
                Supabase
              </li>
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-vercel" size="18" />
                Vercel
              </li>
            </ul>
          </div>
        </div>

        <div>
          <EmblaCarousel images={HarryPotterHeadForumImages} />
        </div>
      </div>
    </div>
  </section>
  <!-- ===================================================== -->
  <!-- ENGINEERING / OPEN SOURCE / STACK / FOUNDATION -->
  <!-- ===================================================== -->

  <!-- ================= ENGINEERING & OPEN SOURCE ================= -->
  <section
    id="engineering"
    class="relative overflow-hidden border-t border-white/5 py-36"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_10%,rgba(255,255,255,0.04),transparent_60%)]"
    >
    </div>

    <div class="relative mx-auto w-full max-w-[1300px] px-6 sm:px-12 lg:px-20">
      <!-- HEADER -->
      <header class="max-w-4xl space-y-10">
        <div class="flex items-center gap-4">
          <div class="h-px w-12 bg-white"></div>
          <span
            class="text-[10px] font-bold tracking-[0.6em] text-white/60 uppercase"
          >
            Engineering & Open Source
          </span>
        </div>

        <h2
          class="font-serif text-4xl leading-[0.95] tracking-tight md:text-6xl"
        >
          Code is not just written.
          <br />
          <span class="font-light text-white/40 italic">
            It is architected, documented and maintained.
          </span>
        </h2>

        <p class="max-w-2xl text-lg leading-relaxed text-gray-400">
          My GitHub reflects structured repositories, production-grade
          documentation, scalable architectural decisions and disciplined
          contribution patterns.
        </p>
      </header>

      <!-- GITHUB GRID -->
      <div class="mt-24 grid gap-20 lg:grid-cols-2">
        <article class="group space-y-8">
          <div class="flex items-center gap-4">
            <Icon
              name="tabler:brand-github"
              size="22"
              class="text-white/70 transition-colors duration-300 group-hover:text-white"
            />
            <h3 class="text-2xl font-semibold text-white/80 italic">
              Profile Architecture
            </h3>
          </div>

          <p class="max-w-md text-gray-400">
            Pinned repositories, structured README hierarchy and clear stack
            communication.
          </p>

          <div
            class="overflow-hidden rounded-xl border border-white/10 bg-white/[0.02] backdrop-blur-md transition-all duration-500 group-hover:border-white/20"
          >
            <img
              src="/images/GitHub1.webp"
              alt="GitHub profile overview"
              class="w-full transition-transform duration-700 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>
        </article>

        <article class="group space-y-8">
          <div class="flex items-center gap-4">
            <Icon
              name="tabler:activity"
              size="22"
              class="text-white/70 transition-colors duration-300 group-hover:text-white"
            />
            <h3 class="text-2xl font-semibold text-white/80 italic">
              Contribution Discipline
            </h3>
          </div>

          <p class="max-w-md text-gray-400">
            Consistent commits, version control rigor and collaborative
            workflows.
          </p>

          <div
            class="overflow-hidden rounded-xl border border-white/10 bg-white/[0.02] backdrop-blur-md transition-all duration-500 group-hover:border-white/20"
          >
            <img
              src="/images/GitHub4.webp"
              alt="GitHub contributions graph"
              class="w-full transition-transform duration-700 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>
        </article>
      </div>

      <div class="group relative mt-32">
        <div
          class="absolute -inset-6 -z-10 translate-x-4 translate-y-4 border border-white/30 transition-all duration-700 group-hover:translate-x-0 group-hover:translate-y-0"
        >
        </div>
        <div class="flex justify-center">
          <video
            src="/videos/Programando2.mp4"
            class="h-auto w-full border border-white/5 shadow-2xl transition-all duration-500 hover:scale-105 hover:border-white/10 hover:shadow-2xl"
            autoplay
            loop
            muted></video>
        </div>
      </div>

      <!-- FEATURED ATTRIBUTES -->
      <div class="mt-32 grid gap-20 lg:grid-cols-3">
        <article class="group space-y-6">
          <div class="flex items-center gap-3">
            <Icon
              name="tabler:folder-code"
              size="20"
              class="text-white/70 transition-colors duration-300 group-hover:text-white"
            />
            <h3 class="text-lg font-semibold text-white/80 italic">
              Repository Quality
            </h3>
          </div>

          <p class="text-gray-400">
            Clean structure, modular separation and long-term maintainability.
          </p>

          <img
            src="/images/GitHub3.webp"
            alt="Repository quality"
            class="w-full rounded-xl border border-white/10 transition-all duration-500 group-hover:border-white/20"
            loading="lazy"
          />
        </article>

        <article class="group space-y-6">
          <div class="flex items-center gap-3">
            <Icon
              name="tabler:file-text"
              size="20"
              class="text-white/70 transition-colors duration-300 group-hover:text-white"
            />
            <h3 class="text-lg font-semibold text-white/80 italic">
              Documentation Standards
            </h3>
          </div>

          <p class="text-gray-400">
            Architectural context, metrics definition and deployment clarity.
          </p>

          <img
            src="/images/GitHub5.webp"
            alt="Professional README example"
            class="w-full rounded-xl border border-white/10 transition-all duration-500 group-hover:border-white/20"
            loading="lazy"
          />
        </article>

        <article class="group space-y-6">
          <div class="flex items-center gap-3">
            <Icon
              name="tabler:layout-grid"
              size="20"
              class="text-white/70 transition-colors duration-300 group-hover:text-white"
            />
            <h3 class="text-lg font-semibold text-white/80 italic">
              Engineering Identity
            </h3>
          </div>

          <p class="text-gray-400">
            Visual coherence aligned with technical philosophy and system
            thinking.
          </p>

          <img
            src="/images/GitHub2.webp"
            alt="GitHub profile design"
            class="w-full rounded-xl border border-white/10 transition-all duration-500 group-hover:border-white/20"
            loading="lazy"
          />
        </article>
      </div>
    </div>
  </section>

  <!-- ================= TECH STACK ================= -->
  <section
    class="relative overflow-hidden border-t border-white/5 py-36"
    id="tech-stack"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_80%_20%,rgba(255,255,255,0.04),transparent_60%)]"
    >
    </div>

    <div class="relative mx-auto w-full max-w-[1300px] px-6 sm:px-12 lg:px-20">
      <header class="max-w-3xl space-y-10">
        <div class="flex items-center gap-4">
          <div class="h-px w-12 bg-white"></div>
          <span
            class="text-[10px] font-bold tracking-[0.6em] text-white/60 uppercase"
          >
            Technology Stack
          </span>
        </div>

        <h2
          class="font-serif text-4xl leading-[0.95] tracking-tight text-white/80 md:text-6xl"
        >
          Full Stack Engineering Toolkit
        </h2>

        <p class="text-lg text-gray-400">
          Core technologies powering production-ready systems.
        </p>
      </header>

      <div
        class="mt-24 grid grid-cols-2 gap-x-14 gap-y-12 text-gray-300 md:grid-cols-3 lg:grid-cols-4"
      >
        <!-- ITEM TEMPLATE -->
        <div class="group flex items-center gap-4">
          <Icon
            name="tabler:brand-javascript"
            size="20"
            class="text-white/70 transition-colors duration-300 group-hover:text-white"
          />
          <span
            class="tracking-wide transition-colors duration-300 group-hover:text-white"
            >JavaScript</span
          >
        </div>

        <div class="group flex items-center gap-4">
          <Icon
            name="tabler:brand-typescript"
            size="20"
            class="text-white/70 transition-colors duration-300 group-hover:text-white"
          />
          <span>TypeScript</span>
        </div>

        <div class="group flex items-center gap-4">
          <Icon
            name="tabler:brand-react"
            size="20"
            class="text-white/70 transition-colors duration-300 group-hover:text-white"
          />
          <span>React</span>
        </div>

        <div class="group flex items-center gap-4">
          <Icon
            name="tabler:brand-nextjs"
            size="20"
            class="text-white/70 transition-colors duration-300 group-hover:text-white"
          />
          <span>Next.js</span>
        </div>

        <div class="group flex items-center gap-4">
          <Icon
            name="tabler:brand-astro"
            size="20"
            class="text-white/70 transition-colors duration-300 group-hover:text-white"
          />
          <span>Astro</span>
        </div>

        <div class="group flex items-center gap-4">
          <Icon
            name="tabler:brand-tailwind"
            size="20"
            class="text-white/70 transition-colors duration-300 group-hover:text-white"
          />
          <span>TailwindCSS</span>
        </div>

        <div class="group flex items-center gap-4">
          <Icon
            name="tabler:database"
            size="20"
            class="text-white/70 transition-colors duration-300 group-hover:text-white"
          />
          <span>Supabase</span>
        </div>

        <div class="group flex items-center gap-4">
          <Icon
            name="tabler:brand-vercel"
            size="20"
            class="text-white/70 transition-colors duration-300 group-hover:text-white"
