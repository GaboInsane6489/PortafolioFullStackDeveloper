---
import { Icon } from "astro-icon/components";

const techStack = [
  {
    name: "Next.js",
    icon: "tabler:brand-nextjs",
    color: "text-white",
    category: "Frontend",
  },
  {
    name: "React",
    icon: "tabler:brand-react",
    color: "text-sky-400",
    category: "Frontend",
  },
  {
    name: "Astro",
    icon: "tabler:brand-astro",
    color: "text-orange-400",
    category: "Frontend",
  },
  {
    name: "TypeScript",
    icon: "tabler:brand-typescript",
    color: "text-blue-500",
    category: "Frontend",
  },
  {
    name: "Tailwind",
    icon: "tabler:brand-tailwind",
    color: "text-cyan-400",
    category: "Frontend",
  },
  {
    name: "Node.js",
    icon: "tabler:brand-nodejs",
    color: "text-green-500",
    category: "Backend",
  },
  {
    name: "Laravel",
    icon: "tabler:brand-laravel",
    color: "text-red-500",
    category: "Backend",
  },
  {
    name: "Supabase",
    icon: "tabler:brand-supabase",
    color: "text-emerald-500",
    category: "Database",
  },
  {
    name: "PostgreSQL",
    icon: "tabler:database",
    color: "text-blue-400",
    category: "Database",
  },
  {
    name: "MongoDB",
    icon: "tabler:brand-mongodb",
    color: "text-green-600",
    category: "Database",
  },
  {
    name: "Vercel",
    icon: "tabler:brand-vercel",
    color: "text-white",
    category: "Deploy",
  },
  {
    name: "GitHub",
    icon: "tabler:brand-github",
    color: "text-white",
    category: "Deploy",
  },
];
---

<section
  id="tech-stack"
  class="relative flex min-h-[80dvh] flex-col justify-center border-t border-white/5 py-16 lg:py-24"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(252,211,77,0.02),transparent_70%)]"
  >
  </div>

  <div class="relative mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 flex flex-col items-center text-center md:mb-16">
      <div class="reveal mb-3 flex items-center gap-3">
        <div class="h-px w-6 bg-amber-500/30"></div>
        <span
          class="font-mono text-[9px] font-black tracking-[0.4em] text-amber-500/80 uppercase"
          >Arsenal</span
        >
        <div class="h-px w-6 bg-amber-500/30"></div>
      </div>

      <h2
        class="reveal font-serif text-3xl leading-tight text-white md:text-5xl lg:text-6xl"
      >
        Systems engineered from<br />
        <span class="font-light text-white/30 italic"
          >interface to infrastructure.</span
        >
      </h2>
    </div>

    <div class="reveal reveal-scale mx-auto max-w-5xl delay-200">
      <div
        class="grid grid-cols-3 gap-x-4 gap-y-10 sm:grid-cols-4 md:grid-cols-6 lg:gap-y-12"
      >
        {
          techStack.map((tech, index) => (
            <div
              class="group relative flex flex-col items-center"
              style={`transition-delay: ${index * 40}ms`}
            >
              <div class="relative mb-3 flex h-16 w-16 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.03] transition-all duration-300 group-hover:-translate-y-1 group-hover:border-amber-500/30 group-hover:bg-amber-500/[0.05] md:h-20 md:w-20">
                <Icon
                  name={tech.icon}
                  class={`text-3xl md:text-4xl ${tech.color} opacity-80 transition-all duration-300 group-hover:scale-110 group-hover:opacity-100`}
                />

                <div class="absolute inset-0 rounded-2xl bg-gradient-to-tr from-transparent via-white/5 to-transparent opacity-0 transition-opacity group-hover:opacity-100" />
              </div>

              <div class="flex flex-col items-center text-center">
                <span class="font-mono text-[10px] font-bold tracking-wider text-white/90 md:text-[11px]">
                  {tech.name}
                </span>
                <span class="mt-0.5 font-mono text-[7px] font-medium tracking-widest text-white/20 uppercase">
                  {tech.category}
                </span>
              </div>

              <div class="absolute inset-0 -z-10 bg-amber-500/5 opacity-0 blur-2xl transition-opacity duration-500 group-hover:opacity-100" />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
