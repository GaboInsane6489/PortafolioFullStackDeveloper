---
import { Icon } from "astro-icon/components";

const links = [
  { label: "Inicio", href: "/" },
  { label: "Proyectos", href: "#projects" },
  { label: "Sobre mí", href: "#about" },
  { label: "Contacto", href: "#contact" },
];
---

<footer
  class="relative z-10 border-t border-white/10 bg-black pt-20 pb-10 text-white"
>
  <div class="mx-auto grid max-w-7xl gap-12 px-6 text-sm md:grid-cols-3">
    <!-- Marca / Identidad -->
    <div class="space-y-4">
      <p class="font-bold tracking-widest uppercase">Gabriel González</p>

      <p class="max-w-sm leading-relaxed text-gray-400">
        Desarrollador Full Stack enfocado en rendimiento, arquitectura limpia y
        experiencias web de alto nivel.
      </p>
    </div>

    <!-- Navegación interna -->
    <nav aria-label="Footer navigation">
      <h4 class="mb-4 text-xs tracking-widest text-gray-500 uppercase">
        Navegación
      </h4>

      <ul class="space-y-3">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="transition hover:opacity-70">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Redes sociales -->
    <div>
      <h4 class="mb-4 text-xs tracking-widest text-gray-500 uppercase">
        Social
      </h4>

      <ul class="space-y-4">
        <li>
          <a
            href="https://github.com"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 transition hover:opacity-70"
          >
            <Icon name="tabler:brand-github" size="18" />
            GitHub
          </a>
        </li>

        <li>
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 transition hover:opacity-70"
          >
            <Icon name="tabler:brand-linkedin" size="18" />
            LinkedIn
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Copyright -->
  <div
    class="mt-16 border-t border-white/10 pt-6 text-center text-xs text-gray-500"
  >
    © {new Date().getFullYear()} Gabriel González — Full Stack Developer
  </div>
</footer>
