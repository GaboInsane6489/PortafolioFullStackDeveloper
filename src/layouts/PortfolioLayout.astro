---
import TopNavbar from "../components/TopNavbar.astro";
import SideNavbar from "../components/SideNavbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/index.css";
import "flowbite";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="title"
      content="Gabriel González | Digital Architect & Full Stack Developer"
    />
    <meta
      name="description"
      content="Immersive portfolio of Gabriel González. specialized in scalable digital systems."
    />
    <link rel="icon" type="image/png" href="/images/LogoPortafolio.webp" />
    <title>Gabriel González | Digital Architect</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body
    class="bg-[#0A0908] font-sans text-white antialiased selection:bg-amber-500/30"
  >
    <div class="pointer-events-none fixed inset-0 -z-50 overflow-hidden">
      <video
        class="absolute h-full w-full object-cover opacity-60 transition-opacity duration-1000"
        src="/videos/Train-Station-Rainy-Day.mp4"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        aria-hidden="true"></video>

      <div
        class="absolute inset-0 bg-gradient-to-b from-[#0A0908]/40 via-[#0A0908]/20 to-[#0A0908] shadow-[inset_0_0_100px_rgba(0,0,0,0.4)]"
      >
      </div>

      <div
        class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.01)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.01)_1px,transparent_1px)] [mask-image:radial-gradient(ellipse_at_center,black,transparent_90%)] bg-[size:6rem_6rem]"
      >
      </div>
    </div>

    <TopNavbar />

    <div class="relative z-10 flex min-h-screen flex-col">
      <main class="mx-auto w-full max-w-[1600px] flex-1 pb-24 md:pb-0 md:pl-24">
        <slot />
      </main>

      <div class="pb-24 md:pb-0">
        <Footer />
      </div>
    </div>

    <div
      class="fixed right-0 bottom-4 left-0 z-40 mx-auto flex w-full max-w-[95%] justify-center md:top-0 md:right-auto md:bottom-0 md:left-6 md:w-auto md:max-w-none md:items-center"
    >
      <SideNavbar />
    </div>

    <script>
      const setupRevealObserver = () => {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("active");
              } else {
                entry.target.classList.remove("active");
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -80px 0px" },
        );

        document
          .querySelectorAll(".reveal")
          .forEach((el) => observer.observe(el));
      };

      setupRevealObserver();
      document.addEventListener("astro:after-swap", setupRevealObserver);
    </script>

    <style is:global>
      /* Mejoras en el renderizado del texto sobre video */
      body {
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
      }

      .reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.9s cubic-bezier(0.17, 0.55, 0.55, 1);
        will-change: opacity, transform;
      }

      .reveal.active {
        opacity: 1;
        transform: translateY(0);
      }

      /* Variaciones y Delays se mantienen igual... */
      .reveal-left {
        transform: translateX(-20px);
      }
      .reveal-right {
        transform: translateX(20px);
      }
      .reveal-left.active,
      .reveal-right.active {
        transform: translateX(0);
      }

      .delay-100 {
        transition-delay: 100ms;
      }
      .delay-200 {
        transition-delay: 200ms;
      }
    </style>
  </body>
</html>
