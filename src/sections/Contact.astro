---
import { Icon } from "astro-icon/components";
---

<section id="contact" class="relative overflow-hidden py-24 lg:py-32">
  <div class="relative z-10 mx-auto w-full max-w-4xl px-8 text-center">
    <div
      class="reveal mb-8 inline-flex items-center gap-3 rounded-full border border-amber-500/20 bg-amber-500/5 px-5 py-2 backdrop-blur-md"
    >
      <span class="relative flex h-2 w-2">
        <span
          class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-75"
        ></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-amber-500"
        ></span>
      </span>
      <span
        class="font-mono text-[9px] font-black tracking-[0.3em] text-amber-500 uppercase"
      >
        Systems Online / Ready for Deployment
      </span>
    </div>

    <h2
      class="reveal mb-8 font-serif text-5xl leading-[1.1] tracking-tight text-white md:text-7xl"
    >
      Ready to <span
        class="bg-gradient-to-r from-amber-200 via-amber-400 to-amber-200 bg-clip-text font-light text-transparent italic"
        >Architect</span
      >
      <br />
      Your Next System?
    </h2>

    <p
      class="reveal mx-auto mb-12 max-w-xl text-base leading-relaxed font-light text-gray-400 md:text-lg"
    >
      ¿Necesitas una infraestructura robusta o una consultoría técnica
      especializada? Estoy listo para inicializar la conexión y escalar tu idea.
    </p>

    <!-- Contact Form HUD -->
    <form
      id="contact-form"
      class="reveal mx-auto flex max-w-md flex-col gap-6 text-left"
    >
      <input
        type="hidden"
        name="access_key"
        value="91d5dea0-56d8-4a01-9589-27909b6301ac"
      />
      <input
        type="hidden"
        name="subject"
        id="hidden-subject"
        value="New connection initialized from Portfolio"
      />
      <input type="hidden" name="from_name" value="PORTFOLIO COMMAND CENTER" />
      <input type="hidden" name="replyto" id="hidden-replyto" value="" />

      <div class="flex flex-col gap-2">
        <label
          for="name"
          class="font-mono text-[10px] uppercase tracking-widest text-amber-500/70"
          >> IDENTIFIER_</label
        >
        <input
          type="text"
          id="name"
          name="OPERATOR_NAME"
          required
          class="w-full rounded-none border border-white/10 bg-black/40 px-4 py-3 font-mono text-sm text-white placeholder-gray-600 outline-none transition-colors focus:border-amber-500/50 focus:bg-amber-500/5"
          placeholder="Enter your name"
        />
      </div>

      <div class="flex flex-col gap-2">
        <label
          for="email"
          class="font-mono text-[10px] uppercase tracking-widest text-amber-500/70"
          >> COMM_LINK_</label
        >
        <input
          type="email"
          id="email"
          name="OPERATOR_MAIL"
          required
          class="w-full rounded-none border border-white/10 bg-black/40 px-4 py-3 font-mono text-sm text-white placeholder-gray-600 outline-none transition-colors focus:border-amber-500/50 focus:bg-amber-500/5"
          placeholder="Enter your email"
        />
      </div>

      <div class="flex flex-col gap-2">
        <label
          for="message"
          class="font-mono text-[10px] uppercase tracking-widest text-amber-500/70"
          >> PAYLOAD_</label
        >
        <textarea
          id="message"
          name="DATA_PAYLOAD"
          required
          rows="4"
          class="w-full resize-none rounded-none border border-white/10 bg-black/40 px-4 py-3 font-mono text-sm text-white placeholder-gray-600 outline-none transition-colors focus:border-amber-500/50 focus:bg-amber-500/5"
          placeholder="Type your message here..."
        ></textarea>
      </div>

      <button
        type="submit"
        id="submit-btn"
        class="group relative mt-2 flex w-full items-center justify-center gap-3 overflow-hidden border border-amber-500/30 bg-amber-500/10 px-8 py-4 font-mono text-[11px] font-black tracking-[0.2em] text-amber-500 uppercase transition-all duration-300 hover:border-amber-500 hover:bg-amber-500/20 hover:shadow-[0_0_30px_rgba(245,158,11,0.15)]"
      >
        <span
          class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-amber-500/20 to-transparent transition-transform duration-500 ease-out group-hover:translate-x-full"
        ></span>
        <Icon
          name="tabler:terminal-2"
          size={18}
          class="transition-transform group-hover:scale-110"
        />
        <span id="btn-text">Execute Command</span>
      </button>

      <div
        id="status-message"
        class="mt-2 hidden text-center font-mono text-[11px] uppercase tracking-widest"
      >
      </div>
    </form>

    <div
      class="reveal mt-16 flex flex-col items-center gap-4 opacity-40 transition-opacity hover:opacity-100"
    >
      <div
        class="h-8 w-px bg-gradient-to-b from-transparent via-amber-500/50 to-transparent"
      >
      </div>
      <div
        class="flex flex-col items-center gap-1 font-mono text-[9px] tracking-[0.4em] text-gray-500 uppercase"
      >
        <p>Based in Venezuela</p>
        <p class="text-amber-500/40">•</p>
        <p>Available Worldwide</p>
      </div>
    </div>
  </div>
</section>

<style>
  .reveal {
    transition: all 0.8s cubic-bezier(0.2, 1, 0.3, 1);
  }
</style>

<script>
  const setupContactForm = () => {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const statusMessage = document.getElementById("status-message");
    const btnText = document.getElementById("btn-text");
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

    if (!form || !statusMessage || !btnText || !submitBtn) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const operatorName = formData.get("OPERATOR_NAME");
      const operatorMail = formData.get("OPERATOR_MAIL");
      
      formData.set("subject", `[TERMINAL UPLINK] Mensaje de ${operatorName}`);
      formData.set("replyto", operatorMail as string);
      
      // Update UI to loading state
      submitBtn.disabled = true;
      btnText.textContent = "Transmitting...";
      statusMessage.classList.remove("hidden", "text-red-500", "text-amber-500");
      statusMessage.classList.add("text-gray-400");
      statusMessage.textContent = "[SYSTEM]: Establishing secure link...";

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData,
        });

        const data = await response.json();

        if (data.success) {
          form.reset();
          btnText.textContent = "Execute Command";
          statusMessage.classList.remove("text-gray-400", "text-red-500");
          statusMessage.classList.add("text-amber-500");
          statusMessage.textContent = "[SYSTEM]: Message transmitted successfully.";
        } else {
          btnText.textContent = "Retry Connection";
          statusMessage.classList.remove("text-gray-400", "text-amber-500");
          statusMessage.classList.add("text-red-500");
          statusMessage.textContent = "[ERROR]: Transmission failed. Check logs.";
        }
      } catch (error) {
        btnText.textContent = "Retry Connection";
        statusMessage.classList.remove("text-gray-400", "text-amber-500");
        statusMessage.classList.add("text-red-500");
        statusMessage.textContent = "[ERROR]: Connection lost. Target unreachable.";
      } finally {
        submitBtn.disabled = false;
        
        // Hide success message after 5 seconds
        if (statusMessage.classList.contains("text-amber-500")) {
          setTimeout(() => {
            statusMessage.classList.add("hidden");
          }, 5000);
        }
      }
    });
  };

  setupContactForm();
  document.addEventListener("astro:after-swap", setupContactForm);
</script>
