---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  class="relative flex items-center overflow-hidden border-t border-white/5 py-8 md:py-12"
  id="about-me"
>
  <div
    class="pointer-events-none absolute inset-0 [background-image:radial-gradient(rgba(165,166,246,0.05)_1px,transparent_1px)] [mask-image:linear-gradient(180deg,white,transparent)] [background-size:24px_24px] opacity-20"
  >
  </div>

  <div class="relative mx-auto w-full max-w-[1200px] px-6 sm:px-12 lg:px-16">
    <div class="flex flex-col gap-6 lg:gap-10">
      {/* Top Row: Introduction & Stats */}
      <div
        class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between"
      >
        {/* Left: Text */}
        <div class="space-y-4 lg:w-[60%]">
          <div class="space-y-3">
            <div class="reveal flex items-center gap-3">
              <div class="h-px w-8 bg-lofi-accent/60"></div>
              <span
                class="text-[9px] font-black tracking-[0.4em] text-lofi-accent uppercase drop-shadow-[0_0_8px_rgba(165,166,246,0.3)]"
              >
                {t("about.badge")}
              </span>
            </div>

            <h2
              class="reveal font-serif text-3xl leading-[1.1] tracking-tighter text-white delay-100 md:text-4xl lg:text-5xl xl:text-6xl"
            >
              {t("about.title1")}
              <br />
              <span class="font-light text-white/30 italic"
                >{t("about.title2")}</span
              >
            </h2>
          </div>

          <div
            class="reveal space-y-3 text-sm leading-relaxed font-medium text-slate-300 delay-200 md:text-base"
          >
            <p set:html={t("about.p1")} />
            <p set:html={t("about.p2")} />
            <p set:html={t("about.p3")} />
          </div>
        </div>

        {/* Right: Stats & Tags */}
        <div class="flex flex-col gap-6 lg:w-[35%] lg:pb-2">
          <div
            class="reveal reveal-right flex flex-row flex-wrap gap-x-6 gap-y-4 border-l border-white/10 pl-5 delay-500"
          >
            {
              [
                {
                  label: t("about.stat1.label"),
                  value: t("about.stat1.value"),
                },
                {
                  label: t("about.stat2.label"),
                  value: t("about.stat2.value"),
                },
                {
                  label: t("about.stat3.label"),
                  value: t("about.stat3.value"),
                },
              ].map((item: any) => (
                <div class="group cursor-default">
                  <p class="text-[8px] font-black tracking-widest text-lofi-soft uppercase drop-shadow-[0_0_5px_rgba(203,176,228,0.2)]">
                    {item.label}
                  </p>
                  <p class="text-sm font-bold text-white transition-colors group-hover:text-lofi-accent md:text-base">
                    {item.value}
                  </p>
                </div>
              ))
            }
          </div>

          <div class="flex flex-wrap gap-2">
            {
              [
                "PostgreSQL",
                "Event-Driven",
                "CI/CD Pipelines",
                "REST APIs",
                "Node.js",
                "MVC",
              ].map((tag: string, index: number) => (
                <span
                  class="reveal rounded-md border border-white/10 bg-white/[0.05] px-2.5 py-1 text-[8px] font-black tracking-widest text-lofi-soft/80 uppercase backdrop-blur-sm transition-colors hover:border-lofi-accent/50 hover:text-white"
                  style={`transition-delay: ${(index + 6) * 100}ms`}
                >
                  {tag}
                </span>
              ))
            }
          </div>
        </div>
      </div>

      {/* Bottom Row: Panoramic Hero Video */}
      <div class="reveal reveal-scale group relative w-full delay-300">
        <div
          class="flex w-full flex-col overflow-hidden rounded-xl border border-white/10 bg-white/[0.02] backdrop-blur-sm shadow-2xl transition-all duration-300 group-hover:border-lofi-accent/40"
        >
          <div
            class="flex h-8 shrink-0 items-center justify-between bg-white/[0.02] backdrop-blur-sm px-4"
          >
            <div class="flex items-center gap-4">
              <div class="flex gap-1.5">
                <div class="h-2 w-2 rounded-full bg-red-500/20"></div>
                <div class="h-2 w-2 rounded-full bg-yellow-500/20"></div>
                <div class="h-2 w-2 rounded-full bg-green-500/20"></div>
              </div>
              <div
                class="flex h-8 items-center gap-2 border-t border-t-lofi-accent/50 bg-white/[0.02] backdrop-blur-sm px-4"
              >
                <Icon
                  name="tabler:brand-typescript"
                  size={12}
                  class="text-[#8caaee]"
                />
                <span class="font-mono text-[10px] text-[#c6d0f5]"
                  >TechnicalExpertise.ts</span
                >
              </div>
            </div>
            <span
              class="hidden font-mono text-[9px] tracking-widest text-white/10 uppercase md:block"
              >Production Environment — Global</span
            >
          </div>

          <div class="relative h-[250px] w-full sm:h-[340px] lg:h-[420px]">
            <video
              id="about-video"
              src="/videos/Code3.mp4"
              class="absolute inset-0 h-full w-full object-cover opacity-60 transition-transform duration-700 group-hover:scale-[1.01] group-hover:opacity-100"
              autoplay
              loop
              muted
              playsinline></video>
            <div
              class="absolute inset-0 bg-gradient-to-t from-[#0A0908]/90 via-[#0A0908]/10 to-transparent"
            >
            </div>

            <div class="absolute bottom-6 left-6 z-10">
              <p
                class="font-serif text-xl leading-tight text-white/90 italic md:text-2xl"
              >
                "{t("about.quote1")}"<br />
                <span class="text-lofi-pop/80">"{t("about.quote2")}"</span>
              </p>
            </div>
          </div>
        </div>

        <div
          class="absolute -inset-4 -z-10 rounded-[2rem] bg-lofi-accent/5 opacity-0 blur-3xl transition-opacity duration-500 group-hover:opacity-100"
        >
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const setupAboutVideo = () => {
    const video = document.getElementById('about-video') as HTMLVideoElement;
    if (!video) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          video.play().catch(() => {}); // Handle potential play() rejection
        } else {
          video.pause();
        }
      });
    }, { threshold: 0.1 });

    observer.observe(video);
  };

  setupAboutVideo();
  document.addEventListener('astro:after-swap', setupAboutVideo);
</script>
