---
import TopNavbar from "../components/layout/TopNavbar.astro";
import SideNavbar from "../components/layout/SideNavbar.astro";
import Footer from "../components/layout/Footer.astro";
import Noise from "../components/ui/Noise.astro";
import BootScreen from "../components/ui/BootScreen.astro";
import CustomCursor from "../components/ui/CustomCursor.astro";
import "../styles/index.css";
import "flowbite";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { ClientRouter } from "astro:transitions";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { Icon } from "astro-icon/components";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// These variables seem to be intended for Footer.astro or SideNavbar.astro,
// but the instruction implies they should be added here.
// If they are not used in this layout file, they might be dead code.
// However, following the instruction to add them.
const links = [
  { label: "hero.tsx", href: `/${lang}/#hero` },
  { label: "projects.db", href: `/${lang}/#projects` },
  { label: "experience.cpp", href: `/${lang}/#experience` },
  { label: "laboratory.py", href: `/${lang}/#laboratory` },
];

const socials = [
  {
    label: "GitHub",
    href: "https://github.com/GaboInsane6489",
    icon: "tabler:brand-github",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/gabriel-gonzalez-fullstack/",
    icon: "tabler:brand-linkedin",
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/dreamsfallen6488/",
    icon: "tabler:brand-instagram",
  },
  {
    label: "YouTube",
    href: "https://www.youtube.com/@Gabo6489Gaming-pe2tg",
    icon: "tabler:brand-youtube",
  },
];
---

<!doctype html>
<html lang={lang} class="h-full scroll-smooth overflow-x-hidden">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary SEO -->
    <title>{t("seo.title")}</title>
    <meta name="title" content={t("seo.title")} />
    <meta name="description" content={t("seo.description")} />
    <meta name="author" content="Gabriel González" />
    <meta
      name="keywords"
      content="Full Stack Developer, System Architect, Web Development, JavaScript, TypeScript, Astro, React, Node.js, Portafolio, Venezuela"
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://gabo-fullstack.vercel.app" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://gabo-fullstack.vercel.app" />
    <meta property="og:title" content={t("seo.title")} />
    <meta property="og:description" content={t("seo.description")} />
    <meta
      property="og:image"
      content="https://gabo-fullstack.vercel.app/images/PortafolioFullStackDeveloper.webp"
    />
    <meta property="og:image:alt" content="Gabriel González - Portfolio" />
    <meta property="og:locale" content={lang === "es" ? "es_VE" : "en_US"} />
    <meta property="og:site_name" content="Gabriel González Portfolio" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://gabo-fullstack.vercel.app" />
    <meta name="twitter:title" content={t("seo.title")} />
    <meta name="twitter:description" content={t("seo.description")} />
    <meta
      name="twitter:image"
      content="https://gabo-fullstack.vercel.app/images/PortafolioFullStackDeveloper.webp"
    />

    <link rel="icon" type="image/png" href="/images/LogoPortafolio.webp" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>

  <body
    class="min-h-screen font-sans text-white antialiased selection:bg-lofi-accent/30 overflow-x-hidden"
  >
    <!-- Base background color layer (behind everything) -->
    <div class="fixed inset-0 -z-[100] bg-lofi-base"></div>
    <BootScreen />
    <CustomCursor />
    <Noise />
    <div id="backdrop-container" class="pointer-events-none fixed inset-[-5%] -z-50 overflow-hidden transition-transform duration-700 ease-out">
      <video
        class="absolute h-[110%] w-[110%] -left-[5%] -top-[5%] object-cover opacity-30 transition-opacity duration-1000"
        src="/videos/Programando.mp4"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        aria-hidden="true"></video>

      <div
        class="absolute inset-0 bg-gradient-to-b from-lofi-base/20 via-transparent to-lofi-base/80 shadow-[inset:0_0_100px_rgba(0,0,0,0.2)]"
      >
      </div>

      <div
        id="parallax-grid"
        class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.01)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.01)_1px,transparent_1px)] [mask-image:radial-gradient(ellipse_at_center,black,transparent_90%)] bg-[size:6rem_6rem] transition-transform duration-500 ease-out"
      >
      </div>
    </div>

    <!-- IDE Frame Layout: PERSISTENT INVERTED L -->
    <div class="relative w-full">
      <!-- Top Bar: Fixed (Horizontal part of L) -->
      <header class="fixed top-0 left-0 z-[500] w-full flex-shrink-0 transition-transform duration-300">
        <TopNavbar />
      </header>

      <!-- Sidebar: Fixed (Vertical part of L) -->
      <aside
        class="fixed top-0 left-0 z-[400] hidden h-full w-20 flex-shrink-0 flex-col items-center justify-center border-r border-white/5 bg-[#0D0C0B]/40 pt-24 backdrop-blur-xl md:flex"
      >
        <SideNavbar />
      </aside>

      <!-- Main Content Area: Natural Scroll (The actual workspace) -->
      <main class="relative min-h-screen w-full pt-[72px] md:pl-20">
        <div class="relative z-10 mx-auto w-full max-w-full">
          <slot />
          <Footer />
        </div>
      </main>
    </div>

    <!-- Optimization: Browser Rendering Hint -->
    <style is:global>
      section {
        content-visibility: auto;
        contain-intrinsic-size: 1px 500px;
      }
      #hero {
        content-visibility: visible;
      }
    </style>


    <script>
      const setupRevealObserver = () => {
        const observerOptions = {
          threshold: 0.05,
          rootMargin: "0px 0px -20px 0px",
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("active");
              observer.unobserve(entry.target);
            }
          });
        }, observerOptions);

        document
          .querySelectorAll(".reveal")
          .forEach((el) => observer.observe(el));
      };

      // --- DYNAMIC BACKDROP PARALLAX ---
      const setupParallax = () => {
        const backdrop = document.getElementById('backdrop-container');
        const grid = document.getElementById('parallax-grid');
        if (!backdrop || !grid) return;

        window.addEventListener('mousemove', (e) => {
          const moveX = (e.clientX - window.innerWidth / 2) * 0.01;
          const moveY = (e.clientY - window.innerHeight / 2) * 0.01;
          
          grid.style.transform = `translate3d(${moveX * 2}px, ${moveY * 2}px, 0)`;
        });
      };

      // Initial execution
      setupRevealObserver();
      setupParallax();
      // Execute on each Astro View Transition swap
      document.addEventListener("astro:after-swap", () => {
        setupRevealObserver();
        setupParallax();
      });
    </script>

    <style is:global>
      /* --- PREMIUM ANIMATION SYSTEM --- */
      
      /* Base reveal class with Hardware Acceleration */
      .reveal {
        opacity: 0;
        filter: blur(5px);
        transform: translateY(15px) scale(0.99) translateZ(0); /* HW Accel Boost */
        backface-visibility: hidden;
        transition: 
          opacity 0.6s cubic-bezier(0.25, 1, 0.5, 1), 
          filter 0.5s cubic-bezier(0.25, 1, 0.5, 1),
          transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
        will-change: opacity, transform, filter;
      }

      /* Entrance State */
      .reveal.active {
        opacity: 1;
        filter: blur(0);
        transform: translateY(0) translateX(0) scale(1) translateZ(0);
      }

      /* Directional Reveal Variants */
      .reveal-left { transform: translateX(-15px) scale(0.99) translateZ(0); }
      .reveal-right { transform: translateX(15px) scale(0.99) translateZ(0); }
      .reveal-scale { transform: scale(0.96) translateZ(0); }

      /* Multi-level Delay System (Staggered entries) */
      .delay-100 { transition-delay: 50ms; }
      .delay-200 { transition-delay: 100ms; }
      .delay-300 { transition-delay: 150ms; }
      .delay-400 { transition-delay: 200ms; }
      .delay-500 { transition-delay: 250ms; }
      .delay-700 { transition-delay: 350ms; }

      /* Texto sobre video optimization */
      html, body {
        overflow-x: hidden;
        width: 100%;
        position: relative;
      }
      
      body {
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
      }
    </style>
      {import.meta.env.PROD && (
        <Analytics />
        <SpeedInsights />
      )}
    </body>
</html>
