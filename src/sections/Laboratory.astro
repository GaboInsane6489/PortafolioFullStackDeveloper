---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="laboratory"
  class="flex justify-center px-4 py-12 sm:px-8 lg:py-16"
>
  <div
    class="reveal reveal-scale relative mx-auto w-full max-w-[1400px] overflow-hidden rounded-[2rem] border border-amber-500/10 shadow-[0_0_50px_rgba(245,158,11,0.02)]"
  >
    <div class="grid-bg pointer-events-none absolute inset-0 opacity-[0.05]">
    </div>

    <div class="relative z-10 px-4 py-5 sm:px-8 sm:py-6 lg:px-12 lg:py-8">
      <!-- Header Focus -->
      <div
        class="mb-8 flex flex-col items-start justify-between gap-4 md:flex-row md:items-end lg:mb-10"
      >
        <div>
          <div class="reveal flex items-center gap-3">
            <span class="h-px w-8 bg-amber-500/40"></span>
            <span
              class="font-mono text-[9px] font-black tracking-[0.4em] text-amber-500 uppercase drop-shadow-[0_0_8px_rgba(245,158,11,0.3)]"
              >{t("lab.badge")}</span
            >
          </div>
          <h2
            class="reveal mt-3 font-serif text-3xl leading-tight text-white md:text-5xl lg:text-6xl"
          >
            {t("lab.title1")}
            <span
              class="bg-gradient-to-r from-amber-400 to-amber-600 bg-clip-text text-transparent italic"
              >{t("lab.title2")}</span
            >
          </h2>
        </div>
        <p
          class="reveal max-w-md font-mono text-[11px] leading-relaxed text-gray-500 md:text-right"
        >
          {t("lab.description")}
        </p>
      </div>

      <!-- PANORAMIC COLLAGE GRID -->
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-3 lg:gap-8">
        <!-- Column 1: Engineering Toolkit (The Base) -->
        <div
          class="reveal reveal-right group relative overflow-hidden rounded-xl border border-white/5 bg-black/60 p-6 backdrop-blur-xl transition-all duration-500 hover:border-amber-500/30"
        >
          <div
            class="mb-6 flex items-center justify-between border-b border-white/5 pb-4"
          >
            <div class="flex gap-1.5">
              <div class="h-1.5 w-1.5 rounded-full bg-red-500/30"></div>
              <div class="h-1.5 w-1.5 rounded-full bg-amber-500/30"></div>
            </div>
            <span
              class="font-mono text-[8px] font-bold tracking-widest text-amber-500/80 uppercase"
              >ENGINEERING_TOOLKIT</span
            >
          </div>

          <div class="space-y-4">
            {
              [
                {
                  label: t("lab.specs.cpu"),
                  val: t("lab.specs.cpu.val"),
                  icon: "tabler:binary-tree",
                },
                {
                  label: t("lab.specs.ram"),
                  val: t("lab.specs.ram.val"),
                  icon: "tabler:database-cog",
                },
                {
                  label: t("lab.specs.gpu"),
                  val: t("lab.specs.gpu.val"),
                  icon: "tabler:engine",
                },
                {
                  label: t("lab.specs.os"),
                  val: t("lab.specs.os.val"),
                  icon: "tabler:lambda",
                },
              ].map((item: any) => (
                <div class="group/item flex flex-col gap-1 border-b border-white/[0.02] pb-3 last:border-0">
                  <div class="flex items-center gap-2">
                    <Icon
                      name={item.icon}
                      class="text-gray-600 transition-colors group-hover/item:text-amber-500/60"
                      size={14}
                    />
                    <span class="font-mono text-[10px] font-bold tracking-tighter text-gray-400 uppercase">
                      {item.label}
                    </span>
                  </div>
                  <span class="text-[13px] font-bold text-gray-300 transition-colors group-hover/item:text-amber-200">
                    {item.val}
                  </span>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Column 2: Anti-Gravity Paradox (Central Visual) -->
        <div
          class="reveal reveal-scale relative flex flex-col overflow-hidden rounded-xl border border-amber-500/10 bg-[#080808] p-4 min-h-[220px] lg:aspect-auto"
        >
          <div
            class="absolute inset-0 bg-gradient-to-t from-amber-500/5 to-transparent"
          >
          </div>
          <div
            class="relative z-10 flex h-full flex-col items-center justify-center gap-6"
          >
            <div class="group relative">
              <div
                class="absolute -inset-4 rounded-full bg-amber-500/10 opacity-0 blur-2xl transition-opacity duration-700 group-hover:opacity-100"
              >
              </div>
              <img
                src="/images/CodeAntigravity.webp"
                alt="Code Paradox"
                class="relative h-32 w-32 object-contain drop-shadow-[0_0_20px_rgba(245,158,11,0.2)] transition-all duration-700 group-hover:scale-110 group-hover:drop-shadow-[0_0_30px_rgba(245,158,11,0.4)] md:h-40 md:w-40"
              />
            </div>
            <div class="text-center">
              <span
                class="block font-mono text-[10px] font-bold tracking-[0.3em] text-amber-500 uppercase"
                >System_Paradox</span
              >
              <span class="mt-1 block font-serif text-lg font-medium text-white"
                >Anti-Gravity Engine</span
              >
            </div>
            <div class="flex gap-4">
              <div class="h-0.5 w-12 bg-amber-500/20"></div>
              <Icon
                name="tabler:atom-2"
                class="animate-spin-slow text-amber-500"
                size={20}
              />
              <div class="h-0.5 w-12 bg-amber-500/20"></div>
            </div>
          </div>
        </div>

        <!-- Column 3: Research & Methodology (Operations) -->
        <div class="reveal reveal-left flex flex-col gap-6">
          <div
            class="flex-1 rounded-xl border border-white/5 bg-black/60 p-6 backdrop-blur-xl transition-all hover:border-amber-500/20"
          >
            <h3
              class="mb-6 flex items-center justify-between font-mono text-[11px] font-black tracking-widest text-amber-500 uppercase"
            >
              <span>{t("lab.active.title")}</span>
              <Icon
                name="tabler:activity-heartbeat"
                class="animate-pulse"
                size={16}
              />
            </h3>

            <div class="space-y-5">
              {
                [
                  { name: t("lab.active.res1"), icon: "tabler:brain" },
                  { name: t("lab.active.res2"), icon: "tabler:arrows-join-2" },
                  { name: t("lab.active.res3"), icon: "tabler:components" },
                ].map((res: any) => (
                  <div class="group flex items-center gap-4 border-b border-white/[0.03] pb-3 transition-all last:border-0 hover:translate-x-1">
                    <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-amber-500/10 text-amber-500/60 transition-colors group-hover:bg-amber-500/20 group-hover:text-amber-500">
                      <Icon name={res.icon} size={14} />
                    </div>
                    <span class="font-mono text-[11px] text-slate-300 uppercase transition-colors group-hover:text-white">
                      {res.name}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div
              class="rounded-xl border border-white/5 bg-black/40 p-4 transition-all hover:border-amber-500/20"
            >
              <span
                class="mb-2 block font-mono text-[8px] font-bold tracking-widest text-gray-400 uppercase"
                >{t("lab.method.automation")}</span
              >
              <div
                class="flex items-center gap-2 font-mono text-xs text-amber-100/90"
              >
                <Icon
                  name="tabler:git-merge"
                  size={14}
                  class="text-amber-500"
                />
                <span>CI/CD</span>
              </div>
            </div>
            <div
              class="rounded-xl border border-white/5 bg-black/40 p-4 transition-all hover:border-amber-500/20"
            >
              <span
                class="mb-2 block font-mono text-[8px] font-bold tracking-widest text-gray-400 uppercase"
                >{t("lab.method.protocol")}</span
              >
              <div
                class="flex items-center gap-2 font-mono text-xs text-amber-100/90"
              >
                <Icon name="tabler:terminal" size={14} class="text-amber-500" />
                <span>PR-Driven</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #laboratory {
    min-height: auto;
  }

  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal.active {
    opacity: 1;
    transform: translateY(0);
  }
  .reveal-scale {
    transform: scale(0.95);
  }
  .reveal-scale.active {
    transform: scale(1);
  }
  .reveal-right {
    transform: translateX(-20px);
  }
  .reveal-right.active {
    transform: translateX(0);
  }
  .reveal-left {
    transform: translateX(20px);
  }
  .reveal-left.active {
    transform: translateX(0);
  }

  @keyframes spin-slow {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  .animate-spin-slow {
    animation: spin-slow 8s linear infinite;
  }
</style>

<script>
  function initReveal() {
    const reveals = document.querySelectorAll(".reveal");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 },
    );
    reveals.forEach((el) => observer.observe(el));
  }
  initReveal();
  document.addEventListener("astro:page-load", initReveal);
</script>
