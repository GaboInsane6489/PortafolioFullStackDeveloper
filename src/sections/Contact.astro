---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="relative overflow-clip py-10 md:py-16 lg:py-20">
  <!-- Inherited Laboratory Aesthetics -->
  <div class="grid-bg pointer-events-none absolute inset-0 opacity-[0.03]"></div>
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_70%_50%,rgba(250,145,207,0.03),transparent_70%)]"></div>

  <div class="relative z-10 mx-auto w-full max-w-6xl px-5 sm:px-8">
    <div
      class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-start lg:gap-x-16"
    >
      <!-- System Info: High-Tech Sidebar -->
      <div
        class="text-center lg:sticky lg:top-32 lg:col-span-5 lg:mb-0 lg:text-left"
      >
        <div
          class="reveal mb-6 inline-flex items-center gap-3 rounded-full border border-lofi-accent/20 bg-lofi-accent/5 px-5 py-2 backdrop-blur-md"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-lofi-pop opacity-75"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-lofi-pop"
            ></span>
          </span>
          <span
            class="font-mono text-[9px] font-black tracking-[0.3em] text-lofi-accent uppercase"
          >
            {t("nav.status")}
          </span>
        </div>

        <h2
          class="reveal mb-6 font-serif text-3xl leading-tight tracking-tight text-balance text-white md:text-4xl lg:text-5xl"
        >
          {t("contact.title")}
          <br />
          <span
            class="bg-gradient-to-r from-lofi-accent via-lofi-soft to-lofi-accent bg-clip-text font-light text-transparent italic"
          >
            {t("contact.subtitle")}
          </span>
        </h2>

        <!-- ANTI-GRAVITY VISUAL (Merged from Laboratory) -->
        <div class="reveal delay-100 group relative mb-10 mt-8 hidden justify-center lg:flex">
          <div class="absolute -inset-10 rounded-full bg-lofi-pop/5 opacity-0 blur-3xl transition-opacity duration-700 group-hover:opacity-100"></div>
          <div class="relative">
             <img src="/images/CodeAntigravity.webp" alt="Neural Link" class="h-48 w-48 object-contain drop-shadow-[0_0_25px_rgba(250,145,207,0.15)] transition-all duration-700 hover:scale-105 hover:rotate-3" />
             
             <!-- Floating HUD Labels -->
             <div class="absolute -right-8 top-0 flex flex-col gap-1 opacity-40">
                <span class="font-mono text-[6px] text-lofi-pop uppercase tracking-[0.4em]">system_active</span>
                <span class="font-mono text-[6px] text-white/50 uppercase tracking-[0.4em]">latency_12ms</span>
             </div>
          </div>
        </div>

        <div class="reveal delay-200 grid grid-cols-2 gap-4 mt-10">
           {[
             { label: "COMM_SSL", val: "AES_256", icon: "tabler:shield-lock" },
             { label: "UPLINK_TYPE", val: "TERMINAL_PR", icon: "tabler:binary-tree" }
           ].map((item) => (
             <div class="rounded-xl border border-white/5 bg-white/[0.02] p-4 backdrop-blur-sm transition-colors hover:border-lofi-accent/20">
                <Icon name={item.icon} size={14} class="text-lofi-accent/40 mb-2" />
                <span class="block font-mono text-[8px] font-bold text-gray-500 uppercase tracking-widest">{item.label}</span>
                <span class="font-mono text-[11px] font-black text-white">{item.val}</span>
             </div>
           ))}
        </div>
      </div>

      <!-- Command Interface -->
      <div class="lg:col-span-7">
        <form
          id="contact-form"
          class="reveal grid grid-cols-1 gap-6 sm:grid-cols-2"
        >
          <input
            type="hidden"
            name="access_key"
            value="91d5dea0-56d8-4a01-9589-27909b6301ac"
          />
          <input
            type="hidden"
            name="subject"
            value="[PORTFOLIO_SYSTEM_UPLINK] New Message Received"
          />
          <input
            type="hidden"
            name="from_name"
            value="PORTFOLIO COMMAND CENTER"
          />
          <input type="hidden" name="replyto" id="hidden-replyto" value="" />
          <input type="hidden" name="00_PROTOCOL_STATUS" value="ESTABLISHED" />
          <input
            type="hidden"
            name="01_SECURITY_LEVEL"
            value="ENCRYPTED_USER_DATA"
          />

          <div class="flex flex-col gap-2 sm:col-span-1">
            <label
              for="name"
              class="font-mono text-[10px] font-bold tracking-widest text-lofi-soft uppercase"
            >
              {t("contact.form.name")} _</label
            >
            <input
              type="text"
              id="name"
              name="OPERATOR_IDENTITY"
              required
              class="w-full rounded-none border border-white/20 bg-black/60 px-4 py-3 font-mono text-sm text-white placeholder-slate-400 transition-colors outline-none focus:border-lofi-accent/50 focus:bg-lofi-accent/5"
              placeholder="Enter your name"
            />
          </div>

          <div class="flex flex-col gap-2 sm:col-span-1">
            <label
              for="email"
              class="font-mono text-[10px] font-bold tracking-widest text-lofi-soft uppercase"
            >
              {t("contact.form.email")} _</label
            >
            <input
              type="email"
              id="email"
              name="CONTACT_ENDPOINT"
              required
              class="w-full rounded-none border border-white/20 bg-black/60 px-4 py-3 font-mono text-sm text-white placeholder-slate-400 transition-colors outline-none focus:border-lofi-accent/50 focus:bg-lofi-accent/5"
              placeholder="Enter your email"
            />
          </div>

          <div class="flex flex-col gap-2 sm:col-span-2">
            <label
              for="message"
              class="font-mono text-[10px] font-bold tracking-widest text-lofi-soft uppercase"
            >
              {t("contact.form.message")} _</label
            >
            <textarea
              id="message"
              name="TRANSMITTED_PAYLOAD"
              required
              rows="4"
              class="w-full resize-none rounded-none border border-white/20 bg-black/60 px-4 py-3 font-mono text-sm text-white placeholder-slate-400 transition-colors outline-none focus:border-lofi-accent/50 focus:bg-lofi-accent/5"
              placeholder="Type your message here..."></textarea>
          </div>

          <input
            type="hidden"
            name="ZZ_LOG_END"
            value="--- END OF TRANSMISSION ---"
          />

          <div class="sm:col-span-2">
            <button
              type="submit"
              id="submit-btn"
              class="group relative flex w-full items-center justify-center gap-3 overflow-hidden border border-lofi-pop/50 bg-lofi-pop/10 px-8 py-4 font-mono text-[11px] font-black tracking-[0.2em] text-lofi-pop uppercase transition-all duration-300 hover:border-lofi-pop hover:bg-lofi-pop/20 hover:shadow-[0_0_40px_rgba(250,145,207,0.25)]"
            >
              <span
                class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-lofi-pop/20 to-transparent transition-transform duration-500 ease-out group-hover:translate-x-full"
              ></span>
              <Icon
                name="tabler:terminal-2"
                size={18}
                class="transition-transform group-hover:scale-110"
              />
              <span id="btn-text">{t("contact.form.cta")}</span>
            </button>

            <div
              id="status-message"
              class="mt-4 hidden text-center font-mono text-[11px] tracking-widest uppercase"
            >
            </div>

            <!-- Compact System Metadata -->
            <div
              class="mt-8 flex items-center justify-between border-t border-white/10 pt-6 opacity-60"
            >
              <div
                class="flex items-center gap-2 font-mono text-[8px] tracking-widest text-gray-500 uppercase"
              >
                <Icon
                  name="tabler:map-pin"
                  size={12}
                  class="text-lofi-accent/50"
                />
                <span>{t("contact.info.location")}</span>
              </div>
              <div
                class="mx-4 h-px flex-1 bg-gradient-to-r from-lofi-accent/20 to-transparent"
              >
              </div>
              <div
                class="font-mono text-[8px] tracking-widest text-gray-500 uppercase"
              >
                <span>{t("contact.info.availability")}</span>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>


<script>
  const setupContactForm = () => {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const statusMessage = document.getElementById("status-message");
    const btnText = document.getElementById("btn-text");
    const submitBtn = document.getElementById(
      "submit-btn",
    ) as HTMLButtonElement;

    if (!form || !statusMessage || !btnText || !submitBtn) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const operatorName = formData.get("OPERATOR_IDENTITY");
      const operatorMail = formData.get("CONTACT_ENDPOINT");

      formData.set(
        "subject",
        `[PORTFOLIO_SYSTEM_UPLINK] Message from ${operatorName}`,
      );
      formData.set("replyto", operatorMail as string);

      // Get translations for script (simplified for client-side)
      const isEs = window.location.pathname.includes("/es");
      const msgEstablishing = isEs
        ? "[SISTEMA]: Estableciendo enlace seguro..."
        : "[SYSTEM]: Establishing secure link...";
      const msgTransmitting = isEs ? "Transmitiendo..." : "Transmitting...";
      const msgSuccess = isEs
        ? "[SISTEMA]: Mensaje transmitido con éxito."
        : "[SYSTEM]: Message transmitted successfully.";
      const msgError = isEs
        ? "[ERROR]: Fallo en la transmisión. Revisar logs."
        : "[ERROR]: Transmission failed. Check logs.";
      const msgConnectionLost = isEs
        ? "[ERROR]: Conexión perdida. Objetivo inalcanzable."
        : "[ERROR]: Connection lost. Target unreachable.";
      const btnRetry = isEs ? "Reintentar Conexión" : "Retry Connection";

      const originalBtnText = btnText.textContent;

      // Update UI to loading state
      submitBtn.disabled = true;
      btnText.textContent = msgTransmitting;
      statusMessage.classList.remove(
        "hidden",
        "text-red-500",
        "text-lofi-pop",
      );
      statusMessage.classList.add("text-gray-400");
      statusMessage.textContent = msgEstablishing;

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData,
        });

        const data = await response.json();

        if (data.success) {
          form.reset();
          btnText.textContent = originalBtnText;
          statusMessage.classList.remove("text-gray-400", "text-red-500");
          statusMessage.classList.add("text-lofi-pop");
          statusMessage.textContent = msgSuccess;
        } else {
          btnText.textContent = btnRetry;
          statusMessage.classList.remove("text-gray-400", "text-lofi-pop");
          statusMessage.classList.add("text-red-500");
          statusMessage.textContent = msgError;
        }
      } catch (error) {
        btnText.textContent = btnRetry;
        statusMessage.classList.remove("text-gray-400", "text-lofi-pop");
        statusMessage.classList.add("text-red-500");
        statusMessage.textContent = msgConnectionLost;
      } finally {
        submitBtn.disabled = false;

        // Hide success message after 5 seconds
        if (statusMessage.classList.contains("text-lofi-pop")) {
          setTimeout(() => {
            statusMessage.classList.add("hidden");
          }, 5000);
        }
      }
    });
  };

  setupContactForm();
  document.addEventListener("astro:after-swap", setupContactForm);
</script>
