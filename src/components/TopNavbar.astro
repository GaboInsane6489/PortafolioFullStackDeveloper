---
import { Icon } from "astro-icon/components";

const links = [
  { label: "HOME", href: "#hero" },
  { label: "PROJECTS", href: "#projects" },
  { label: "EXPERIENCE", href: "#experience" },
  { label: "CONTACT", href: "#contact" },
];
---

<div
  id="mobileMenu"
  class="pointer-events-none fixed inset-0 z-[150] flex flex-col items-center justify-center gap-8 bg-[#050505]/80 opacity-0 backdrop-blur-md transition-all duration-300 ease-out lg:hidden"
>
  <div
    class="absolute inset-0 bg-[linear-gradient(to_right,#808080_1px,transparent_1px),linear-gradient(to_bottom,#808080_1px,transparent_1px)] bg-[size:40px_40px] opacity-[0.03]"
  >
  </div>

  {
    links.map((link, index) => (
      <a
        href={link.href}
        style={`transition-delay: ${index * 40}ms`}
        class="mobile-link flex translate-y-4 items-center gap-4 font-sans text-3xl font-black tracking-widest text-white/70 uppercase transition-all duration-300 hover:text-amber-500 active:scale-95"
      >
        <span class="font-mono text-sm font-normal text-amber-500/50">
          0{index + 1}.
        </span>
        {link.label}
      </a>
    ))
  }

  <div
    class="mt-8 flex translate-y-4 gap-10 opacity-0 transition-all delay-200 duration-500"
    id="mobileSocials"
  >
    <a
      href="https://github.com/GaboInsane6489"
      target="_blank"
      class="text-white/40 hover:text-amber-400"
    >
      <Icon name="tabler:brand-github" size={32} />
    </a>
  </div>
</div>

<nav
  id="topNav"
  class="fixed top-0 left-0 z-[200] w-full border-b border-white/0 bg-transparent transition-all duration-300 ease-out"
>
  <div
    class="mx-auto flex max-w-[1440px] items-center justify-between px-6 py-5 lg:px-10"
    id="navContainer"
  >
    <a
      href="/"
      class="group relative z-[210] flex items-center gap-3 active:scale-95"
    >
      <div
        class="relative h-10 w-10 overflow-hidden rounded-lg border border-white/10 bg-white/5 p-[2px]"
      >
        <img
          src="/images/LogoPortafolio.webp"
          alt="Logo"
          class="h-full w-full rounded-md object-cover"
        />
      </div>
      <div class="flex flex-col leading-none">
        <span class="text-[11px] font-black tracking-[0.2em] text-white"
          >G. GONZÁLEZ</span
        >
        <span
          class="font-mono text-[7px] tracking-[0.3em] text-amber-500/60 uppercase"
          >System_Architect</span
        >
      </div>
    </a>

    <div class="hidden items-center gap-8 lg:flex">
      <div class="flex items-center gap-2 border-r border-white/5 pr-6">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="nav-link group relative px-4 py-2 font-mono text-[10px] tracking-[0.2em] text-gray-400 transition-all duration-300 hover:text-white"
            >
              <span class="uppercase">{link.label}</span>
            </a>
          ))
        }
      </div>
      <a
        href="#contact"
        class="rounded-full border border-amber-500/20 bg-amber-500/5 px-6 py-2.5 font-mono text-[9px] font-black text-amber-500 uppercase transition-all hover:bg-amber-500 hover:text-black"
      >
        Terminal_Connect
      </a>
    </div>

    <button
      id="menuBtn"
      class="group relative z-[210] flex h-11 w-11 items-center justify-center rounded-lg border border-white/10 bg-white/5 backdrop-blur-sm transition-transform active:scale-90 lg:hidden"
    >
      <div class="flex h-[10px] w-[20px] flex-col justify-between">
        <span
          id="line1"
          class="h-[2px] w-full origin-center rounded-full bg-white transition-all duration-300"
        ></span>
        <span
          id="line2"
          class="h-[2px] w-[14px] origin-center self-end rounded-full bg-white transition-all duration-300 group-hover:w-full"
        ></span>
      </div>
    </button>
  </div>
</nav>

<style>
  .nav-scrolled {
    background-color: rgba(8, 7, 6, 0.8) !important;
    backdrop-filter: blur(12px) !important;
    border-bottom-color: rgba(255, 255, 255, 0.05) !important;
  }

  /* Animación Burger */
  .menu-active #line1 {
    transform: translateY(4px) rotate(45deg);
    background-color: #f59e0b;
  }
  .menu-active #line2 {
    width: 20px;
    transform: translateY(-4px) rotate(-45deg);
    background-color: #f59e0b;
  }

  /* Visibilidad Mobile Menu */
  #mobileMenu.is-visible {
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  #mobileMenu.is-visible .mobile-link,
  #mobileMenu.is-visible #mobileSocials {
    transform: translateY(0);
    opacity: 1;
  }
</style>

<script>
  const setupNav = () => {
    const nav = document.getElementById("topNav");
    const btn = document.getElementById("menuBtn");
    const menu = document.getElementById("mobileMenu");

    // Scroll performance
    let scrollTimeout;
    window.addEventListener("scroll", () => {
      if (!scrollTimeout) {
        scrollTimeout = setTimeout(() => {
          window.scrollY > 20
            ? nav?.classList.add("nav-scrolled")
            : nav?.classList.remove("nav-scrolled");
          scrollTimeout = null;
        }, 10);
      }
    });

    const toggleMenu = () => {
      const isOpen = menu?.classList.contains("is-visible");
      menu?.classList.toggle("is-visible");
      btn?.classList.toggle("menu-active");
      document.body.style.overflow = isOpen ? "" : "hidden";
    };

    btn?.addEventListener("click", toggleMenu);

    // Close on link click
    document.querySelectorAll(".mobile-link").forEach((link) => {
      link.addEventListener("click", () => {
        if (menu?.classList.contains("is-visible")) toggleMenu();
      });
    });
  };

  setupNav();
  document.addEventListener("astro:after-swap", setupNav);
</script>
