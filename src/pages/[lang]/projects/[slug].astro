---
import { getCollection, type CollectionEntry, render } from "astro:content";
import PortfolioLayout from "../../../layouts/PortfolioLayout.astro";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project: CollectionEntry<"projects">) => {
    const [lang, slug] = project.id.split("/");
    return {
      params: { lang, slug },
      props: { project },
    };
  });
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { lang } = Astro.params;
const { Content } = await render(project);
const { title, description, badge, techStack, mainImage, images, githubUrl, liveUrl, status } = project.data;
---

<PortfolioLayout>
  <div class="relative min-h-screen pt-24 pb-24 md:pt-40 md:pb-32 selection:bg-amber-500/20">
    <div class="mx-auto max-w-7xl px-6">
      
      {/* 1. Senior UX Hero (Two Columns) */}
      <section class="mb-16 grid grid-cols-1 gap-12 lg:grid-cols-12 items-start">
        {/* Left Column: Fixed-Scale Narrative Image */}
        <div class="lg:col-span-7 reveal reveal-scale">
          <div class="group relative overflow-hidden rounded-2xl border border-white/10 bg-black shadow-2xl">
            <img 
              src={mainImage} 
              alt={title} 
              class="w-full h-auto max-h-[80vh] object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute bottom-4 left-4 font-mono text-[8px] tracking-[0.3em] text-white/30 uppercase bg-black/40 backdrop-blur-sm px-2 py-1 rounded">
              NODE_PRIMARY_RENDER // 0x{project.id.split("/")[1].slice(0, 6).toUpperCase()}
            </div>
          </div>
        </div>

        {/* Right Column: High-Prominence Identity & CTAs */}
        <div class="lg:col-span-5 space-y-4 reveal reveal-right">
          <div class="space-y-2">
            <div class="flex items-center gap-3">
              <div class="h-px w-6 bg-amber-500/40"></div>
              <span class="font-mono text-[9px] font-bold tracking-[0.4em] text-amber-500 uppercase">{status || 'DEPLOYED'}</span>
            </div>
            <h1 class="font-serif text-3xl leading-[1.2] text-white sm:text-4xl md:text-5xl">
              {title}<span class="text-amber-500/30">.</span>
            </h1>
            <p class="text-sm font-light leading-relaxed text-slate-300 italic" set:html={description} />
          </div>

          <div class="flex flex-wrap gap-3 pt-2">
            {githubUrl && (
              <a href={githubUrl} target="_blank" class="group relative flex flex-1 items-center justify-between gap-4 overflow-hidden rounded-xl border border-white/10 bg-white/5 p-5 transition-all hover:bg-white/[0.08] hover:border-white/20">
                <div class="flex items-center gap-4">
                  <Icon name="tabler:brand-github" class="h-6 w-6 text-slate-400 group-hover:text-white transition-colors" />
                  <div class="flex flex-col">
                    <span class="font-mono text-[8px] text-amber-500/60 font-bold tracking-widest uppercase mb-0.5">Repository</span>
                    <span class="font-mono text-[11px] font-bold text-white tracking-widest">SOURCE_CODE</span>
                  </div>
                </div>
                <Icon name="tabler:arrow-up-right" class="h-4 w-4 text-white/20 group-hover:text-white/60 transition-all opacity-0 group-hover:opacity-100" />
              </a>
            )}
            {liveUrl && (
              <a href={liveUrl} target="_blank" class="group relative flex flex-1 items-center justify-between gap-4 overflow-hidden rounded-xl border border-amber-500/30 bg-amber-500/10 p-5 transition-all hover:bg-amber-500/20 hover:border-amber-500/50 hover:shadow-[0_0_30px_rgba(245,158,11,0.1)]">
                <div class="flex items-center gap-4">
                  <Icon name="tabler:rocket" class="h-6 w-6 text-amber-500" />
                  <div class="flex flex-col">
                    <span class="font-mono text-[8px] text-amber-500/60 font-bold tracking-widest uppercase mb-0.5">Deployment</span>
                    <span class="font-mono text-[11px] font-bold text-amber-400 tracking-widest">LIVE_ACCESS</span>
                  </div>
                </div>
                <Icon name="tabler:arrow-up-right" class="h-4 w-4 text-amber-500/20 group-hover:text-amber-500/60 transition-all opacity-0 group-hover:opacity-100" />
              </a>
            )}
          </div>

          <div class="pt-4 border-t border-white/5">
            <h3 class="font-mono text-[8px] font-bold tracking-[0.3em] text-white/30 uppercase mb-3">ENGINEERING_STACK</h3>
            <div class="flex flex-wrap gap-2">
              {techStack.map((tech: string) => (
                <span class="rounded-lg border border-white/5 bg-white/5 px-2.5 py-1 font-mono text-[9px] font-bold text-slate-400 uppercase tracking-tight">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>
      </section>

      {/* 2. Artistic Unified Narrative (Collage + Text) */}
      <section class="mt-12 space-y-20">
        {/* Mixed Content Collage */}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
          <div class="lg:col-span-8">
            <article class="prose prose-invert prose-amber max-w-none reveal">
              <div class="font-sans text-lg leading-relaxed text-slate-300 font-light space-y-12">
                <Content />
              </div>
            </article>
          </div>

          <aside class="lg:col-span-4 sticky top-32 space-y-8 reveal reveal-right">
            {images && images.length > 0 && (
              <div class="space-y-6">
                <div class="flex items-center gap-4 border-b border-white/5 pb-4">
                  <span class="font-mono text-[8px] font-bold tracking-[0.5em] text-white/30 uppercase">ARCHIVE_NODES</span>
                </div>
                <div class="space-y-6">
                  {images.slice(0, 3).map((img: string, i: number) => (
                    <div class="group relative overflow-hidden rounded-xl border border-white/10 bg-black reveal reveal-right" style={`transition-delay: ${i * 150}ms`}>
                      <img src={img} alt={`View ${i}`} class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-110" />
                      <div class="absolute inset-0 bg-amber-500/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                    </div>
                  ))}
                </div>
              </div>
            )}
            
            <div class="pt-8">
               <a href={`/${lang}#projects`} class="group flex items-center gap-4 font-mono text-[10px] font-bold tracking-[0.4em] text-amber-500 uppercase transition-all hover:text-amber-300">
                <Icon name="tabler:arrow-left" class="h-4 w-4 transition-transform group-hover:-translate-x-1" />
                BACK_TO_CORE
              </a>
            </div>
          </aside>
        </div>

        {/* Artistic Full-Width Collage Break */}
        {images && images.length > 3 && (
          <div class="columns-1 gap-8 space-y-8 sm:columns-2 lg:columns-3 reveal">
            {images.slice(3).map((img: string, i: number) => (
              <div class="group relative overflow-hidden rounded-2xl border border-white/5 bg-black/40 break-inside-avoid shadow-xl transition-all hover:border-amber-500/30">
                <img src={img} alt={`Archive Node ${i}`} loading="lazy" class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105" />
                <div class="absolute top-4 right-4 font-mono text-[7px] text-white/20">NODE_DATA_{i + 4}</div>
              </div>
            ))}
          </div>
        )}
      </section>
    </div>
  </div>
</PortfolioLayout>

<style is:global>
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal.active {
    opacity: 1;
    transform: translateY(0);
  }
  .reveal-scale { transform: scale(0.98); }
  .reveal-scale.active { transform: scale(1); }
  .reveal-right { transform: translateX(20px); }
  .reveal-right.active { transform: translateX(0); }
</style>

<script>
  function initReveal() {
    const reveals = document.querySelectorAll(".reveal");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px" },
    );
    reveals.forEach((el) => observer.observe(el));
  }
  initReveal();
  document.addEventListener("astro:page-load", initReveal);
</script>
