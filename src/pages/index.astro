---
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
import { Icon } from "astro-icon/components";
import EmblaCarousel from "../components/EmblaCarousel.astro";

const luzInteriorImages = Array.from(
  { length: 11 },
  (_, i) => `/images/LuzInterior${i + 1}.webp`,
);

const InstalacionesGarciasImages = Array.from(
  { length: 13 },
  (_, i) => `/images/InstalacionesGarcias${i + 1}.webp`,
);

const HarryPotterHeadForumImages = Array.from(
  { length: 15 },
  (_, i) => `/images/HarryPotterHead${i + 1}.webp`,
);
---

<PortfolioLayout>
  <!-- ===================================================== -->
  <!-- HERO / PROFILE -->
  <!-- ===================================================== -->
  <section
    class="relative w-full overflow-hidden border-b border-white/5 py-12 lg:py-24"
    id="hero"
  >
    <!-- Background Grid -->
    <div class="grid-bg absolute inset-0 opacity-30"></div>

    <div class="relative mx-auto w-full max-w-[1600px] px-8 sm:px-12 lg:px-16">
      <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-12">
        <!-- Text Content -->
        <div class="space-y-12 lg:col-span-7">
          <div class="space-y-6">
            <!-- Badge -->
            <div
              class="inline-flex items-center gap-3 rounded-full border border-amber-500/20 bg-amber-500/5 px-4 py-1.5 backdrop-blur-md"
            >
              <span class="relative flex h-2 w-2">
                <span
                  class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-75"
                ></span>
                <span
                  class="relative inline-flex h-2 w-2 rounded-full bg-amber-500"
                ></span>
              </span>
              <span
                class="font-mono text-xs font-bold tracking-widest text-amber-500 uppercase"
              >
                System Status: Optimized
              </span>
            </div>

            <!-- Headline -->
            <h1
              class="font-sans text-6xl font-extrabold tracking-tight text-white sm:text-7xl xl:text-8xl"
            >
              Architecting <br />
              <span
                class="bg-gradient-to-r from-white via-white/80 to-white/40 bg-clip-text text-transparent"
              >
                Digital Systems
              </span>
            </h1>

            <p
              class="max-w-xl text-lg leading-relaxed font-light text-gray-400 md:text-xl"
            >
              I transform complex requirements into scalable, high-performance
              web ecosystems.
              <span class="font-medium text-white">Full Stack Engineer</span> with
              a strong academic foundation.
            </p>
          </div>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-6">
            <a
              href="#projects"
              class="group relative flex items-center gap-3 overflow-hidden rounded-lg bg-white px-8 py-4 text-sm font-bold tracking-wide text-black transition-all hover:bg-amber-400"
            >
              <span>View Casestudies</span>
              <Icon
                name="tabler:arrow-right"
                class="transition-transform group-hover:translate-x-1"
              />
            </a>

            <a
              href="#contact"
              class="group flex items-center gap-3 rounded-lg border border-white/10 bg-white/5 px-8 py-4 text-sm font-bold tracking-wide text-white transition-all hover:bg-white/10"
            >
              <span>Contact System</span>
            </a>
          </div>

          <!-- Tech Specs -->
          <div
            class="flex items-center gap-8 border-t border-white/5 pt-8 font-mono text-xs tracking-wider text-gray-500 uppercase"
          >
            <div>
              <span class="mb-1 block text-gray-700">Education</span>
              <span class="text-gray-300">UCAB Engineering (3rd Sem)</span>
            </div>
            <div>
              <span class="mb-1 block text-gray-700">Certification</span>
              <span class="text-amber-500">1-Year Technical Degree</span>
            </div>
            <div>
              <span class="mb-1 block text-gray-700">Core Stack</span>
              <span class="text-gray-300">Next.js · React · Supabase</span>
            </div>
          </div>
        </div>

        <!-- Visual / 3D Element Placeholder -->
        <div class="relative -mt-10 hidden lg:col-span-5 lg:block">
          <div
            class="relative z-10 rounded-2xl border border-white/10 bg-[#0A0908]/50 p-2 backdrop-blur-xl"
          >
            <div
              class="overflow-hidden rounded-xl border border-white/5 bg-[#050505] shadow-2xl"
            >
              <div
                class="flex items-center justify-between border-b border-white/5 bg-[#0F0F0F] px-4 py-3"
              >
                <div class="flex gap-2">
                  <div class="h-3 w-3 rounded-full bg-red-500/20"></div>
                  <div class="h-3 w-3 rounded-full bg-yellow-500/20"></div>
                  <div class="h-3 w-3 rounded-full bg-green-500/20"></div>
                </div>
                <div class="font-mono text-[10px] text-gray-500">
                  gabo-dev-environment
                </div>
              </div>

              <div class="group relative">
                <img
                  src="/images/FotoPerfil.webp"
                  alt="Gabo Profile"
                  class="h-auto w-full opacity-80 mix-blend-luminosity grayscale transition-all duration-700 group-hover:opacity-100 group-hover:grayscale-0"
                />

                <!-- Overlay Code -->
                <div
                  class="absolute inset-0 bg-gradient-to-t from-[#050505] via-transparent to-transparent"
                >
                </div>

                <div
                  class="absolute right-4 bottom-4 left-4 font-mono text-xs text-amber-500/80"
                >
                  <div class="typing-effect space-y-1">
                    <p>> Initializing core systems...</p>
                    <p>> Loading architecture modules...</p>
                    <p class="text-green-500">> System Ready.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Decorative Elements -->
          <div
            class="absolute -top-12 -right-12 h-64 w-64 rounded-full bg-amber-500/5 blur-[100px]"
          >
          </div>
          <div
            class="absolute -bottom-12 -left-12 h-64 w-64 rounded-full bg-blue-500/5 blur-[100px]"
          >
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    @keyframes bounce-slow {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-10px);
      }
    }
    .animate-bounce-slow {
      animation: bounce-slow 4s ease-in-out infinite;
    }
  </style>

  <!-- ===================================================== -->
  <!-- ABOUT ME -->
  <!-- ===================================================== -->
  <!-- ===================================================== -->
  <!-- ABOUT ME -->
  <!-- ===================================================== -->
  <section
    class="relative border-t border-white/5 py-32 lg:py-48"
    id="about-me"
  >
    <div
      class="absolute inset-0 [background-image:radial-gradient(rgba(252,211,77,0.05)_1px,transparent_1px)] [mask-image:linear-gradient(180deg,white,transparent)] [background-size:32px_32px] opacity-40"
    >
    </div>

    <div class="relative mx-auto w-full max-w-[1100px] px-8 sm:px-12 lg:px-16">
      <div class="grid grid-cols-1 gap-20 lg:grid-cols-12">
        <div class="space-y-12 lg:col-span-7">
          <div class="space-y-6">
            <div class="flex items-center gap-4">
              <div class="h-px w-12 bg-amber-300/60"></div>
              <span
                class="text-[10px] font-bold tracking-[0.6em] text-amber-300/80 uppercase"
                >Professional Summary</span
              >
            </div>

            <h2
              class="font-serif text-5xl leading-tight tracking-tighter text-white md:text-7xl"
            >
              Engineering with structure,
              <br />
              <span class="font-light text-white/40 italic"
                >not improvisation.</span
              >
            </h2>
          </div>

          <div class="space-y-6 text-lg leading-relaxed text-gray-400">
            <p>
              I am a <span class="font-medium text-white"
                >Full Stack Developer</span
              > focused on building modern, maintainable, and performance-oriented
              web applications. I bridge the gap between complex backend logic and
              intuitive frontend experiences.
            </p>
            <p>
              Through my work on projects like <span
                class="font-medium text-amber-200/90">Instalaciones García</span
              > and the <span class="font-medium text-amber-200/90"
                >Harry Potter Forum</span
              >, I've mastered the art of shipping features in production
              environments.
            </p>
          </div>

          <div class="flex flex-wrap gap-3 pt-4">
            {
              [
                "Code Reviews",
                "PR Strategies",
                "CI/CD",
                "Clean Architecture",
              ].map((tag) => (
                <span class="rounded-full border border-white/10 bg-[#4D4543]/40 px-4 py-1 text-[11px] font-bold tracking-widest text-amber-200/60 uppercase backdrop-blur-sm">
                  {tag}
                </span>
              ))
            }
          </div>
        </div>

        <div class="flex flex-col justify-end space-y-8 lg:col-span-5 lg:pb-4">
          <div class="space-y-4 border-l border-amber-900/30 pl-8">
            {
              [
                { label: "Location", value: "Caracas, Venezuela" },
                { label: "Philosophy", value: "Scalable & Organized Scale" },
                { label: "Availability", value: "Open to Remote / Global" },
              ].map((item) => (
                <div class="group">
                  <p class="text-[10px] font-black tracking-widest text-amber-600/60 uppercase">
                    {item.label}
                  </p>
                  <p class="text-lg text-white/70 italic transition-colors group-hover:text-amber-300">
                    {item.value}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="group relative mt-24">
        <div
          class="absolute -inset-4 -z-10 rounded-[3rem] bg-gradient-to-b from-[#4D4543]/20 to-transparent opacity-0 blur-3xl transition-opacity duration-700 group-hover:opacity-100"
        >
        </div>

        <div
          class="overflow-hidden rounded-xl border border-[#4D4543] bg-[#2C2421] shadow-[0_20px_50px_rgba(0,0,0,0.5)]"
        >
          <div class="flex h-10 items-center justify-between bg-[#241C19] px-4">
            <div class="flex items-center gap-5">
              <div class="flex gap-1.5">
                <div class="h-3 w-3 rounded-full bg-[#ef9f76]/50"></div>
                <div class="h-3 w-3 rounded-full bg-[#e5c890]/50"></div>
                <div class="h-3 w-3 rounded-full bg-[#a6d189]/50"></div>
              </div>
              <div
                class="flex h-10 items-center gap-1 border-t border-t-[#ef9f76] bg-[#2C2421] px-4 py-2"
              >
                <Icon
                  name="tabler:brand-typescript"
                  size={14}
                  class="text-[#8caaee]"
                />
                <span class="font-mono text-[11px] text-[#c6d0f5]"
                  >AboutMe.tsx</span
                >
              </div>
            </div>
            <span
              class="hidden font-mono text-[10px] tracking-tight text-white/20 sm:block"
            >
              GaboDev — Visual Studio Code
            </span>
            <div class="flex gap-3 text-white/30">
              <Icon name="tabler:layout-sidebar-left-collapse" size={16} />
              <Icon name="tabler:layout-bottombar-collapse" size={16} />
            </div>
          </div>

          <div class="relative">
            <div
              class="absolute top-0 bottom-0 left-0 flex w-12 flex-col items-center space-y-1 bg-[#241C19]/50 pt-4 font-mono text-[10px] text-white/10 select-none"
            >
              {Array.from({ length: 12 }).map((_, i) => <span>{i + 104}</span>)}
            </div>

            <video
              src="/videos/Programando.mp4"
              class="w-full object-cover pl-12 transition-all duration-700 group-hover:brightness-110"
              autoplay
              loop
              muted></video>

            <div
              class="pointer-events-none absolute inset-0 border-t border-white/5"
            >
            </div>
          </div>
        </div>

        <div
          class="absolute -right-6 -bottom-6 hidden rounded-xl border border-[#4D4543] bg-[#2C2421]/95 p-6 shadow-2xl backdrop-blur-xl lg:block"
        >
          <p class="font-serif text-xl text-[#eebebe] italic">
            "Writing code is easy.<br />Building systems is the craft."
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================== -->
  <!-- FEATURED PROJECT -->
  <!-- ===================================================== -->
  <!-- ===================================================== -->
  <!-- SELECTED WORK / PROJECTS (BENTO GRID) -->
  <!-- ===================================================== -->
  <section
    id="projects"
    class="relative border-b border-white/5 py-32 lg:py-48"
  >
    <div class="relative mx-auto w-full max-w-[1600px] px-8 sm:px-12 lg:px-16">
      <!-- Section Header -->
      <div
        class="mb-24 flex flex-col justify-between gap-8 md:flex-row md:items-end"
      >
        <div class="space-y-6">
          <div class="flex items-center gap-4">
            <span class="flex h-px w-12 bg-amber-500/50"></span>
            <span
              class="font-mono text-xs font-bold tracking-widest text-amber-500 uppercase"
            >
              Selected Works
            </span>
          </div>
          <h2 class="font-serif text-5xl leading-none text-white md:text-7xl">
            Digital <span
              class="bg-gradient-to-r from-gray-100 to-gray-500 bg-clip-text text-transparent"
              >Case Studies</span
            >
          </h2>
        </div>
        <p
          class="hidden max-w-md text-right text-lg font-light text-gray-400 md:block"
        >
          A curation of production-grade systems, focusing on architecture,
          performance, and user experience.
        </p>
      </div>

      <!-- Single Column Stack -->
      <div class="flex flex-col gap-32">
        <!-- PROJECT 1: MARTÍ ACADEMY OS (Star Project) -->
        <article class="group relative grid grid-cols-1 gap-12 lg:grid-cols-12">
          <!-- Content -->
          <div
            class="order-2 flex flex-col justify-center space-y-8 lg:order-1 lg:col-span-6"
          >
            <div class="flex items-center gap-4 text-amber-500">
              <Icon name="tabler:school" size={28} />
              <span
                class="font-mono text-xs font-bold tracking-widest uppercase"
                >EdTech Operating System</span
              >
            </div>

            <h3 class="font-serif text-4xl text-white lg:text-6xl">
              Martí Academy OS
            </h3>

            <p class="text-lg leading-relaxed text-gray-400">
              A comprehensive educational operating system converting a
              traditional institution into a digital ecosystem. Features <strong
                class="text-white">Smart Attendance</strong
              > with avatar grids, a complex <strong class="text-white"
                >Gamification Engine</strong
              > (XP, Streaks, Badges), and Role-Based Access Control (RBAC).
            </p>

            <div
              class="space-y-4 rounded-xl border border-white/5 bg-white/5 p-6"
            >
              <div class="flex items-center gap-3 text-sm text-gray-300">
                <Icon name="tabler:database" class="text-blue-400" />
                <span>Supabase (Auth, DB, Realtime)</span>
              </div>
              <div class="flex items-center gap-3 text-sm text-gray-300">
                <Icon name="tabler:brand-nextjs" class="text-white" />
                <span>Next.js 16 (Turbopack)</span>
              </div>
              <div class="flex items-center gap-3 text-sm text-gray-300">
                <Icon name="tabler:shield-lock" class="text-green-400" />
                <span>RBAC Middleware & RLS</span>
              </div>
            </div>

            <div class="flex items-center gap-6 pt-6">
              <a
                href="https://github.com/GaboInsane6489/Marti-Academy-OS"
                target="_blank"
                class="flex items-center gap-2 border-b border-amber-500 pb-1 font-mono text-xs font-bold tracking-widest text-amber-500 transition-all hover:text-amber-400"
              >
                SOURCE CODE
                <Icon name="tabler:arrow-up-right" />
              </a>
              <span
                class="flex items-center gap-2 font-mono text-xs text-gray-500"
              >
                <span class="h-2 w-2 animate-pulse rounded-full bg-green-500"
                ></span>
                V 1.0.0 STABLE
              </span>
            </div>
          </div>

          <!-- Visual (Placeholder using Code Block look for now as no images) -->
          <div
            class="relative order-1 min-h-[400px] overflow-hidden rounded-2xl border border-white/10 bg-[#0A0908] lg:order-2 lg:col-span-6"
          >
            <!-- Decorative Elements -->
            <div
              class="absolute -top-20 -right-20 h-64 w-64 rounded-full bg-blue-500/20 blur-[100px]"
            >
            </div>

            <div class="relative h-full w-full p-8 md:p-12">
              <div
                class="flex h-full w-full flex-col overflow-hidden rounded-xl border border-white/5 bg-[#050505] shadow-2xl"
              >
                <!-- Pseudo Browser Header -->
                <div
                  class="flex items-center gap-2 border-b border-white/5 bg-white/5 px-4 py-3"
                >
                  <div class="h-3 w-3 rounded-full bg-red-500/50"></div>
                  <div class="h-3 w-3 rounded-full bg-yellow-500/50"></div>
                  <div class="h-3 w-3 rounded-full bg-green-500/50"></div>
                  <div class="ml-4 h-2 w-32 rounded-full bg-white/10"></div>
                </div>
                <!-- Pseudo Dashboard Content -->
                <div class="relative flex-1 p-6">
                  <div class="mb-6 grid grid-cols-2 gap-4">
                    <div
                      class="h-24 rounded-lg border border-blue-500/20 bg-blue-500/10"
                    >
                    </div>
                    <div
                      class="h-24 rounded-lg border border-green-500/20 bg-green-500/10"
                    >
                    </div>
                  </div>
                  <div
                    class="mb-4 h-32 rounded-lg border border-white/5 bg-white/5"
                  >
                  </div>
                  <div class="space-y-2">
                    <div class="h-2 w-3/4 rounded bg-white/10"></div>
                    <div class="h-2 w-1/2 rounded bg-white/10"></div>
                  </div>

                  <!-- Overlay Text -->
                  <div
                    class="absolute inset-0 flex items-center justify-center bg-black/50 backdrop-blur-[2px]"
                  >
                    <span
                      class="rounded border border-white/20 bg-black/80 px-6 py-3 font-mono text-xl font-bold tracking-widest text-white"
                    >
                      SYSTEM PREVIEW
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </article>

        <!-- PROJECT 2: LUZ INTERIOR -->
        <article class="group relative grid grid-cols-1 gap-12 lg:grid-cols-12">
          <!-- Visual -->
          <div
            class="relative min-h-[400px] overflow-hidden rounded-2xl border border-white/10 bg-[#0A0908] lg:col-span-7"
          >
            <div
              class="pointer-events-none absolute inset-0 z-10 bg-gradient-to-tr from-purple-500/10 to-transparent"
            >
            </div>
            <div
              class="h-full w-full transform transition-transform duration-700 group-hover:scale-[1.02]"
            >
              <EmblaCarousel images={luzInteriorImages} />
            </div>
          </div>

          <!-- Content -->
          <div class="flex flex-col justify-center space-y-8 lg:col-span-5">
            <div class="flex items-center gap-4 text-purple-400">
              <Icon name="tabler:bulb" size={28} />
              <span
                class="font-mono text-xs font-bold tracking-widest uppercase"
                >Personal Growth Platform</span
              >
            </div>

            <h3 class="font-serif text-3xl text-white lg:text-5xl">
              Mi Luz Interior
            </h3>

            <p class="text-lg leading-relaxed text-gray-400">
              An "Operating System" for personal reconstruction. Gamified growth
              tracking with
              <strong class="text-white">Atomic Design</strong> principles. Features
              structure logging, visible progress metrics, and a disciplined community
              architecture.
            </p>

            <div class="flex flex-wrap gap-2">
              {
                ["React 19", "Vite", "Supabase", "Row Level Security"].map(
                  (tech) => (
                    <span class="rounded border border-white/10 bg-white/5 px-3 py-1 font-mono text-xs text-gray-300">
                      {tech}
                    </span>
                  ),
                )
              }
            </div>

            <a
              href="https://github.com/GaboInsane6489/LuzInterior"
              target="_blank"
              class="inline-flex items-center gap-2 pt-4 font-mono text-xs font-bold tracking-widest text-white transition-all hover:text-purple-400"
            >
              VIEW REPOSITORY <Icon name="tabler:arrow-right" />
            </a>
          </div>
        </article>

        <!-- PROJECT 3: INSTALACIONES GARCÍA -->
        <article class="group relative grid grid-cols-1 gap-12 lg:grid-cols-12">
          <!-- Content -->
          <div
            class="order-2 flex flex-col justify-center space-y-8 lg:order-1 lg:col-span-5"
          >
            <div class="flex items-center gap-4 text-emerald-500">
              <Icon name="tabler:building-factory-2" size={28} />
              <span
                class="font-mono text-xs font-bold tracking-widest uppercase"
                >Enterprise Landing</span
              >
            </div>

            <h3 class="font-serif text-3xl text-white lg:text-5xl">
              Instalaciones García
            </h3>

            <p class="text-lg leading-relaxed text-gray-400">
              Digital presence for an infrastructure service provider.
              Implements
              <strong class="text-white">service tracking</strong> workflows and client
              resource optimization.
            </p>

            <div class="flex flex-wrap gap-2">
              {
                ["JavaScript", "HTML/CSS", "Google Maps API"].map((tech) => (
                  <span class="rounded border border-white/10 bg-white/5 px-3 py-1 font-mono text-xs text-gray-300">
                    {tech}
                  </span>
                ))
              }
            </div>

            <a
              href="https://github.com/GaboInsane6489/instalacionesgarciasfronted"
              target="_blank"
              class="inline-flex items-center gap-2 pt-4 font-mono text-xs font-bold tracking-widest text-white transition-all hover:text-emerald-400"
            >
              VIEW REPOSITORY <Icon name="tabler:arrow-right" />
            </a>
          </div>

          <!-- Visual -->
          <div
            class="relative order-1 min-h-[400px] overflow-hidden rounded-2xl border border-white/10 bg-[#0A0908] lg:order-2 lg:col-span-7"
          >
            <div
              class="pointer-events-none absolute inset-0 z-10 bg-gradient-to-bl from-emerald-500/10 to-transparent"
            >
            </div>
            <div
              class="h-full w-full transform transition-transform duration-700 group-hover:scale-[1.02]"
            >
              <EmblaCarousel images={InstalacionesGarciasImages} />
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ===================================================== -->
  <!-- ENGINEERING / OPEN SOURCE / STACK / FOUNDATION -->
  <!-- ===================================================== -->

  <!-- ================= ENGINEERING & OPEN SOURCE ================= -->
  <!-- ===================================================== -->
  <!-- PROFESSIONAL TIMELINE (EXPERIENCE & EDUCATION) -->
  <!-- ===================================================== -->
  <section
    id="experience"
    class="relative border-b border-white/5 py-32 lg:py-48"
  >
    <div class="relative mx-auto w-full max-w-[1600px] px-8 sm:px-12 lg:px-16">
      <div class="grid grid-cols-1 gap-16 lg:grid-cols-12">
        <div class="space-y-8 lg:col-span-4">
          <div class="flex items-center gap-4">
            <span class="flex h-px w-12 bg-amber-500/50"></span>
            <span
              class="font-mono text-xs font-bold tracking-widest text-amber-500 uppercase"
            >
              Career Path
            </span>
          </div>
          <h2 class="font-serif text-5xl text-white">
            Professional <br /> Timeline
          </h2>
          <p class="leading-relaxed font-light text-gray-400">
            A chronological log of my development journey, from academic
            foundation to leading production-grade systems.
          </p>
        </div>

        <div
          class="relative ml-4 space-y-12 border-l border-white/10 pl-8 lg:col-span-8 lg:ml-0 lg:pl-12"
        >
          <!-- Item 1: Lead Engineer -->
          <div class="group relative">
            <div
