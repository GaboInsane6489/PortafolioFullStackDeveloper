---
import TopNavbar from "../components/TopNavbar.astro";
import SideNavbar from "../components/SideNavbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/index.css";
import "flowbite";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/webp" href="/images/LogoPortafolio.webp" />
    <title>Gabriel González | Full Stack Developer</title>
  </head>

  <body class="min-h-screen overflow-x-hidden bg-black text-white">
    <!-- 🎥 Video Background -->
    <div class="pointer-events-none fixed inset-0 -z-20">
      <video
        class="h-full w-full object-cover"
        src="/videos/Train-Station-Rainy-Day.mp4"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"></video>
      <div class="absolute inset-0 bg-black/60"></div>
    </div>

    <!-- Top Navbar -->
    <TopNavbar />

    <!-- Layout principal -->
    <div
      class="relative z-10 grid min-h-screen grid-cols-1 md:grid-cols-[96px_1fr]"
    >
      <!-- Side Navbar -->
      <aside class="hidden md:flex">
        <SideNavbar />
      </aside>

      <!-- Columna de contenido -->
      <div class="flex min-h-[calc(100vh-6rem)] flex-col">
        <main class="flex-1">
          <slot />
        </main>

        <footer class="border-t border-white/10 bg-black/80 backdrop-blur">
          <Footer />
        </footer>
      </div>
    </div>
  </body>
</html>
