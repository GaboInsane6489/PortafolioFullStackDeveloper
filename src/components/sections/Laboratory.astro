---
import { Icon } from "astro-icon/components";
---

<section id="laboratory" class="py-32 lg:py-48">
  <div
    class="relative mx-auto w-[90%] overflow-hidden rounded-3xl border border-emerald-500/20 bg-[#0A0908] shadow-2xl shadow-emerald-900/20 lg:w-[80%]"
  >
    <!-- Background Video -->
    <video
      class="absolute inset-0 h-full w-full object-cover opacity-60"
      src="/videos/Hacker-Room-Rainy-Night.mp4"
      autoplay
      muted
      loop
      playsinline></video>

    <!-- Gradient Overlay for text readability (Light) -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/60 to-transparent"
    >
    </div>

    <!-- Grid Overlay -->
    <div
      class="absolute inset-0 bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-10"
    >
    </div>

    <div class="relative z-10 px-8 py-20 sm:px-12 lg:px-16">
      <div class="mb-20">
        <div class="mb-6 flex items-center gap-4">
          <span class="flex h-px w-12 bg-emerald-500/50"></span>
          <span
            class="font-mono text-xs font-bold tracking-widest text-emerald-500 uppercase"
          >
            R&D Facility
          </span>
        </div>
        <h2 class="font-serif text-5xl text-white md:text-7xl">
          The <span class="text-emerald-500">Laboratory</span>
        </h2>
        <p class="mt-6 max-w-xl text-lg font-light text-gray-300">
          My digital sanctuary. Where deep work happens and experimental systems
          are forged.
        </p>
      </div>

      <div class="grid grid-cols-1 items-end gap-12 lg:grid-cols-2">
        <!-- CARD 1: THE MACHINE (SYSTEM SPECS) -->
        <div
          class="relative overflow-hidden rounded-2xl border border-emerald-500/30 bg-black/60 p-8 backdrop-blur-xl"
        >
          <div class="absolute top-0 right-0 p-4 opacity-50">
            <Icon name="tabler:cpu" class="h-12 w-12 text-emerald-500" />
          </div>
          <h3
            class="mb-6 font-mono text-sm font-bold tracking-widest text-emerald-500 uppercase"
          >
            // WORKSTATION_CORE
          </h3>

          <div class="space-y-4 font-mono text-xs md:text-sm">
            <div class="flex justify-between border-b border-white/10 pb-2">
              <span class="text-gray-400">CPU_UNIT</span>
              <span class="text-emerald-100">AMD Ryzen 9 7950X</span>
            </div>
            <div class="flex justify-between border-b border-white/10 pb-2">
              <span class="text-gray-400">MEMORY_ALLOC</span>
              <span class="text-emerald-100">16GB DDR3 2400MHz</span>
            </div>
            <div class="flex justify-between border-b border-white/10 pb-2">
              <span class="text-gray-400">GPU_ACCEL</span>
              <span class="text-emerald-100">NVIDIA RTX 4090 24GB</span>
            </div>
            <div class="flex justify-between border-b border-white/10 pb-2">
              <span class="text-gray-400">STORAGE_VOL</span>
              <span class="text-emerald-100">4TB NVMe Gen5 array</span>
            </div>
            <div class="flex justify-between pt-2">
              <span class="text-gray-400">OS_KERNEL</span>
              <span class="text-emerald-100">Arch Linux (Hyprland)</span>
            </div>
          </div>

          <div class="mt-8 flex gap-2">
            <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-500"
            ></span>
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500/50"></span>
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500/20"></span>
          </div>
        </div>

        <!-- CARD 2: CURRENT R&D (LEARNING) -->
        <div class="space-y-6">
          <!-- HEADER -->
          <div
            class="flex items-end justify-between border-b border-white/10 pb-4"
          >
            <div>
              <h3 class="font-serif text-2xl text-white">Active Research</h3>
              <p class="mt-1 font-mono text-xs text-gray-400">
                CURRENTLY COMPILING...
              </p>
            </div>
            <div class="text-right">
              <span class="block text-3xl font-bold text-emerald-500">84%</span>
              <span class="text-[10px] tracking-widest text-gray-400 uppercase"
                >Capacity Load</span
              >
            </div>
          </div>

          <!-- PROGRESS BARS -->
          <div class="space-y-6">
            <div>
              <div class="mb-2 flex justify-between font-mono text-xs">
                <span class="text-white">AI Agents & LLM Orchestration</span>
                <span class="text-emerald-400">Running...</span>
              </div>
              <div
                class="h-1.5 w-full overflow-hidden rounded-full bg-white/10"
              >
                <div
                  class="h-full w-[75%] bg-emerald-500 shadow-[0_0_10px_rgba(16,185,129,0.5)]"
                >
                </div>
              </div>
            </div>

            <div>
              <div class="mb-2 flex justify-between font-mono text-xs">
                <span class="text-white">Rust / Systems Programming</span>
                <span class="text-amber-400">Compiling</span>
              </div>
              <div
                class="h-1.5 w-full overflow-hidden rounded-full bg-white/10"
              >
                <div class="h-full w-[45%] bg-amber-500"></div>
              </div>
            </div>

            <div>
              <div class="mb-2 flex justify-between font-mono text-xs">
                <span class="text-white">WebGL / Three.js Shaders</span>
                <span class="text-blue-400">Rendering</span>
              </div>
              <div
                class="h-1.5 w-full overflow-hidden rounded-full bg-white/10"
              >
                <div class="h-full w-[30%] bg-blue-500"></div>
              </div>
            </div>
          </div>

          <!-- ENV INFO -->
          <div class="grid grid-cols-2 gap-4 pt-4">
            <div
              class="rounded border border-emerald-500/10 bg-black/40 p-3 backdrop-blur-sm"
            >
              <div
                class="mb-1 text-[10px] tracking-wider text-gray-400 uppercase"
              >
                Editor
              </div>
              <div class="font-mono text-sm text-white">
                VS Code <span class="text-gray-500">/ NeoVim</span>
              </div>
            </div>
            <div
              class="rounded border border-emerald-500/10 bg-black/40 p-3 backdrop-blur-sm"
            >
              <div
                class="mb-1 text-[10px] tracking-wider text-gray-400 uppercase"
              >
                Theme
              </div>
              <div class="font-mono text-sm text-white">Tokyo Night</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
