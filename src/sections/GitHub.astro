---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="engineering"
  class="relative overflow-hidden border-t border-white/5 py-10 lg:py-18"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(165,166,246,0.03),transparent_70%)]"
  >
  </div>

  <div class="relative mx-auto w-full max-w-[1300px] px-6 sm:px-12 lg:px-20">
    <div
      class="mb-8 flex flex-col items-start justify-between gap-4 lg:flex-row lg:items-end"
    >
      <div class="space-y-4">
        <div class="reveal flex items-center gap-3">
          <span class="h-px w-8 bg-lofi-accent/50"></span>
          <span
            class="text-[10px] font-bold tracking-[0.4em] text-lofi-accent uppercase"
            >{t("eng.badge")}</span
          >
        </div>
        <h2
          class="reveal font-serif text-3xl leading-none text-white md:text-5xl"
        >
          {t("eng.title1")}
          <span class="font-light text-white/40 italic">{t("eng.title2")}</span>
        </h2>
      </div>
      <p class="reveal max-w-md text-sm font-bold leading-relaxed text-slate-300">
        {t("eng.description")}
      </p>
    </div>

    <div class="grid gap-4 lg:grid-cols-12 lg:grid-rows-2">
      <div
        class="reveal reveal-scale group relative col-span-12 row-span-2 min-h-[250px] overflow-hidden rounded-3xl border border-white/10 bg-black/40 lg:col-span-8"
      >
        <video
          id="engineering-video"
          src="/videos/Programando2.mp4"
          class="h-full w-full object-cover opacity-100 transition-transform duration-700 group-hover:scale-[1.02]"
          autoplay
          loop
          muted
          playsinline></video>

        <div
          class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"
        >
        </div>
        <div class="absolute bottom-6 left-6 flex items-center gap-4">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-full border border-lofi-pop/30 bg-black/60 backdrop-blur-md"
          >
            <Icon
              name="tabler:device-analytics"
              class="animate-pulse text-lofi-pop"
              size={20}
            />
          </div>
          <div>
            <p
              class="font-mono text-[10px] tracking-[0.2em] text-lofi-pop uppercase"
            >
              {t("eng.active.badge")}
            </p>
            <p class="text-sm font-medium text-white/90">
              {t("eng.active.title")}
            </p>
          </div>
        </div>
      </div>

      <article
        class="reveal reveal-left group relative col-span-12 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] lg:col-span-4"
      >
        <!-- Scanner Overlay -->
        <div class="absolute inset-0 z-10 pointer-events-none opacity-0 group-hover:opacity-10 transition-opacity duration-500">
           <div class="absolute inset-0 bg-[linear-gradient(transparent_0%,rgba(250,145,207,0.5)_50%,transparent_100%)] bg-[length:100%_200%] animate-scan"></div>
        </div>
        
        <img
          src="/images/GitHub1.webp"
          alt="GitHub Overview"
          class="h-full w-full object-cover object-top opacity-80 transition-all duration-500 group-hover:scale-110 group-hover:opacity-100"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-[#0A0908] via-transparent to-transparent opacity-80"
        >
        </div>
        <div class="absolute inset-x-0 bottom-0 flex flex-col justify-between p-6 z-20">
          <Icon name="tabler:brand-github" class="text-lofi-accent mb-2 drop-shadow-[0_0_8px_rgba(165,166,246,0.5)]" size={28} />
          <span
            class="w-fit rounded border border-lofi-accent/30 bg-black/60 p-1 px-2 font-mono text-[10px] font-black tracking-widest text-lofi-accent uppercase backdrop-blur-sm"
            >{t("eng.identity")}</span
          >
        </div>
      </article>

      <article
        class="reveal reveal-left group relative col-span-12 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] delay-100 lg:col-span-4"
      >
        <!-- Scanner Overlay -->
        <div class="absolute inset-0 z-10 pointer-events-none opacity-0 group-hover:opacity-10 transition-opacity duration-500">
           <div class="absolute inset-0 bg-[linear-gradient(transparent_0%,rgba(250,145,207,0.5)_50%,transparent_100%)] bg-[length:100%_200%] animate-scan"></div>
        </div>

        <img
          src="/images/GitHub4.webp"
          alt="Commit Activity"
          class="h-full w-full object-cover opacity-80 transition-all duration-500 group-hover:scale-105 group-hover:opacity-100"
        />
        <div
          class="absolute inset-x-0 bottom-0 z-20 border-t border-lofi-accent/40 bg-lofi-accent/20 p-3 backdrop-blur-md"
        >
          <p
            class="font-mono text-[9px] font-black tracking-tighter text-lofi-accent uppercase"
          >
            {t("eng.cycle")}
          </p>
        </div>
      </article>

      <div class="col-span-12 mt-2 grid gap-4 sm:grid-cols-3">
        {
          [
            {
              title: "Code Quality",
              icon: "tabler:square-rounded-check",
              img: "/images/GitHub3.webp",
            },
            {
              title: "Docs Standards",
              icon: "tabler:copy-check",
              img: "/images/GitHub5.webp",
            },
            {
              title: "System Thinking",
              icon: "tabler:hierarchy-2",
              img: "/images/GitHub2.webp",
            },
          ].map((item, i) => (
            <div
              class={`reveal delay-[${(i + 3) * 100}ms] group relative aspect-[2/1] overflow-hidden rounded-xl border border-white/15 bg-white/[0.05] shadow-lg`}
            >
              <!-- Scanner Overlay -->
              <div class="absolute inset-0 z-10 pointer-events-none opacity-0 group-hover:opacity-5 transition-opacity duration-500">
                <div class="absolute inset-0 bg-[linear-gradient(transparent_0%,rgba(250,145,207,0.5)_50%,transparent_100%)] bg-[length:100%_200%] animate-scan"></div>
              </div>

              <img
                src={item.img}
                alt={item.title}
                class="h-full w-full object-cover opacity-70 transition-all duration-700 group-hover:scale-110 group-hover:opacity-100"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent z-10" />
              <div class="absolute bottom-3 left-3 z-20 flex items-center gap-2">
                <Icon name={item.icon} size={14} class="text-lofi-accent drop-shadow-[0_0_5px_rgba(165,166,246,0.5)]" />
                <span class="text-[9px] font-black tracking-[0.2em] text-white uppercase transition-colors group-hover:text-lofi-soft">
                  {item.title}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

</style>

<script>
  const setupEngineeringVideo = () => {
    const video = document.getElementById('engineering-video') as HTMLVideoElement;
    if (!video) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    }, { threshold: 0.1 });

    observer.observe(video);
  };

  setupEngineeringVideo();
  document.addEventListener('astro:after-swap', setupEngineeringVideo);
</script>
