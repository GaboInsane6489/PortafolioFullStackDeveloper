---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  class="relative flex min-h-[100dvh] w-full flex-col justify-start overflow-hidden border-b border-white/5 pt-12 pb-12 md:justify-start md:pt-16 lg:justify-center lg:pt-0 lg:pb-12"
  id="hero"
>
  <!-- --- REFINED BACKGROUND: Isometric Grid + Main Grid --- -->
  <div class="pointer-events-none absolute inset-0 z-0">
    <div class="grid-bg absolute inset-0 opacity-15 md:opacity-20"></div>
    <!-- Isometric Perspective Grid (Depth) -->
    <div
      class="isometric-grid absolute inset-x-0 bottom-0 h-1/2 opacity-[0.04]"
    >
    </div>
  </div>

  <div
    class="relative z-10 mx-auto w-full max-w-[1200px] px-6 sm:px-12 lg:px-16"
  >
    <div
      class="grid grid-cols-1 items-center gap-12 md:grid-cols-12 md:gap-8 lg:gap-20"
    >
      <!-- AVATAR MOD (Sync & Rescale) -->
      <div
        class="reveal reveal-right relative order-first col-span-1 flex justify-center md:order-last md:col-span-5"
      >
        <!-- Floating Tech Nodes (Downsized) -->
        <div
          class="animate-float-slow absolute -top-4 -left-4 z-20 hidden sm:block"
        >
          <div
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-lofi-accent/30 bg-black/60 shadow-[0_0_15px_rgba(165,166,246,0.1)] backdrop-blur-md"
          >
            <Icon
              name="tabler:brand-react"
              size={16}
              class="text-lofi-accent"
            />
          </div>
        </div>
        <div
          class="animate-float-medium absolute -right-6 bottom-12 z-20 hidden sm:block delay-200"
        >
          <div
            class="flex h-10 w-10 items-center justify-center rounded-lg border border-lofi-pop/30 bg-black/60 shadow-[0_0_15px_rgba(139,92,246,0.1)] backdrop-blur-md"
          >
            <Icon name="tabler:brand-nodejs" size={20} class="text-white" />
          </div>
        </div>
        <div
          class="animate-float-fast absolute -bottom-2 left-12 z-20 hidden sm:block delay-300"
        >
          <div
            class="flex h-7 w-7 items-center justify-center rounded-lg border border-white/20 bg-black/60 shadow-[0_0_10px_rgba(255,255,255,0.05)] backdrop-blur-md"
          >
            <Icon name="tabler:brand-astro" size={14} class="text-white" />
          </div>
        </div>

        <div
          id="hero-avatar-container"
          class="group relative z-10 w-full max-w-[170px] cursor-pointer rounded-2xl border border-white/20 bg-lofi-base/40 p-1.5 backdrop-blur-md transition-all duration-300 hover:scale-[1.03] active:scale-[0.98] sm:max-w-[220px] md:max-w-[240px] lg:max-w-[260px]"
        >
          <!-- Corner Markers (Subtle) -->
          <div
            class="absolute -top-1 -left-1 h-2 w-2 border-t border-l border-lofi-accent/40"
          >
          </div>
          <div
            class="absolute -top-1 -right-1 h-2 w-2 border-t border-r border-white/10"
          >
          </div>
          <div
            class="absolute -bottom-1 -left-1 h-2 w-2 border-b border-l border-white/10"
          >
          </div>
          <div
            class="absolute -right-1 -bottom-1 h-2 w-2 border-r border-b border-lofi-accent/40"
          >
          </div>

          <div
            class="overflow-hidden rounded-xl border border-white/5 bg-[#050505] shadow-xl"
          >
            <div
              class="flex items-center justify-between border-b border-white/10 bg-[#0F0F0F] px-4 py-2"
            >
              <div class="flex gap-1">
                <div
                  class="h-1 w-1 rounded-full bg-red-500/60"
                >
                </div>
                <div class="h-1 w-1 rounded-full bg-yellow-500/20"></div>
                <div class="h-1 w-1 rounded-full bg-green-500/20"></div>
              </div>
              <div
                class="font-mono text-[8px] font-black tracking-[0.2em] text-white/30 uppercase"
              >
                ENV_PROD
              </div>
            </div>

            <div class="relative aspect-[4/5] overflow-hidden bg-[#0A0A0A]">
              <!-- Scanning Line FX -->
              <div
                class="animate-scanline absolute inset-x-0 z-30 h-1/2 w-full bg-gradient-to-b from-transparent via-lofi-accent/5 to-transparent opacity-30"
              >
              </div>

              <img
                src="/images/PerfilProgramador.webp"
                alt="Gabriel Gonzalez Profile"
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="eager"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-[#050505] via-transparent to-transparent opacity-50"
              >
              </div>

              <!-- HUD Metadata Overlay (Micro) -->
              <div
                class="absolute top-2.5 right-2.5 flex flex-col items-end gap-0.5 opacity-40"
              >
                <span
                  class="font-mono text-[5px] tracking-widest text-white/50 uppercase"
                  >LAT_10.48</span
                >
                <span
                  class="font-mono text-[5px] tracking-widest text-white/50 uppercase"
                  >LON_66.90</span
                >
              </div>

              <div
                class="absolute bottom-2.5 left-2.5 z-30 flex items-center gap-2 rounded-lg border border-white/10 bg-black/60 px-2.5 py-1 font-mono text-[9px] text-white/90 shadow-xl backdrop-blur-md"
              >
                <div class="relative h-1.5 w-1.5">
                  <div
                    class="absolute inset-0 animate-ping rounded-full bg-lofi-accent/40 opacity-40"
                  >
                  </div>
                  <div
                    class="h-full w-full rounded-full bg-lofi-accent"
                  >
                  </div>
                </div>
                <span class="font-black tracking-widest uppercase italic"
                  >SYST_ACT</span
                >
              </div>
            </div>
          </div>
        </div>
        <!-- Shadow Glow -->
        <div
          class="absolute -inset-10 -z-10 rounded-full bg-lofi-accent/[0.03] blur-[60px]"
        >
        </div>
      </div>

      <!-- TEXT CONTENT (Rescale) -->
      <div
        class="flex flex-col items-center justify-center space-y-4 text-center md:col-span-7 md:items-start md:space-y-4 md:text-left"
      >
        <div class="space-y-3 lg:space-y-3.5">
          <!-- STATUS: Downsized -->
          <div class="reveal">
            <div
              class="inline-flex items-center gap-2 rounded-full border border-lofi-accent/20 bg-lofi-accent/5 px-3 py-1.5 backdrop-blur-md"
            >
              <span class="relative flex h-1.5 w-1.5">
                <span
                  class="absolute inline-flex h-full w-full animate-ping rounded-full bg-lofi-pop/50 opacity-75"
                ></span>
                <span
                  class="relative inline-flex h-1.5 w-1.5 rounded-full bg-lofi-pop"
                ></span>
              </span>
              <span
                class="font-mono text-[10px] font-black tracking-[0.2em] text-white/80 uppercase italic"
                >{t("nav.status")}</span
              >
            </div>
          </div>

          <!-- HEADLINE: Downsized from 7xl to balanced size -->
          <h1
            class="reveal font-sans text-[clamp(1.7rem,6vw,2.2rem)] leading-[1.1] font-black tracking-tighter text-white md:text-[clamp(2.2rem,5vw,3rem)] lg:text-5xl"
          >
            {t("hero.description1")}
            <br />
            <span
              class="text-lofi-gradient transition-all duration-300"
              >{t("hero.description2")}</span
            >
          </h1>

          <!-- TAGLINE: Subtle -->
          <p
            class="reveal delay-100 mx-auto max-w-md translate-y-3 font-mono text-[10px] font-bold tracking-[0.15em] text-white/40 uppercase md:text-[11px] lg:mx-0"
          >
            {t("hero.tagline")}
          </p>
        </div>

        <!-- REFINED BUTTONS: Tighter -->
        <div
          class="reveal delay-200 flex w-full translate-y-3 flex-col gap-3.5 sm:flex-row sm:justify-center md:justify-start lg:justify-start"
        >
          <a
            href="#projects"
            class="group relative flex w-full items-center justify-center gap-3 overflow-hidden rounded-xl bg-white px-6 py-3.5 text-[9px] font-black tracking-widest text-black transition-all active:scale-95 sm:w-auto"
          >
            <span class="relative z-10 transition-colors group-hover:text-white"
              >EXPLORE_COLLECTION</span
            >
            <Icon
              name="tabler:arrow-up-right"
              size={16}
              class="relative z-10 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-white"
            />
            <div
              class="absolute inset-0 -translate-x-full bg-lofi-accent transition-transform duration-300 ease-out group-hover:translate-x-0"
            >
            </div>
          </a>
          <a
            href="#contact"
            class="group relative flex w-full items-center justify-center gap-3 overflow-hidden rounded-xl border border-white/10 bg-black/40 px-6 py-3.5 text-[9px] font-black tracking-widest text-white transition-all hover:border-lofi-accent/40 hover:bg-lofi-accent/[0.03] active:scale-95 sm:w-auto"
          >
            <span class="uppercase italic">{t("hero.cta")}</span>
            <Icon
              name="tabler:terminal"
              size={16}
              class="text-white/30 transition-colors group-hover:text-lofi-accent"
            />
          </a>
        </div>

        <!-- STRATEGIC SELLING STATS: Balanced -->
        <div
          class="reveal delay-300 grid w-full max-w-sm grid-cols-2 gap-x-8 gap-y-4 border-t border-white/10 pt-6 sm:max-w-md sm:grid-cols-3 md:pt-8 lg:max-w-none lg:pt-6"
        >
          {
            [
              {
                label: t("hero.stats.label1"),
                value: t("hero.stats.value1"),
                accent: false,
              },
              {
                label: t("hero.stats.label2"),
                value: t("hero.stats.value2"),
                accent: true,
              },
              {
                label: t("hero.stats.label3"),
                value: t("hero.stats.value3"),
                accent: false,
              },
            ].map((stat) => (
              <div class="group/stat flex touch-none flex-col items-center space-y-1 selection:hidden lg:items-start">
                <span class="font-mono text-[8.5px] font-black tracking-[0.3em] text-white/20 uppercase transition-colors group-hover/stat:text-lofi-accent/80">
                  {stat.label}
                </span>
                <span
                  class={`block text-base font-black tracking-tight ${stat.accent ? "text-lofi-accent" : "text-white"}`}
                >
                  {stat.value}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Perspective Depth (Subtle) */
  .isometric-grid {
    background-image:
      linear-gradient(45deg, rgba(165, 166, 246, 0.03) 1px, transparent 1px),
      linear-gradient(-45deg, rgba(165, 166, 246, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;
    perspective: 1200px;
    transform: rotateX(65deg) scale(1.8);
    mask-image: linear-gradient(to top, black, transparent 80%);
  }

  /* Optimized Grid BG */
  .grid-bg {
    background-size: 40px 40px;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    mask-image: radial-gradient(circle at 50% 50%, black 10%, transparent 90%);
  }

  /* ANIMATIONS */
  @keyframes float-slow {
    0%,
    100% {
      transform: translate(0, 0) rotate(0deg);
    }
    33% {
      transform: translate(8px, -12px) rotate(4deg);
    }
    66% {
      transform: translate(-8px, 8px) rotate(-4deg);
    }
  }
  @keyframes float-medium {
    0%,
    100% {
      transform: translate(0, 0) rotate(0deg);
    }
    50% {
      transform: translate(-12px, -8px) rotate(-6deg);
    }
  }
  @keyframes float-fast {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(10px, 10px);
    }
  }
  @keyframes scanline {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(400%);
    }
  }

  .animate-float-slow {
    animation: float-slow 14s infinite ease-in-out;
  }
  .animate-float-medium {
    animation: float-medium 10s infinite ease-in-out;
  }
  .animate-float-fast {
    animation: float-fast 8s infinite ease-in-out;
  }
  .animate-scanline {
    animation: scanline 10s infinite linear;
  }
</style>
