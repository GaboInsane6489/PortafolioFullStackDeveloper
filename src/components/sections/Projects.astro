---
import { Icon } from "astro-icon/components";
import EmblaCarousel from "../EmblaCarousel.astro";

const luzInteriorImages = Array.from(
  { length: 11 },
  (_, i) => `/images/LuzInterior${i + 1}.webp`,
);

const InstalacionesGarciasImages = Array.from(
  { length: 13 },
  (_, i) => `/images/InstalacionesGarcias${i + 1}.webp`,
);
---

<section id="projects" class="relative border-b border-white/5 py-32 lg:py-48">
  <div class="relative mx-auto w-full max-w-[1600px] px-8 sm:px-12 lg:px-16">
    <!-- Section Header -->
    <div
      class="mb-24 flex flex-col justify-between gap-8 md:flex-row md:items-end"
    >
      <div class="space-y-6">
        <div class="flex items-center gap-4">
          <span class="flex h-px w-12 bg-amber-500/50"></span>
          <span
            class="font-mono text-xs font-bold tracking-widest text-amber-500 uppercase"
          >
            Selected Works
          </span>
        </div>
        <h2 class="font-serif text-5xl leading-none text-white md:text-7xl">
          Digital <span
            class="bg-gradient-to-r from-gray-100 to-gray-500 bg-clip-text text-transparent"
            >Case Studies</span
          >
        </h2>
      </div>
      <p
        class="hidden max-w-md text-right text-lg font-light text-gray-400 md:block"
      >
        A curation of production-grade systems, focusing on architecture,
        performance, and user experience.
      </p>
    </div>

    <!-- Single Column Stack -->
    <div class="flex flex-col gap-32">
      <!-- PROJECT 1: MARTÍ ACADEMY OS (Star Project) -->
      <article class="group relative grid grid-cols-1 gap-12 lg:grid-cols-12">
        <!-- Content -->
        <div
          class="order-2 flex flex-col justify-center space-y-8 lg:order-1 lg:col-span-6"
        >
          <div class="flex items-center gap-4 text-amber-500">
            <Icon name="tabler:school" size={28} />
            <span class="font-mono text-xs font-bold tracking-widest uppercase"
              >EdTech Operating System</span
            >
          </div>

          <h3 class="font-serif text-4xl text-white lg:text-6xl">
            Martí Academy OS
          </h3>

          <p class="text-lg leading-relaxed text-gray-400">
            A comprehensive educational operating system converting a
            traditional institution into a digital ecosystem. Features <strong
              class="text-white">Smart Attendance</strong
            > with avatar grids, a complex <strong class="text-white"
              >Gamification Engine</strong
            > (XP, Streaks, Badges), and Role-Based Access Control (RBAC).
          </p>

          <div
            class="space-y-4 rounded-xl border border-white/5 bg-white/5 p-6"
          >
            <div class="flex items-center gap-3 text-sm text-gray-300">
              <Icon name="tabler:database" class="text-blue-400" />
              <span>Supabase (Auth, DB, Realtime)</span>
            </div>
            <div class="flex items-center gap-3 text-sm text-gray-300">
              <Icon name="tabler:brand-nextjs" class="text-white" />
              <span>Next.js 16 (Turbopack)</span>
            </div>
            <div class="flex items-center gap-3 text-sm text-gray-300">
              <Icon name="tabler:shield-lock" class="text-green-400" />
              <span>RBAC Middleware & RLS</span>
            </div>
          </div>

          <div class="flex items-center gap-6 pt-6">
            <a
              href="https://github.com/GaboInsane6489/Marti-Academy-OS"
              target="_blank"
              class="flex items-center gap-2 border-b border-amber-500 pb-1 font-mono text-xs font-bold tracking-widest text-amber-500 transition-all hover:text-amber-400"
            >
              SOURCE CODE
              <Icon name="tabler:arrow-up-right" />
            </a>
            <span
              class="flex items-center gap-2 font-mono text-xs text-gray-500"
            >
              <span class="h-2 w-2 animate-pulse rounded-full bg-green-500"
              ></span>
              V 1.0.0 STABLE
            </span>
          </div>
        </div>

        <!-- Visual (Placeholder using Code Block look for now as no images) -->
        <div
          class="relative order-1 min-h-[400px] overflow-hidden rounded-2xl border border-white/10 bg-[#0A0908] lg:order-2 lg:col-span-6"
        >
          <!-- Decorative Elements -->
          <div
            class="absolute -top-20 -right-20 h-64 w-64 rounded-full bg-blue-500/20 blur-[100px]"
          >
          </div>

          <div class="relative h-full w-full p-8 md:p-12">
            <div
              class="flex h-full w-full flex-col overflow-hidden rounded-xl border border-white/5 bg-[#050505] shadow-2xl"
            >
              <!-- Pseudo Browser Header -->
              <div
                class="flex items-center gap-2 border-b border-white/5 bg-white/5 px-4 py-3"
              >
                <div class="h-3 w-3 rounded-full bg-red-500/50"></div>
                <div class="h-3 w-3 rounded-full bg-yellow-500/50"></div>
                <div class="h-3 w-3 rounded-full bg-green-500/50"></div>
                <div class="ml-4 h-2 w-32 rounded-full bg-white/10"></div>
              </div>
              <!-- Pseudo Dashboard Content -->
              <div class="relative flex-1 p-6">
                <div class="mb-6 grid grid-cols-2 gap-4">
                  <div
                    class="h-24 rounded-lg border border-blue-500/20 bg-blue-500/10"
                  >
                  </div>
                  <div
                    class="h-24 rounded-lg border border-green-500/20 bg-green-500/10"
                  >
                  </div>
                </div>
                <div
                  class="mb-4 h-32 rounded-lg border border-white/5 bg-white/5"
                >
                </div>
                <div class="space-y-2">
                  <div class="h-2 w-3/4 rounded bg-white/10"></div>
                  <div class="h-2 w-1/2 rounded bg-white/10"></div>
                </div>

                <!-- Overlay Text -->
                <div
                  class="absolute inset-0 flex items-center justify-center bg-black/50 backdrop-blur-[2px]"
                >
                  <span
                    class="rounded border border-white/20 bg-black/80 px-6 py-3 font-mono text-xl font-bold tracking-widest text-white"
                  >
                    SYSTEM PREVIEW
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- PROJECT 2: LUZ INTERIOR -->
      <article class="group relative grid grid-cols-1 gap-12 lg:grid-cols-12">
        <!-- Visual -->
        <div
          class="relative min-h-[400px] overflow-hidden rounded-2xl border border-white/10 bg-[#0A0908] lg:col-span-7"
        >
          <div
            class="pointer-events-none absolute inset-0 z-10 bg-gradient-to-tr from-purple-500/10 to-transparent"
          >
          </div>
          <div
            class="h-full w-full transform transition-transform duration-700 group-hover:scale-[1.02]"
          >
            <EmblaCarousel images={luzInteriorImages} />
          </div>
        </div>

        <!-- Content -->
        <div class="flex flex-col justify-center space-y-8 lg:col-span-5">
          <div class="flex items-center gap-4 text-purple-400">
            <Icon name="tabler:bulb" size={28} />
            <span class="font-mono text-xs font-bold tracking-widest uppercase"
              >Personal Growth Platform</span
            >
          </div>

          <h3 class="font-serif text-3xl text-white lg:text-5xl">
            Mi Luz Interior
          </h3>

          <p class="text-lg leading-relaxed text-gray-400">
            An "Operating System" for personal reconstruction. Gamified growth
            tracking with
            <strong class="text-white">Atomic Design</strong> principles. Features
            structure logging, visible progress metrics, and a disciplined community
            architecture.
          </p>

          <div class="flex flex-wrap gap-2">
            {
              ["React 19", "Vite", "Supabase", "Row Level Security"].map(
                (tech) => (
                  <span class="rounded border border-white/10 bg-white/5 px-3 py-1 font-mono text-xs text-gray-300">
                    {tech}
                  </span>
                ),
              )
            }
          </div>

          <a
            href="https://github.com/GaboInsane6489/LuzInterior"
            target="_blank"
            class="inline-flex items-center gap-2 pt-4 font-mono text-xs font-bold tracking-widest text-white transition-all hover:text-purple-400"
          >
            VIEW REPOSITORY <Icon name="tabler:arrow-right" />
          </a>
        </div>
      </article>

      <!-- PROJECT 3: INSTALACIONES GARCÍA -->
      <article class="group relative grid grid-cols-1 gap-12 lg:grid-cols-12">
        <!-- Content -->
        <div
          class="order-2 flex flex-col justify-center space-y-8 lg:order-1 lg:col-span-5"
        >
          <div class="flex items-center gap-4 text-emerald-500">
            <Icon name="tabler:building-factory-2" size={28} />
            <span class="font-mono text-xs font-bold tracking-widest uppercase"
              >Enterprise Landing</span
            >
          </div>

          <h3 class="font-serif text-3xl text-white lg:text-5xl">
            Instalaciones García
          </h3>

          <p class="text-lg leading-relaxed text-gray-400">
            Digital presence for an infrastructure service provider. Implements
            <strong class="text-white">service tracking</strong> workflows and client
            resource optimization.
          </p>

          <div class="flex flex-wrap gap-2">
            {
              ["JavaScript", "HTML/CSS", "Google Maps API"].map((tech) => (
                <span class="rounded border border-white/10 bg-white/5 px-3 py-1 font-mono text-xs text-gray-300">
                  {tech}
                </span>
              ))
            }
          </div>

          <a
            href="https://github.com/GaboInsane6489/instalacionesgarciasfronted"
            target="_blank"
            class="inline-flex items-center gap-2 pt-4 font-mono text-xs font-bold tracking-widest text-white transition-all hover:text-emerald-400"
          >
            VIEW REPOSITORY <Icon name="tabler:arrow-right" />
          </a>
        </div>

        <!-- Visual -->
        <div
          class="relative order-1 min-h-[400px] overflow-hidden rounded-2xl border border-white/10 bg-[#0A0908] lg:order-2 lg:col-span-7"
        >
          <div
            class="pointer-events-none absolute inset-0 z-10 bg-gradient-to-bl from-emerald-500/10 to-transparent"
          >
          </div>
          <div
            class="h-full w-full transform transition-transform duration-700 group-hover:scale-[1.02]"
          >
            <EmblaCarousel images={InstalacionesGarciasImages} />
          </div>
        </div>
      </article>
    </div>
  </div>
</section>
