        <div class="group flex items-center gap-4">
          <Icon
            name="tabler:brand-git"
            size="20"
            class="text-white/70 transition-colors duration-300 group-hover:text-white"
          />
          <span>Git</span>
        </div>

        <div class="group flex items-center gap-4">
          <Icon
            name="tabler:brand-github"
            size="20"
            class="text-white/70 transition-colors duration-300 group-hover:text-white"
          />
          <span>GitHub</span>
        </div>

        <div class="group flex items-center gap-4">
          <Icon
            name="tabler:database-cog"
            size="20"
            class="text-white/70 transition-colors duration-300 group-hover:text-white"
          />
          <span>MySQL</span>
        </div>

        <div class="group flex items-center gap-4">
          <Icon
            name="tabler:leaf"
            size="20"
            class="text-white/70 transition-colors duration-300 group-hover:text-white"
          />
          <span>MongoDB</span>
        </div>

        <div class="group flex items-center gap-4">
          <Icon
            name="tabler:brand-laravel"
            size="20"
            class="text-white/70 transition-colors duration-300 group-hover:text-white"
          />
          <span>Laravel</span>
        </div>

        <div class="group flex items-center gap-4">
          <Icon
            name="tabler:brand-php"
            size="20"
            class="text-white/70 transition-colors duration-300 group-hover:text-white"
          />
          <span>PHP</span>
        </div>

        <div class="group flex items-center gap-4">
          <Icon
