---
import { Icon } from "astro-icon/components";
---

<section
  id="engineering"
  class="relative overflow-hidden border-t border-white/5 py-36 lg:py-48"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_10%,rgba(252,211,77,0.02),transparent_60%)]"
  >
  </div>

  <div class="relative mx-auto w-full max-w-[1300px] px-6 sm:px-12 lg:px-20">
    <header class="max-w-4xl space-y-10">
      <div class="reveal flex items-center gap-4">
        <div class="h-px w-12 bg-amber-500/50"></div>
        <span
          class="text-[10px] font-bold tracking-[0.6em] text-amber-200/60 uppercase"
        >
          Engineering & Open Source
        </span>
      </div>

      <h2
        class="reveal font-serif text-4xl leading-[0.95] tracking-tight text-white delay-100 md:text-6xl"
      >
        Code is not just written.
        <br />
        <span class="font-light text-white/40 italic">
          It is architected, documented and maintained.
        </span>
      </h2>

      <p
        class="reveal max-w-2xl text-lg leading-relaxed text-gray-400 delay-200"
      >
        My GitHub reflects structured repositories, production-grade
        documentation and disciplined contribution patterns.
      </p>
    </header>

    <div class="mt-24 grid gap-16 lg:grid-cols-2">
      <article class="reveal reveal-right group space-y-8">
        <div class="flex items-center gap-4">
          <div
            class="rounded-lg border border-white/10 bg-white/5 p-2 transition-colors group-hover:border-amber-500/50"
          >
            <Icon
              name="tabler:brand-github"
              size="22"
              class="text-white/70 group-hover:text-amber-400"
            />
          </div>
          <h3 class="text-2xl font-semibold text-white/80 italic">
            Profile Architecture
          </h3>
        </div>

        <div
          class="relative overflow-hidden rounded-xl border border-white/10 bg-white/[0.02] backdrop-blur-md transition-all duration-500 group-hover:border-white/20 group-hover:shadow-[0_20px_50px_rgba(0,0,0,0.3)]"
        >
          <img
            src="/images/GitHub1.webp"
            alt="GitHub profile overview"
            class="w-full transition-transform duration-1000 group-hover:scale-110"
            loading="lazy"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-[#0A0908] via-transparent to-transparent opacity-60"
          >
          </div>
        </div>
      </article>

      <article class="reveal reveal-left group space-y-8 delay-200">
        <div class="flex items-center gap-4">
          <div
            class="rounded-lg border border-white/10 bg-white/5 p-2 transition-colors group-hover:border-amber-500/50"
          >
            <Icon
              name="tabler:activity"
              size="22"
              class="text-white/70 group-hover:text-amber-400"
            />
          </div>
          <h3 class="text-2xl font-semibold text-white/80 italic">
            Contribution Discipline
          </h3>
        </div>

        <div
          class="relative overflow-hidden rounded-xl border border-white/10 bg-white/[0.02] backdrop-blur-md transition-all duration-500 group-hover:border-white/20 group-hover:shadow-[0_20px_50px_rgba(0,0,0,0.3)]"
        >
          <img
            src="/images/GitHub4.webp"
            alt="GitHub contributions graph"
            class="w-full transition-transform duration-1000 group-hover:scale-110"
            loading="lazy"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-[#0A0908] via-transparent to-transparent opacity-60"
          >
          </div>
        </div>
      </article>
    </div>

    <div
      class="reveal reveal-scale group relative mt-32 overflow-hidden rounded-2xl border border-white/10 bg-black shadow-2xl delay-400"
    >
      <div
        class="absolute -inset-[100%] animate-[spin_20s_linear_infinite] bg-[conic-gradient(from_90deg_at_50%_50%,transparent_0%,rgba(252,211,77,0.2)_50%,transparent_100%)] opacity-0 transition-opacity duration-1000 group-hover:opacity-100"
      >
      </div>

      <div class="relative m-[1px] overflow-hidden rounded-2xl bg-[#0A0908]">
        <video
          src="/videos/Programando2.mp4"
          class="h-auto w-full opacity-60 transition-all duration-500 group-hover:scale-[1.02] group-hover:opacity-100"
          autoplay
          loop
          muted
          playsinline></video>

        <div class="absolute bottom-8 left-8 hidden lg:block">
          <p
            class="font-mono text-[10px] tracking-[0.3em] text-white/40 uppercase"
          >
            System Heartbeat
          </p>
          <p class="font-serif text-xl text-white/80 italic">
            Code that breathes stability.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-32 grid gap-12 lg:grid-cols-3">
      {
        [
          {
            title: "Repository Quality",
            icon: "tabler:folder-code",
            img: "/images/GitHub3.webp",
            desc: "Clean structure and modular separation.",
          },
          {
            title: "Documentation Standards",
            icon: "tabler:file-text",
            img: "/images/GitHub5.webp",
            desc: "Architectural context and deployment clarity.",
          },
          {
            title: "Engineering Identity",
            icon: "tabler:layout-grid",
            img: "/images/GitHub2.webp",
            desc: "Visual coherence and system thinking.",
          },
        ].map((item, i) => (
          <article class={`reveal delay-[${(i + 6) * 100}ms] group space-y-6`}>
            <div class="flex items-center gap-3">
              <Icon
                name={item.icon}
                size="18"
                class="text-amber-500/60 transition-colors group-hover:text-amber-400"
              />
              <h3 class="text-sm font-bold tracking-widest text-white/70 uppercase transition-colors group-hover:text-white">
                {item.title}
              </h3>
            </div>
            <div class="relative overflow-hidden rounded-xl border border-white/5 grayscale transition-all duration-500 group-hover:border-white/20 group-hover:grayscale-0">
              <img
                src={item.img}
                alt={item.title}
                class="w-full transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <p class="text-sm leading-relaxed text-gray-500 italic transition-colors group-hover:text-gray-400">
              {item.desc}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
