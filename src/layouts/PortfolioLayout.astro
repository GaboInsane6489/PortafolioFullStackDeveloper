---
import TopNavbar from "../components/layout/TopNavbar.astro";
import SideNavbar from "../components/layout/SideNavbar.astro";
import Footer from "../components/layout/Footer.astro";
import Noise from "../components/ui/Noise.astro";
import "../styles/index.css";
import "flowbite";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { ClientRouter } from "astro:transitions";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary SEO -->
    <title>{t("seo.title")}</title>
    <meta name="title" content={t("seo.title")} />
    <meta name="description" content={t("seo.description")} />
    <meta name="author" content="Gabriel González" />
    <meta
      name="keywords"
      content="Full Stack Developer, System Architect, Web Development, JavaScript, TypeScript, Astro, React, Node.js, Portafolio, Venezuela"
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://gabo-fullstack.vercel.app" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://gabo-fullstack.vercel.app" />
    <meta property="og:title" content={t("seo.title")} />
    <meta property="og:description" content={t("seo.description")} />
    <meta
      property="og:image"
      content="https://gabo-fullstack.vercel.app/images/PortafolioFullStackDeveloper.webp"
    />
    <meta property="og:image:alt" content="Gabriel González - Portfolio" />
    <meta property="og:locale" content={lang === "es" ? "es_VE" : "en_US"} />
    <meta property="og:site_name" content="Gabriel González Portfolio" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://gabo-fullstack.vercel.app" />
    <meta name="twitter:title" content={t("seo.title")} />
    <meta name="twitter:description" content={t("seo.description")} />
    <meta
      name="twitter:image"
      content="https://gabo-fullstack.vercel.app/images/PortafolioFullStackDeveloper.webp"
    />

    <link rel="icon" type="image/png" href="/images/LogoPortafolio.webp" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>

  <body
    class="bg-[#0A0908] font-sans text-white antialiased selection:bg-amber-500/30"
  >
    <Noise />
    <div class="pointer-events-none fixed inset-0 -z-50 overflow-hidden">
      <video
        class="absolute h-full w-full object-cover opacity-50 mix-blend-lighten transition-opacity duration-1000"
        src="/videos/Cozy-Bedroom-Rainy-City-Moewalls-Com.mp4"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        aria-hidden="true"></video>

      <div
        class="absolute inset-0 bg-gradient-to-b from-[#0A0908]/20 via-transparent to-[#0A0908]/80 shadow-[inset_0_0_100px_rgba(0,0,0,0.2)]"
      >
      </div>

      <div
        class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.01)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.01)_1px,transparent_1px)] [mask-image:radial-gradient(ellipse_at_center,black,transparent_90%)] bg-[size:6rem_6rem]"
      >
      </div>
    </div>

    <TopNavbar />

    <!-- Layout adjustments for Sidebar vs Footer collision -->
    <div class="relative z-10 flex min-h-screen flex-col">
      <div class="mx-auto flex w-full max-w-[1600px] flex-1">
        <!-- Sidebar Desktop -->
        <aside class="relative z-50 hidden w-24 flex-shrink-0 md:block">
          <div
            class="sticky top-0 flex h-screen w-full items-center justify-center"
          >
            <SideNavbar />
          </div>
        </aside>

        <!-- Main -->
        <main class="flex-1 px-4 pb-28 md:pr-24 md:pb-0 overflow-x-hidden">
          <slot />
        </main>
      </div>

      <div class="pb-24 md:pb-0 overflow-x-hidden">
        <Footer />
      </div>
    </div>

    <!-- Sidebar Mobile -->
    <div
      class="fixed right-0 bottom-4 left-0 z-40 mx-auto flex w-full max-w-[95%] justify-center md:hidden"
    >
      <SideNavbar />
    </div>

    <script>
      const setupRevealObserver = () => {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("active");
              } else {
                entry.target.classList.remove("active");
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -80px 0px" },
        );

        document
          .querySelectorAll(".reveal")
          .forEach((el) => observer.observe(el));
      };

      setupRevealObserver();
      document.addEventListener("astro:after-swap", setupRevealObserver);
    </script>

    <style is:global>
      /* Mejoras en el renderizado del texto sobre video */
      body {
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
      }

      .reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.9s cubic-bezier(0.17, 0.55, 0.55, 1);
        will-change: opacity, transform;
      }

      .reveal.active {
        opacity: 1;
        transform: translateY(0);
      }

      /* Variaciones y Delays se mantienen igual... */
      .reveal-left {
        transform: translateX(-20px);
      }
      .reveal-right {
        transform: translateX(20px);
      }
      .reveal-left.active,
      .reveal-right.active {
        transform: translateX(0);
      }

      .delay-100 {
        transition-delay: 100ms;
      }
      .delay-200 {
        transition-delay: 200ms;
      }
    </style>
      {import.meta.env.PROD && (
        <Analytics />
        <SpeedInsights />
      )}
    </body>
</html>
