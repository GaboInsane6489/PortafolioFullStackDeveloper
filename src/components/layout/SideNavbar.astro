---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import LanguagePicker from "../ui/LanguagePicker.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const sections = [
  { label: "startup.sh", href: `/${lang}/#hero`, icon: "tabler:terminal" },
  { label: "profile.md", href: `/${lang}/#about-me`, icon: "tabler:user-code" },
  { label: "stack.json", href: `/${lang}/#tech-stack`, icon: "tabler:cpu" },
  { label: "projects.ts", href: `/${lang}/#projects`, icon: "tabler:stack-2" },
  { label: "experience.log", href: `/${lang}/#experience`, icon: "tabler:briefcase" },
  { label: "certs.gpg", href: `/${lang}/#certificates`, icon: "tabler:certificate" },
  { label: "laboratory.py", href: `/${lang}/#laboratory`, icon: "tabler:flask" },
];
---

<div
  class="flex h-full flex-col items-center justify-center gap-6"
>
  <nav
    id="side-nav"
    class="relative flex flex-col items-center gap-2"
  >
    <div
      id="nav-indicator"
      class="absolute left-[-12px] h-10 w-1 bg-lofi-accent shadow-[0_0_15px_rgba(165,166,246,0.6)] transition-all duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] opacity-0 pointer-events-none rounded-r-full"
    ></div>

    {
      sections.map((section, i) => (
        <a
          href={section.href}
          data-section={section.href.split("#")[1] || ''}
          style={`animation-delay: ${100 + i * 100}ms`}
          class="nav-link group relative flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl text-slate-400/60 transition-all duration-300 hover:bg-lofi-accent/10 hover:text-lofi-accent active:scale-90 animate-reveal-right"
          aria-label={section.label}
        >
          <Icon
            name={section.icon}
            stroke-width={1.5}
            class="relative z-10 h-[22px] w-[22px] transition-transform duration-300 group-hover:scale-110"
          />

          <div class="pointer-events-none absolute left-full ml-4 z-[300] hidden rounded-md border border-white/10 bg-[#0A0908]/95 px-3 py-1.5 opacity-0 shadow-2xl backdrop-blur-md transition-all duration-300 group-hover:opacity-100 md:block">
            <span class="font-mono text-[10px] font-medium tracking-widest whitespace-nowrap text-lofi-soft lowercase">
              {section.label}
            </span>
          </div>
        </a>
      ))
    }
  </nav>

  <div class="h-px w-6 bg-white/5"></div>

  <a
    href="https://www.linkedin.com/in/gabriel-gonzalez-fullstack/"
    target="_blank"
    style="animation-delay: 800ms;"
    class="group relative flex h-10 w-10 items-center justify-center rounded-xl text-slate-400/40 transition-all hover:bg-lofi-accent/10 hover:text-lofi-accent animate-reveal-right"
  >
    <Icon name="tabler:brand-linkedin" size={20} stroke-width={1.5} />
    <div class="pointer-events-none absolute left-full ml-4 z-[300] hidden rounded-md border border-white/10 bg-[#0A0908]/95 px-3 py-1.5 opacity-0 shadow-2xl backdrop-blur-md transition-all group-hover:opacity-100 md:block">
       <span class="font-mono text-[9px] font-medium tracking-widest text-white/50 uppercase">Network</span>
     </div>
  </a>
</div>

<style>
  /* Active State for IDE Activity Bar */
  .nav-link.is-active {
    color: #fff !important;
  }

  /* Reset redundant indicators */
  .active-indicator {
    display: none !important;
  }

  /* Premium Entrance Animations */
  .animate-reveal-right {
    animation: reveal-right 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }

  @keyframes reveal-right {
    from {
      opacity: 0;
      transform: translateX(-20px);
      filter: blur(10px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
      filter: blur(0);
    }
  }
</style>

<script>
  function initScrollSpy() {
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll(".nav-link");
    const navIndicator = document.getElementById("nav-indicator");
    const sideNav = document.getElementById("side-nav");

    function updateIndicator(activeLink: Element) {
      if (!activeLink || !navIndicator || !sideNav) return;

      const navRect = sideNav.getBoundingClientRect();
      const linkRect = activeLink.getBoundingClientRect();

      navIndicator.style.opacity = "1";
      navIndicator.style.top = `${linkRect.top - navRect.top}px`;
    }

    const observerOptions = {
      rootMargin: "-20% 0px -70% 0px",
      threshold: [0, 1],
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute("id");
          navLinks.forEach((link) => {
            const isActive = link.getAttribute("data-section") === id;
            link.classList.toggle("is-active", isActive);
            if (isActive) updateIndicator(link);
          });
        }
      });
    }, observerOptions);

    sections.forEach((section) => observer.observe(section));

    // Handle initial state and resize
    const initialActive = document.querySelector(".nav-link.is-active");
    if (initialActive) updateIndicator(initialActive);

    window.addEventListener("resize", () => {
      const active = document.querySelector(".nav-link.is-active");
      if (active) updateIndicator(active);
    });
  }

  initScrollSpy();
  document.addEventListener("astro:after-swap", initScrollSpy);
</script>
