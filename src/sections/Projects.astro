---
import { Icon } from "astro-icon/components";
import { getCollection, type CollectionEntry } from "astro:content";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allProjects = await getCollection("projects");
const projects = allProjects
  .filter((p: CollectionEntry<"projects">) => p.id.startsWith(`${lang}/`))
  .sort((a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) => a.data.order - b.data.order);
---

<section id="projects" class="relative overflow-hidden pb-16 lg:pb-32">
  <div class="pointer-events-none absolute top-0 left-1/2 h-full w-full -translate-x-1/2 bg-[radial-gradient(circle_at_top,rgba(252,211,77,0.05),transparent_60%)]"></div>

  <div class="relative mx-auto w-full max-w-[1400px] px-6">
    <div class="mb-12 flex flex-col justify-between gap-6 md:flex-row md:items-end lg:mb-20">
      <div class="reveal space-y-4">
        <div class="flex items-center gap-3">
          <span class="h-px w-8 bg-amber-500/50"></span>
          <span class="font-mono text-[10px] font-bold tracking-[0.4em] text-amber-500 uppercase">{t("projects.badge")}</span>
        </div>
        <h2 class="font-serif text-5xl leading-[1.1] text-white md:text-7xl lg:text-8xl">
          {t("projects.title1")}
          <span class="bg-gradient-to-r from-amber-400 to-amber-600 bg-clip-text text-transparent italic">{t("projects.title2")}</span>
        </h2>
      </div>
      <p class="reveal max-w-[320px] font-mono text-[11px] leading-relaxed text-slate-400 md:text-right" set:html={t("projects.description")} />
    </div>

    {/* Bento Grid Index */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project: CollectionEntry<"projects">) => (
        <a
          href={`/${lang}/projects/${project.id.split("/")[1]}`}
          class="group relative flex flex-col overflow-hidden rounded-2xl border border-amber-500/10 bg-black/40 p-1 backdrop-blur-md transition-all duration-500 hover:border-amber-500/40 hover:shadow-[0_0_30px_rgba(245,158,11,0.1)]"
        >
          {/* Main Visual Preview */}
          <div class="relative aspect-video overflow-hidden rounded-xl border border-white/5">
            <img
              src={project.data.mainImage}
              alt={project.data.title}
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
          </div>

          <div class="flex flex-1 flex-col p-5">
            <div class="mb-3 flex items-center justify-between">
              <span class="font-mono text-[9px] font-bold tracking-widest text-amber-500/60 uppercase">
                [{project.data.status}]
              </span>
              <Icon name="tabler:arrow-up-right" class="h-4 w-4 text-amber-500/40 transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-amber-500" />
            </div>

            <h3 class="mb-2 font-serif text-2xl text-white transition-colors group-hover:text-amber-400">
              {project.data.title}
            </h3>

            <p class="mb-6 line-clamp-2 text-sm leading-relaxed text-slate-400" set:html={project.data.description} />

            <div class="mt-auto flex flex-wrap gap-2">
              {project.data.techStack.slice(0, 3).map((tech: string) => (
                <span class="rounded border border-white/5 bg-white/5 px-2 py-0.5 font-mono text-[8px] text-slate-500 uppercase">
                  {tech}
                </span>
              ))}
              {project.data.techStack.length > 3 && (
                <span class="font-mono text-[8px] text-slate-600">+{project.data.techStack.length - 3}</span>
              )}
            </div>
          </div>

          {/* HUD Corner Decor */}
          <div class="absolute top-0 right-0 h-8 w-8 overflow-hidden pointer-events-none opacity-20 group-hover:opacity-100 transition-opacity">
            <div class="absolute top-0 right-0 h-[1px] w-4 bg-amber-500"></div>
            <div class="absolute top-0 right-0 h-4 w-[1px] bg-amber-500"></div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
