---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import fullStackCert from "../../public/images/FullStackCertificate.webp";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="certificates"
  class="reveal reveal-scale relative mx-auto my-8 max-w-[1400px] px-4 sm:px-8"
>
  <!-- Main Data Vault Container -->
  <div
    class="relative overflow-hidden rounded-[2.5rem] border border-amber-500/10 shadow-[0_0_50px_rgba(245,158,11,0.02)]"
  >
    <div class="grid-bg pointer-events-none absolute inset-0 opacity-[0.05]"></div>

    <div
      class="relative z-20 grid grid-cols-1 gap-12 p-8 md:p-10 lg:grid-cols-2 lg:items-center lg:gap-16 lg:px-20 lg:py-10"
    >
      <!-- Side A: Visual Credential Viewer (50% Width) -->
      <div
        class="reveal-scale flex flex-col items-center justify-center lg:pr-8"
      >
        <div class="group relative">
          <!-- Glow Base -->
          <div
            class="absolute -inset-4 rounded-[2rem] bg-amber-500/10 opacity-0 blur-2xl transition-opacity duration-700 group-hover:opacity-100"
          >
          </div>

          <!-- Viewer Frame -->
          <div
            class="relative overflow-hidden rounded-2xl border border-amber-500/20 bg-black/60 p-2 shadow-2xl transition-all duration-700 group-hover:border-amber-500/40"
          >
            <div
              class="mb-2 flex items-center justify-between border-b border-amber-500/10 px-3 pt-1 pb-1.5"
            >
              <div class="flex gap-1.5">
                <div class="h-1.5 w-1.5 rounded-full bg-red-500/40"></div>
                <div class="h-1.5 w-1.5 rounded-full bg-amber-500/40"></div>
              </div>
              <span
                class="font-mono text-[8px] font-black tracking-[0.2em] text-amber-500 uppercase drop-shadow-[0_0_5px_rgba(245,158,11,0.3)]"
                >{t("certs.badge.viewer")}</span
              >
            </div>

            <!-- Image Hub -->
            <div class="relative overflow-hidden rounded-lg">
              <Image
                src={fullStackCert}
                alt="Full Stack Certificate"
                width={500}
                height={350}
                format="webp"
                quality={90}
                loading="lazy"
                class="w-full max-w-[380px] transition-all duration-1000 group-hover:scale-105 group-hover:rotate-1 md:max-w-[500px]"
              />
              <div
                class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.1)_50%)] bg-[length:100%_4px] opacity-10"
              >
              </div>
            </div>

            <!-- Footer Meta (Relocated to avoid badge overlap) -->
            <div
              class="mt-2 flex flex-col gap-0.5 px-2 pb-3 font-mono text-[8px] font-bold tracking-widest text-amber-500 uppercase"
            >
              <span>Auth: 128-bit_verified</span>
              <span>Enc: logic_kernel_0x1</span>
            </div>
          </div>

          <!-- Floating Badge Merit -->
          <div
            class="absolute -right-3 -bottom-3 flex items-center gap-3 rounded-2xl border border-amber-500/30 bg-black/90 px-4 py-3 shadow-2xl backdrop-blur-2xl transition-all duration-500 group-hover:-translate-y-2 group-hover:scale-110 md:-right-6 md:-bottom-2"
          >
            <div
              class="relative flex h-9 w-9 items-center justify-center rounded-full bg-amber-500/10"
            >
              <Icon
                name="tabler:award-filled"
                class="text-amber-400"
                size={20}
              />
              <div
                class="animate-spin-slow absolute inset-0 rounded-full border border-dashed border-amber-400/30"
              >
              </div>
            </div>
            <div class="flex flex-col">
              <span
                class="font-mono text-[8px] leading-none font-black tracking-tighter text-amber-400 uppercase"
                >{t("certs.badge.honors")}</span
              >
              <span
                class="mt-1 font-mono text-[10px] font-black text-white uppercase"
                >{t("certs.badge.best")}</span
              >
            </div>
          </div>
        </div>

        <!-- Serial Tag -->
        <div class="mt-10 flex items-center gap-4 opacity-60">
          <div
            class="h-[1px] w-8 bg-gradient-to-r from-transparent to-amber-500/50"
          >
          </div>
          <p
            class="font-mono text-[9px] font-bold tracking-[0.5em] text-amber-500 uppercase"
          >
            FS-2023-CERT-01
          </p>
          <div
            class="h-[1px] w-8 bg-gradient-to-l from-transparent to-amber-500/50"
          >
          </div>
        </div>
      </div>

      <!-- Side B: Technical Specs (Data Nodes - 50% Width) -->
      <div
        class="flex flex-col space-y-8 lg:border-l lg:border-white/10 lg:pl-12"
      >
        <header class="reveal reveal-right space-y-4">
          <div class="flex items-center gap-3">
            <Icon
              name="tabler:shield-check"
              class="animate-pulse text-amber-500"
              size={14}
            />
            <h2
              class="font-mono text-[10px] font-black tracking-[0.5em] text-amber-500 uppercase"
            >
              {t("certs.title.certified")}
            </h2>
          </div>

          <h3 class="font-serif text-3xl leading-tight text-white md:text-5xl">
            {t("certs.title.main1")}
            <span
              class="bg-gradient-to-r from-amber-400 to-amber-600 bg-clip-text text-transparent italic"
              >{t("certs.title.main2")}</span
            >
          </h3>

          <p
            class="max-w-xl text-sm leading-relaxed font-light text-gray-400 md:text-base"
            set:html={t("certs.description")}
          />
        </header>

        <!-- System Modules Grid -->
        <ul
          class="reveal reveal-right grid grid-cols-1 gap-3 sm:grid-cols-2 lg:gap-4"
        >
          {
            [
              { name: t("certs.item1"), icon: "tabler:cpu" },
              { name: t("certs.item2"), icon: "tabler:binary-tree" },
              { name: t("certs.item3"), icon: "tabler:lambda" },
              { name: t("certs.item4"), icon: "tabler:database-cog" },
              { name: t("certs.item5"), icon: "tabler:cloud-computing" },
              { name: t("certs.item6"), icon: "tabler:settings-automation" },
            ].map((item) => (
              <li class="group relative flex items-center gap-3 overflow-hidden rounded-xl border border-white/10 bg-white/[0.03] p-3 backdrop-blur-md transition-all duration-300 hover:border-amber-500/40 hover:bg-amber-500/[0.08]">
                <!-- Item Scanner Line -->
                <div class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-amber-500/5 to-transparent transition-transform duration-1000 group-hover:translate-x-full"></div>
                
                <div class="relative z-10 flex h-10 w-10 items-center justify-center rounded-lg bg-amber-500/10 transition-all duration-500 group-hover:bg-amber-500/25">
                  <Icon
                    name={item.icon}
                    class="text-lg text-amber-500/70 group-hover:text-amber-400 group-hover:drop-shadow-[0_0_8px_rgba(245,158,11,0.5)]"
                  />
                </div>
                <span class="relative z-10 font-mono text-[10px] font-black tracking-tight text-slate-300 uppercase transition-colors group-hover:text-white">
                  {item.name}
                </span>
              </li>
            ))
          }
        </ul>

        <!-- Anti-Scroll Control: System Status -->
        <div
          class="flex items-center gap-4 rounded-lg border border-white/5 bg-black/40 p-4"
        >
          <div class="h-2 w-2 animate-pulse rounded-full bg-amber-500"></div>
            <span
              class="font-mono text-[9px] font-bold tracking-widest text-slate-300 uppercase"
              >System Integrity: Nominal // Grid_Active</span
            >
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes spin-slow {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  .animate-spin-slow {
    animation: spin-slow 8s linear infinite;
  }
</style>
