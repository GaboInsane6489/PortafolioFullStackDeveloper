---
import { Icon } from "astro-icon/components";
---

<section id="laboratory" class="flex justify-center py-32 lg:py-48">
  <div
    class="reveal reveal-scale relative mx-auto w-[95%] overflow-hidden rounded-3xl border border-emerald-500/20 bg-[#0A0908] shadow-[0_0_50px_rgba(16,185,129,0.1)] lg:w-[85%] 2xl:w-[75%]"
  >
    <video
      class="absolute inset-0 h-full w-full object-cover opacity-80 mix-blend-luminosity transition-transform duration-[20s] hover:scale-110"
      src="/videos/Hacker-Room-Rainy-Night.mp4"
      autoplay
      muted
      loop
      playsinline></video>

    <div
      class="absolute inset-0 bg-gradient-to-r from-[#0A0908] via-[#0A0908]/80 to-transparent"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-[#0A0908] via-transparent to-[#0A0908]/50"
    >
    </div>

    <div
      class="pointer-events-none absolute inset-0 bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-10 mix-blend-overlay"
    >
    </div>

    <div class="relative z-10 px-6 py-20 sm:px-12 lg:px-20">
      <div class="mb-20">
        <div class="reveal flex items-center gap-4">
          <span class="flex h-px w-12 bg-emerald-500/50"></span>
          <span
            class="font-mono text-xs font-bold tracking-[0.4em] text-emerald-500 uppercase"
          >
            R&D Facility
          </span>
        </div>
        <h2
          class="reveal mt-6 font-serif text-5xl text-white delay-100 md:text-7xl"
        >
          The <span
            class="bg-gradient-to-r from-emerald-400 to-emerald-600 bg-clip-text text-transparent italic"
            >Laboratory</span
          >
        </h2>
        <p
          class="reveal mt-6 max-w-xl text-lg leading-relaxed font-light text-gray-400 delay-200"
        >
          My digital sanctuary. Where deep work happens, code is compiled, and
          experimental systems are forged.
        </p>
      </div>

      <div
        class="grid grid-cols-1 items-stretch gap-12 lg:grid-cols-2 lg:gap-16"
      >
        <div
          class="reveal reveal-right group relative overflow-hidden rounded-2xl border border-emerald-500/20 bg-black/40 backdrop-blur-md transition-all duration-500 hover:border-emerald-500/40 hover:bg-black/60 hover:shadow-[0_0_30px_rgba(16,185,129,0.15)]"
        >
          <div
            class="flex items-center gap-2 border-b border-emerald-500/20 bg-black/50 px-6 py-3"
          >
            <div class="h-3 w-3 rounded-full bg-red-500/50"></div>
            <div class="h-3 w-3 rounded-full bg-yellow-500/50"></div>
            <div
              class="h-3 w-3 rounded-full bg-emerald-500/50 group-hover:animate-pulse group-hover:bg-emerald-400"
            >
            </div>
            <span
              class="ml-4 font-mono text-[10px] tracking-widest text-emerald-500/50"
              >sys_info.sh</span
            >
          </div>

          <div class="p-8">
            <div
              class="absolute top-8 right-8 p-4 opacity-20 transition-opacity duration-500 group-hover:opacity-40"
            >
              <Icon name="tabler:cpu" class="h-16 w-16 text-emerald-500" />
            </div>

            <h3
              class="mb-8 flex items-center gap-2 font-mono text-sm font-bold tracking-[0.2em] text-emerald-400 uppercase"
            >
              <Icon name="tabler:terminal" size={18} />
              // WORKSTATION_CORE
            </h3>

            <div class="relative z-10 space-y-4 font-mono text-xs md:text-sm">
              {
                [
                  { label: "CPU_UNIT", val: "AMD Ryzen 9 7950X" },
                  { label: "MEMORY_ALLOC", val: "32GB DDR5 6000MHz" },
                  { label: "GPU_ACCEL", val: "NVIDIA RTX 4090 24GB" },
                  { label: "STORAGE_VOL", val: "4TB NVMe Gen5 array" },
                  { label: "OS_KERNEL", val: "Arch Linux (Hyprland)" },
                ].map((spec) => (
                  <div class="group/row flex justify-between border-b border-white/5 pb-3 transition-colors hover:border-emerald-500/30">
                    <span class="text-gray-500 transition-colors group-hover/row:text-gray-400">
                      {spec.label}
                    </span>
                    <span class="text-emerald-100/80 transition-colors group-hover/row:text-emerald-300">
                      {spec.val}
                    </span>
                  </div>
                ))
              }
            </div>

            <div
              class="mt-8 flex items-center gap-3 font-mono text-emerald-500/80"
            >
              <span>root@lab:~#</span>
              <span class="h-4 w-2 animate-pulse bg-emerald-500"></span>
            </div>
          </div>
        </div>

        <div
          class="reveal reveal-left flex flex-col justify-between space-y-8 delay-200"
        >
          <div
            class="flex items-end justify-between border-b border-white/10 pb-4"
          >
            <div>
              <h3 class="font-serif text-3xl text-white">Active Research</h3>
              <p
                class="mt-2 flex items-center gap-2 font-mono text-[10px] text-gray-500"
              >
                <Icon
                  name="tabler:loader"
                  class="animate-spin text-emerald-500"
                  size={14}
                />
                CURRENTLY COMPILING...
              </p>
            </div>
            <div class="text-right">
              <span class="block font-mono text-4xl font-bold text-emerald-500"
                >84%</span
              >
              <span
                class="font-mono text-[9px] tracking-[0.3em] text-gray-500 uppercase"
                >Capacity Load</span
              >
            </div>
          </div>

          <div class="flex-1 space-y-6">
            {
              [
                {
                  name: "AI Agents & LLM Orchestration",
                  status: "Running...",
                  color: "bg-emerald-500",
                  shadow: "shadow-emerald-500/50",
                  text: "text-emerald-400",
                  w: "w-[75%]",
                },
                {
                  name: "Rust / Systems Programming",
                  status: "Compiling",
                  color: "bg-amber-500",
                  shadow: "shadow-amber-500/50",
                  text: "text-amber-400",
                  w: "w-[45%]",
                },
                {
                  name: "WebGL / Three.js Shaders",
                  status: "Rendering",
                  color: "bg-blue-500",
                  shadow: "shadow-blue-500/50",
                  text: "text-blue-400",
                  w: "w-[30%]",
                },
              ].map((skill) => (
                <div class="group">
                  <div class="mb-2 flex justify-between font-mono text-[11px] tracking-wider">
                    <span class="text-gray-300 transition-colors group-hover:text-white">
                      {skill.name}
                    </span>
                    <span class={`${skill.text} animate-pulse`}>
                      {skill.status}
                    </span>
                  </div>
                  <div class="h-1.5 w-full overflow-hidden rounded-full bg-white/5">
                    <div
                      class={`relative h-full ${skill.w} ${skill.color} shadow-[0_0_10px_rgba(0,0,0,0)] transition-all duration-500 group-hover:${skill.shadow}`}
                    >
                      <div class="absolute inset-0 w-full animate-[ping_3s_ease-in-out_infinite] bg-gradient-to-r from-transparent via-white/30 to-transparent" />
                    </div>
                  </div>
                </div>
              ))
            }
          </div>

          <div class="grid grid-cols-2 gap-4 border-t border-white/5 pt-4">
            <div
              class="group rounded-xl border border-white/5 bg-white/[0.02] p-4 transition-colors hover:border-emerald-500/30 hover:bg-emerald-500/5"
            >
              <div
                class="mb-2 font-mono text-[10px] tracking-[0.2em] text-gray-500 uppercase"
              >
                Editor
              </div>
              <div class="flex items-center gap-2 font-mono text-sm text-white">
                <Icon
                  name="tabler:brand-vscode"
                  class="text-blue-500"
                  size={16}
                />
                VS Code <span class="text-gray-600">/ VIM</span>
              </div>
            </div>
            <div
              class="group rounded-xl border border-white/5 bg-white/[0.02] p-4 transition-colors hover:border-emerald-500/30 hover:bg-emerald-500/5"
            >
              <div
                class="mb-2 font-mono text-[10px] tracking-[0.2em] text-gray-500 uppercase"
              >
                Theme
              </div>
              <div class="flex items-center gap-2 font-mono text-sm text-white">
                <Icon name="tabler:palette" class="text-purple-400" size={16} />
                Tokyo Night
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
