---
import TopNavbar from "../components/TopNavbar.astro";
import SideNavbar from "../components/SideNavbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/index.css";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Gabriel González | Full Stack Developer</title>
  </head>

  <body class="bg-black text-white selection:bg-white selection:text-black relative min-h-screen">

    <!-- 🎥 Video Background (capa más baja) -->
    <div class="fixed inset-0 -z-20 overflow-hidden pointer-events-none">
      <video
        class="w-full h-full object-cover"
        src="/videos/Train-Station-Rainy-Day.mp4"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
      ></video>

      <!-- Overlay controlado -->
      <div class="absolute inset-0 bg-black/40 md:bg-black/50"></div>
    </div>

    <!-- Top Navbar -->
    <TopNavbar />

    <!-- Contenedor principal -->
    <div class="relative z-10 flex">

      <!-- Side Navbar (solo desktop, fuera del footer) -->
      <SideNavbar />

      <!-- Columna de contenido -->
      <div class="flex-1 flex flex-col">

        <!-- Main content -->
        <main class="pt-28 md:pl-24 flex-1">
          <slot />
        </main>

        <!-- Footer (zona protegida) -->
        <footer class="relative z-20 md:ml-24">
          <Footer />
        </footer>

      </div>
    </div>

  </body>
</html>
