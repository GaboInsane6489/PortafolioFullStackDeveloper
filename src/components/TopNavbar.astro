---
import { Icon } from "astro-icon/components";

const links = [
  { label: "// home", href: "/" },
  { label: "// projects", href: "#projects" },
  { label: "// experience", href: "#experience" },
  { label: "// contact", href: "#contact" },
];
---

<nav
  id="topNav"
  class="fixed top-0 left-0 z-50 w-full border-b border-white/5 bg-[#0A0908]/80 backdrop-blur-md transition-all duration-500"
>
  <div
    class="mx-auto flex max-w-[1600px] items-center justify-between px-6 py-4 lg:px-12"
  >
    <!-- Brand -->
    <a href="/" class="group flex items-center gap-3">
      <div
        class="relative flex h-10 w-10 items-center justify-center overflow-hidden rounded-lg border border-white/10 bg-white/5 transition-all group-hover:border-amber-500/50"
      >
        <span
          class="font-mono text-lg font-bold text-white group-hover:text-amber-400"
        >
          <img
            src="/images/LogoPortafolio.webp"
            alt="LogoPortafolio"
            class="h-full w-full object-cover"
          />
        </span>
        <div
          class="absolute inset-0 -z-10 bg-amber-500/10 opacity-0 blur-md transition-opacity group-hover:opacity-100"
        >
        </div>
      </div>
      <div class="hidden flex-col md:flex">
        <span class="text-xs font-bold tracking-[0.2em] text-white"
          >GABRIEL GONZÁLEZ</span
        >
        <span class="font-mono text-[9px] text-gray-500"
          >Full Stack Architect</span
        >
      </div>
    </a>

    <!-- Desktop Links -->
    <div class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="group relative py-2 font-mono text-xs text-gray-400 transition-colors hover:text-white"
          >
            <span class="relative z-10">{link.label}</span>
            <span class="absolute bottom-0 left-0 h-px w-0 bg-amber-400 transition-all duration-300 group-hover:w-full" />
          </a>
        ))
      }
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-4">
      <a
        href="https://github.com/GaboInsane6489"
        target="_blank"
        aria-label="GitHub Profile"
        class="hidden items-center gap-2 rounded-md border border-white/10 bg-white/5 px-4 py-2 text-xs font-medium text-gray-300 transition-all hover:border-white/20 hover:bg-white/10 hover:text-white md:flex"
      >
        <Icon name="tabler:brand-github" size={16} />
        <span>Source</span>
      </a>

      <!-- Mobile Toggle -->
      <button
        id="menuBtn"
        aria-label="Open Menu"
        class="group relative z-50 flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/5 md:hidden"
      >
        <Icon
          name="tabler:menu-2"
          size={20}
          class="text-gray-300 transition-colors group-hover:text-white"
        />
      </button>
    </div>
  </div>

  <!-- Mobile Overlay -->
  <div
    id="mobileMenu"
    class="pointer-events-none fixed inset-0 flex flex-col items-center justify-center gap-8 bg-[#0A0908]/95 opacity-0 backdrop-blur-xl transition-all duration-500"
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          class="font-mono text-xl text-gray-400 transition-all duration-300 hover:scale-105 hover:text-amber-400"
        >
          {link.label}
        </a>
      ))
    }

    <div class="absolute bottom-12 flex gap-6">
      <a
        href="https://github.com/GaboInsane6489"
        class="text-gray-500 hover:text-white"
      >
        <Icon name="tabler:brand-github" size={24} />
      </a>
      <a href="https://linkedin.com" class="text-gray-500 hover:text-white">
        <Icon name="tabler:brand-linkedin" size={24} />
      </a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById("topNav");
  const btn = document.getElementById("menuBtn");
  const menu = document.getElementById("mobileMenu");

  // Scroll effect
  window.addEventListener("scroll", () => {
    if (!nav) return;
    if (window.scrollY > 20) {
      nav.classList.add("border-white/10", "shadow-2xl");
      nav.classList.remove("border-transparent");
    } else {
      nav.classList.remove("border-white/10", "shadow-2xl");
      nav.classList.add("border-transparent");
    }
  });

  // Mobile toggle
  if (btn && menu) {
    btn.addEventListener("click", () => {
      const isOpen = menu.classList.contains("opacity-100");
      menu.classList.toggle("opacity-100");
      menu.classList.toggle("pointer-events-auto");
      menu.classList.toggle("opacity-0");
      menu.classList.toggle("pointer-events-none");
      document.body.classList.toggle("overflow-hidden", !isOpen);
    });
  }
</script>
