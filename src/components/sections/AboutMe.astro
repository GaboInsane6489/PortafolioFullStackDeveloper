---
import { Icon } from "astro-icon/components";
---

<section
  class="relative flex min-h-[100dvh] items-center overflow-hidden border-t border-white/5 py-12 md:py-24"
  id="about-me"
>
  <div
    class="pointer-events-none absolute inset-0 [background-image:radial-gradient(rgba(252,211,77,0.03)_1px,transparent_1px)] [mask-image:linear-gradient(180deg,white,transparent)] [background-size:24px_24px] opacity-40"
  >
  </div>

  <div class="relative mx-auto w-full max-w-[1200px] px-6 sm:px-12 lg:px-16">
    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="space-y-6 lg:col-span-8">
        <div class="space-y-3">
          <div class="reveal flex items-center gap-3">
            <div class="h-px w-8 bg-amber-300/60"></div>
            <span
              class="text-[9px] font-bold tracking-[0.4em] text-amber-300/80 uppercase"
              >Professional Profile</span
            >
          </div>

          <h2
            class="reveal font-serif text-4xl leading-[1.1] tracking-tighter text-white delay-100 md:text-5xl lg:text-7xl"
          >
            Engineering with structure,
            <br />
            <span class="font-light text-white/30 italic"
              >not improvisation.</span
            >
          </h2>
        </div>

        <div
          class="reveal max-w-2xl space-y-4 text-base leading-relaxed text-gray-400 delay-200 md:text-lg"
        >
          <p>
            I am a <span class="font-medium text-white"
              >Full Stack Developer</span
            > and Computer Engineering student at UCAB, bridging the gap between <span
              class="text-white/80">academic rigor</span
            > and high-performance web technologies.
          </p>
          <p>
            Currently, I engineer features for <span
              class="text-amber-200/90 italic">Harry Potter Head</span
            >, managing systems for over <span class="font-medium text-white"
              >20,000 daily active users</span
            >. This environment has sharpened my ability to handle complex
            tickets—from real-time notification engines to critical database
            migrations—within a strict <span class="text-white/80"
              >Git-flow and PR-review</span
            > ecosystem.
          </p>
          <p>
            I don't just write code; I follow professional standards to ensure
            every deployment is <span class="text-amber-200/70"
              >controlled, documented, and scalable</span
            >.
          </p>
        </div>
      </div>

      <div class="flex flex-col gap-8 lg:col-span-4 lg:pt-20">
        <div
          class="reveal reveal-right space-y-5 border-l border-amber-900/30 pl-6 delay-500"
        >
          {
            [
              { label: "Core Stack", value: "Next.js / Astro / Supabase" },
              { label: "Methodology", value: "Ticket-based / PR-driven" },
              { label: "Expertise", value: "AI-Assisted Optimization" },
            ].map((item) => (
              <div class="group cursor-default">
                <p class="text-[8px] font-black tracking-widest text-amber-600/60 uppercase">
                  {item.label}
                </p>
                <p class="text-sm text-white/70 italic transition-colors group-hover:text-amber-300 md:text-base">
                  {item.value}
                </p>
              </div>
            ))
          }
        </div>

        <div class="flex flex-wrap gap-2">
          {
            [
              "PostgreSQL",
              "Event-Driven",
              "CI/CD Pipelines",
              "REST APIs",
              "Node.js",
              "MVC",
            ].map((tag, index) => (
              <span
                class="reveal rounded-md border border-white/5 bg-white/[0.03] px-2.5 py-1 text-[8px] font-bold tracking-widest text-amber-200/40 uppercase backdrop-blur-sm transition-colors hover:border-amber-500/30 hover:text-amber-200/80"
                style={`transition-delay: ${(index + 6) * 100}ms`}
              >
                {tag}
              </span>
            ))
          }
        </div>
      </div>

      <div
        class="reveal reveal-scale group relative mt-4 delay-700 lg:col-span-12"
      >
        <div
          class="overflow-hidden rounded-xl border border-white/10 bg-[#0A0908] shadow-2xl transition-all duration-700 group-hover:border-amber-500/20"
        >
          <div class="flex h-8 items-center justify-between bg-[#1A1513] px-4">
            <div class="flex items-center gap-4">
              <div class="flex gap-1.5">
                <div class="h-2 w-2 rounded-full bg-red-500/20"></div>
                <div class="h-2 w-2 rounded-full bg-yellow-500/20"></div>
                <div class="h-2 w-2 rounded-full bg-green-500/20"></div>
              </div>
              <div
                class="flex h-8 items-center gap-2 border-t border-t-amber-500/50 bg-[#0A0908] px-4"
              >
                <Icon
                  name="tabler:brand-typescript"
                  size={12}
                  class="text-[#8caaee]"
                />
                <span class="font-mono text-[10px] text-[#c6d0f5]"
                  >TechnicalExpertise.ts</span
                >
              </div>
            </div>
            <span
              class="hidden font-mono text-[9px] tracking-widest text-white/10 uppercase md:block"
              >Production Environment — Global</span
            >
          </div>

          <div class="relative aspect-video lg:aspect-[21/9]">
            <video
              src="/videos/Programando.mp4"
              class="h-full w-full object-cover opacity-60 transition-all duration-1000 group-hover:scale-[1.02] group-hover:opacity-100"
              autoplay
              loop
              muted
              playsinline></video>
            <div
              class="absolute inset-0 bg-gradient-to-t from-[#0A0908] via-transparent to-transparent"
            >
            </div>

            <div class="absolute bottom-6 left-8">
              <p
                class="font-serif text-xl leading-tight text-white/90 italic md:text-2xl"
              >
                "Writing code is easy.<br />
                <span class="text-amber-500/80"
                  >Building systems is the craft."</span
                >
              </p>
            </div>
          </div>
        </div>

        <div
          class="absolute -inset-4 -z-10 rounded-full bg-amber-500/5 opacity-0 blur-3xl transition-opacity duration-700 group-hover:opacity-100"
        >
        </div>
      </div>
    </div>
  </div>
</section>
