---
import { Icon } from "astro-icon/components";

const sections = [
  { label: "START_UP", href: "#hero", icon: "tabler:home" },
  { label: "PROFILE", href: "#about-me", icon: "tabler:user-code" },
  { label: "STACK", href: "#tech-stack", icon: "tabler:cpu" },
  { label: "PROJECTS", href: "#projects", icon: "tabler:stack-2" },
  { label: "EXP", href: "#experience", icon: "tabler:briefcase" },
  { label: "CERTS", href: "#certificates", icon: "tabler:certificate" },
  { label: "LAB", href: "#laboratory", icon: "tabler:flask" },
  { label: "ENGINEERING", href: "#engineering", icon: "tabler:brand-github" },
];
---

<div
  class="relative z-[100] flex flex-row items-center gap-2 md:flex-col md:gap-3"
>
  <nav
    class="flex max-w-full items-center gap-1 overflow-x-auto overflow-y-hidden rounded-full border border-white/10 bg-[#0A0908]/90 px-2 py-1.5 shadow-2xl backdrop-blur-xl md:flex-col md:overflow-visible md:rounded-2xl md:bg-[#0A0908]/70 md:p-1.5 [&::-webkit-scrollbar]:hidden"
  >
    {
      sections.map((section) => (
        <a
          href={section.href}
          data-section={section.href.replace("#", "")}
          class="nav-link group relative flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full text-gray-500 transition-all duration-300 hover:text-amber-500 active:scale-75 md:h-9 md:w-9 md:rounded-xl"
          aria-label={section.label}
        >
          <Icon
            name={section.icon}
            class="relative z-10 h-[18px] w-[18px] transition-transform duration-300 group-hover:scale-110 md:h-[20px] md:w-[20px] lg:h-[22px] lg:w-[22px]"
          />

          <div class="pointer-events-none absolute left-16 z-50 hidden rounded-md border border-white/10 bg-[#0A0908] px-3 py-1.5 opacity-0 shadow-xl transition-all duration-300 group-hover:left-14 group-hover:opacity-100 md:block">
            <span class="font-mono text-[11px] font-bold tracking-[0.2em] whitespace-nowrap text-amber-500 uppercase">
              {section.label}
            </span>
          </div>

          <div class="active-indicator absolute -bottom-1 left-1/2 h-1 w-1 -translate-x-1/2 scale-0 rounded-full bg-amber-500 shadow-[0_0_10px_rgba(245,158,11,0.8)] transition-all duration-300 md:bottom-auto md:-left-2 md:h-4 md:w-0.5 md:translate-x-0" />
        </a>
      ))
    }
  </nav>

  <div class="hidden sm:block md:w-full">
    <div
      class="mx-auto mb-2 hidden h-6 w-px bg-gradient-to-b from-white/10 to-transparent md:block"
    >
    </div>
    <a
      href="https://github.com/GaboInsane6489"
      target="_blank"
      class="group relative flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-[#0A0908]/70 text-gray-500 transition-all hover:text-amber-500 md:mx-auto md:rounded-xl"
    >
      <Icon name="tabler:brand-github" size={17} />
    </a>
  </div>
</div>

<style>
  /* Estado Activo */
  .nav-link.is-active {
    color: #f59e0b !important;
    background-color: rgba(245, 158, 11, 0.1);
  }

  .nav-link.is-active .active-indicator {
    scale: 1;
    opacity: 1;
  }

  /* Ajuste específico para Desktop en el indicador */
  @media (min-width: 768px) {
    .nav-link.is-active .active-indicator {
      width: 2px;
      height: 16px;
    }
  }

  /* Animación de entrada suave */
  .nav-link {
    -webkit-tap-highlight-color: transparent;
  }
</style>

<script>
  function initScrollSpy() {
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll(".nav-link");

    const observerOptions = {
      root: null,
      rootMargin: "-45% 0px -45% 0px",
      threshold: 0,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute("id");
          navLinks.forEach((link) => {
            const isActive = link.getAttribute("data-section") === id;
            link.classList.toggle("is-active", isActive);
          });
        }
      });
    }, observerOptions);

    sections.forEach((section) => observer.observe(section));
  }

  initScrollSpy();
  document.addEventListener("astro:after-swap", initScrollSpy);
</script>
