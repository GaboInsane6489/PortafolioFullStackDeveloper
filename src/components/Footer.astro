---
import { Icon } from "astro-icon/components";

const links = [
  { label: "Inicio", href: "/" },
  { label: "Proyectos", href: "#projects" },
  { label: "Sobre mí", href: "#about" },
  { label: "Contacto", href: "#contact" },
];
---

<footer
  class="relative w-full overflow-hidden border-t border-white/5 bg-black pt-28 pb-12 text-white"
>
  <!-- MARCA DE AGUA EDITORIAL -->
  <div
    class="pointer-events-none absolute -top-10 -left-24 hidden select-none 2xl:block"
  >
    <span
      class="font-serif text-[18rem] leading-none font-black tracking-tighter text-white/[0.02] uppercase"
    >
      GG
    </span>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-12">
    <!-- GRID PRINCIPAL -->
    <div class="grid grid-cols-1 gap-20 md:grid-cols-3">
      <!-- IDENTIDAD -->
      <div class="space-y-8">
        <div class="space-y-6">
          <div class="flex items-center gap-4">
            <div class="h-[1px] w-12 bg-amber-400"></div>
            <span
              class="text-[10px] font-bold tracking-[0.6em] text-amber-300 uppercase"
            >
              Identidad
            </span>
          </div>

          <h3 class="font-serif text-3xl tracking-tight md:text-4xl">
            Gabriel González
          </h3>
        </div>

        <p class="max-w-sm leading-relaxed text-gray-400">
          Desarrollo experiencias web de alto rendimiento con arquitectura
          limpia, foco en SEO y una ejecución visual que comunica precisión.
        </p>

        <p
          class="text-[10px] font-bold tracking-[0.4em] text-gray-600 uppercase"
        >
          Código. Sistema. Impacto.
        </p>
      </div>

      <!-- NAVEGACIÓN -->
      <nav aria-label="Footer navigation" class="space-y-8">
        <h4
          class="text-[10px] font-bold tracking-[0.6em] text-gray-500 uppercase"
        >
          Navegación
        </h4>

        <ul class="space-y-4">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="group inline-flex items-center gap-3 text-sm text-gray-300 transition-colors hover:text-white"
                >
                  <span class="relative">
                    {link.label}
                    <span class="absolute -bottom-1 left-0 h-px w-0 bg-amber-400 transition-all duration-300 group-hover:w-full" />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- SOCIAL / CONTACTO -->
      <div class="space-y-8">
        <h4
          class="text-[10px] font-bold tracking-[0.6em] text-gray-500 uppercase"
        >
          Conecta
        </h4>

        <ul class="space-y-6">
          <li>
            <a
              href="https://github.com/GaboInsane6489"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between border border-white/10 px-6 py-4 transition-all hover:border-amber-400"
            >
              <div class="flex items-center gap-4">
                <Icon name="tabler:brand-github" size="20" />
                <span class="text-sm">GitHub</span>
              </div>
              <Icon
                name="tabler:arrow-up-right"
                size="16"
                class="opacity-0 transition-all group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:opacity-100"
              />
            </a>
          </li>

          <li>
            <a
              href="https://www.linkedin.com/in/gabriel-gonzalez-fullstack/"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between border border-white/10 px-6 py-4 transition-all hover:border-amber-400"
            >
              <div class="flex items-center gap-4">
                <Icon name="tabler:brand-linkedin" size="20" />
                <span class="text-sm">LinkedIn</span>
              </div>
              <Icon
                name="tabler:arrow-up-right"
                size="16"
                class="opacity-0 transition-all group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:opacity-100"
              />
            </a>
          </li>
          <li>
            <a
              href="https://www.instagram.com/dreamsfallen6488/"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between border border-white/10 px-6 py-4 transition-all hover:border-amber-400"
            >
              <div class="flex items-center gap-4">
                <Icon name="tabler:brand-instagram" size="20" />
                <span class="text-sm">Instagram</span>
              </div>
              <Icon
                name="tabler:arrow-up-right"
                size="16"
                class="opacity-0 transition-all group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:opacity-100"
              />
            </a>
          </li>
          <li>
            <a
              href="https://www.youtube.com/@Gabo6489Gaming-pe2tg"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between border border-white/10 px-6 py-4 transition-all hover:border-amber-400"
            >
              <div class="flex items-center gap-4">
                <Icon name="tabler:brand-youtube" size="20" />
                <span class="text-sm">YouTube</span>
              </div>
              <Icon
                name="tabler:arrow-up-right"
                size="16"
                class="opacity-0 transition-all group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:opacity-100"
              />
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- DIVISOR EDITORIAL -->
    <div
      class="mt-24 flex flex-col items-center justify-between gap-6 border-t border-white/5 pt-8 text-xs tracking-widest text-gray-600 uppercase md:flex-row"
    >
      <p>
        © {new Date().getFullYear()} Gabriel González
      </p>

      <p class="text-gray-500">
        Full Stack Developer · Arquitectura & Performance
      </p>
    </div>
  </div>
</footer>
