---
import { Icon } from "astro-icon/components";

interface Props {
  images: string[];
  autoplay?: boolean;
  interval?: number;
}

const { images, autoplay = true, interval = 5000 } = Astro.props as Props;
---

<div
  class="embla-wrapper group relative mx-auto w-full max-w-5xl px-4 md:px-0"
  data-autoplay={String(autoplay)}
  data-interval={interval}
>
  <div class="absolute -top-px left-0 z-[60] h-[2px] w-full px-5">
    <div class="h-full w-full overflow-hidden rounded-full bg-white/5">
      <div
        class="embla-progress h-full w-0 bg-gradient-to-r from-blue-500 to-cyan-400 shadow-[0_0_15px_rgba(59,130,246,0.5)] transition-all duration-300 ease-out"
      >
      </div>
    </div>
  </div>

  <div
    class="relative rounded-2xl border border-white/10 bg-[#0A0908] shadow-[0_40px_100px_-20px_rgba(0,0,0,0.8)]"
  >
    <div
      class="flex h-11 items-center justify-between border-b border-white/5 bg-[#1A1614] px-4 md:px-6"
    >
      <div class="flex items-center gap-3">
        <div class="flex gap-1.5">
          <div class="h-2.5 w-2.5 rounded-full bg-[#ef9f76]/40"></div>
          <div class="h-2.5 w-2.5 rounded-full bg-[#e5c890]/40"></div>
          <div class="h-2.5 w-2.5 rounded-full bg-[#a6d189]/40"></div>
        </div>
        <div
          class="ml-2 flex h-11 items-center gap-2 border-t-2 border-t-blue-400 bg-[#241C19] px-3"
        >
          <Icon name="tabler:world-www" size={14} class="text-blue-400" />
          <span
            class="font-mono text-[9px] tracking-widest text-[#c6d0f5] uppercase"
            >PREVIEW_V1</span
          >
        </div>
      </div>
      <div
        class="hidden items-center gap-2 rounded-md bg-black/20 px-2 py-1 md:flex"
      >
        <Icon name="tabler:lock" size={10} class="text-green-500/30" />
        <span class="font-mono text-[8px] text-white/20 uppercase"
          >encrypted_node</span
        >
      </div>
    </div>

    <div class="embla overflow-hidden">
      <div class="embla__container flex">
        {
          images.map((src, index) => (
            <div class="embla__slide relative min-w-0 flex-[0_0_100%] bg-[#0A0908]">
              <div class="relative flex aspect-video w-full items-center justify-center p-2 md:p-6">
                <img
                  src={src}
                  alt={`Preview ${index + 1}`}
                  class="h-full w-full object-contain drop-shadow-[0_10px_30px_rgba(0,0,0,0.5)] will-change-transform"
                  loading="lazy"
                />
              </div>

              <div class="absolute right-4 bottom-4 z-20 flex items-center gap-2 font-mono text-[9px] text-white/30">
                <span class="font-bold text-blue-400/60">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div class="h-[1px] w-4 bg-white/5" />
                <span>{String(images.length).padStart(2, "0")}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Pagination Dots Structure -->
  <div
    class="embla__dots absolute bottom-6 left-1/2 z-[70] flex -translate-x-1/2 gap-3"
    role="tablist"
    aria-label="Slides"
  >
  </div>

  <button
    type="button"
    class="embla-prev absolute top-1/2 -left-2 z-[70] flex h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-white/10 bg-white/5 text-white shadow-inner backdrop-blur-2xl transition-all duration-300 active:scale-90 md:-left-5 md:h-12 md:w-12 md:opacity-0 md:group-hover:left-4 md:group-hover:opacity-100 lg:hover:border-blue-400 lg:hover:text-blue-400"
    aria-label="Previous Slide"
  >
    <Icon name="tabler:chevron-left" size={24} />
  </button>

  <button
    type="button"
    class="embla-next absolute top-1/2 -right-2 z-[70] flex h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-white/10 bg-white/5 text-white shadow-inner backdrop-blur-2xl transition-all duration-300 active:scale-90 md:-right-5 md:h-12 md:w-12 md:opacity-0 md:group-hover:right-4 md:group-hover:opacity-100 lg:hover:border-blue-400 lg:hover:text-blue-400"
    aria-label="Next Slide"
  >
    <Icon name="tabler:chevron-right" size={24} />
  </button>
</div>

<style>
  /* Asegura que el aspecto 16:9 se mantenga para evitar espacios negros */
  .aspect-video {
    aspect-ratio: 16 / 9;
  }

  /* En móviles muy verticales, ajustamos un poco el ratio si es necesario */
  @media (max-width: 640px) {
    .aspect-video {
      aspect-ratio: 1 / 1.1; /* Más alto para capturas de móvil si tienes */
      min-height: 350px;
    }
  }

  /* Quitamos el tap highlight azul de mobile */
  button {
    -webkit-tap-highlight-color: transparent;
  }
</style>

<script>
  import { initEmbla } from "../scripts/embla-init.ts";
  const setup = () => initEmbla();
  document.addEventListener("astro:page-load", setup);
  setup();
</script>
