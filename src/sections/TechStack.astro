---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const categories = ["ALL", "FRONTEND", "BACKEND", "DATABASE", "DEVOPS"];

const techStack = [
  {
    name: "Next.js",
    icon: "tabler:brand-nextjs",
    color: "text-white",
    category: "FRONTEND",
    role: "CORE_RUNTIME",
    tag: "STABLE",
  },
  {
    name: "React",
    icon: "tabler:brand-react",
    color: "text-sky-400",
    category: "FRONTEND",
    role: "UI_PROTOCOL",
    tag: "STABLE",
  },
  {
    name: "Astro",
    icon: "tabler:brand-astro",
    color: "text-orange-400",
    category: "FRONTEND",
    role: "STATIC_ENGINE",
    tag: "OPTIMIZING",
  },
  {
    name: "TypeScript",
    icon: "tabler:brand-typescript",
    color: "text-blue-500",
    category: "FRONTEND",
    role: "TYPE_SAFETY",
    tag: "STABLE",
  },
  {
    name: "Tailwind",
    icon: "tabler:brand-tailwind",
    color: "text-cyan-400",
    category: "FRONTEND",
    role: "STYLE_SYSTEM",
    tag: "STABLE",
  },
  {
    name: "Node.js",
    icon: "tabler:brand-nodejs",
    color: "text-green-500",
    category: "BACKEND",
    role: "SERVER_CORE",
    tag: "STABLE",
  },
  {
    name: "Laravel",
    icon: "tabler:brand-laravel",
    color: "text-red-500",
    category: "BACKEND",
    role: "API_INFRA",
    tag: "STABLE",
  },
  {
    name: "Supabase",
    icon: "tabler:brand-supabase",
    color: "text-emerald-500",
    category: "DATABASE",
    role: "AUTH_STORAGE",
    tag: "STABLE",
  },
  {
    name: "PostgreSQL",
    icon: "tabler:database",
    color: "text-blue-400",
    category: "DATABASE",
    role: "RELATIONAL_DB",
    tag: "STABLE",
  },
  {
    name: "MongoDB",
    icon: "tabler:brand-mongodb",
    color: "text-green-600",
    category: "DATABASE",
    role: "DOCUMENT_STORE",
    tag: "STABLE",
  },
  {
    name: "Vercel",
    icon: "tabler:brand-vercel",
    color: "text-white",
    category: "DEVOPS",
    role: "EDGE_RUNTIME",
    tag: "STABLE",
  },
  {
    name: "GitHub Actions",
    icon: "tabler:brand-github",
    color: "text-white",
    category: "DEVOPS",
    role: "CI_CD_PIPELINE",
    tag: "OPTIMIZING",
  },
];
---

<section
  id="tech-stack"
  class="relative flex flex-col justify-center border-t border-white/5 py-12 lg:py-20 overflow-x-hidden"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(165,166,246,0.06),transparent_60%)]"
  >
  </div>

  <div class="relative mx-auto w-full max-w-6xl px-6">
    <!-- Header Section -->
    <div class="mb-10 flex flex-col items-center text-center lg:items-start lg:text-left">
      <div class="reveal mb-4 inline-flex items-center gap-3 rounded-full border border-lofi-accent/20 bg-lofi-accent/5 px-4 py-1.5 backdrop-blur-md">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-lofi-pop opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-lofi-pop"></span>
        </span>
        <span class="font-mono text-[10px] font-black tracking-[0.3em] text-lofi-accent uppercase">
          {t("stack.badge")}
        </span>
      </div>

      <h2 class="reveal font-serif text-3xl leading-tight text-white md:text-5xl lg:text-6xl">
        {t("stack.title1")} <br />
        <span class="font-light text-white/30 italic">{t("stack.title2")}</span>
      </h2>
    </div>

    <!-- CLI Filter Bar -->
    <div class="reveal mb-8 flex flex-col gap-4 lg:mb-12">
      <!-- Desktop: Label (hidden on mobile) -->
      <div class="hidden items-center gap-4 border-b border-white/5 pb-4 sm:flex">
        <span class="font-mono text-[11px] font-bold text-lofi-soft uppercase tracking-widest whitespace-nowrap">{t("stack.filter")}</span>
        <div class="flex flex-1 flex-wrap gap-2">
          {categories.map((cat: string) => (
            <button
              data-filter={cat}
              class="filter-btn cursor-pointer group relative flex items-center gap-2 overflow-hidden rounded-lg border border-white/20 bg-white/10 px-4 py-2 font-mono text-[10px] font-black tracking-widest text-slate-200 transition-all duration-200 hover:border-lofi-mid/30 hover:bg-white/15 hover:text-white whitespace-nowrap shadow-lg shadow-black/20"
              aria-label={`Filter by ${cat}`}
            >
              <!-- Flash Effect Shadow -->
              <span class="flash-effect absolute inset-0 -translate-x-full bg-lofi-mid/30 transition-transform duration-300 ease-out"></span>
              <span class="relative z-10 text-lofi-mid/60 transition-colors group-hover:text-lofi-accent">></span>
              <span class="relative z-10 text-slate-200 transition-colors group-hover:text-white uppercase">{cat}</span>
              <!-- Active Indicator -->
              <div class="absolute bottom-0 left-0 h-[2px] w-0 bg-lofi-accent transition-all duration-500 marker-line"></div>
            </button>
          ))}
        </div>
      </div>

      <!-- Mobile: 3-Column Tap Grid (hidden on sm+) -->
      <div class="grid grid-cols-3 gap-2 border-b border-white/5 pb-4 sm:hidden">
        {categories.map((cat: string) => (
          <button
            data-filter={cat}
            class="filter-btn cursor-pointer group relative flex items-center justify-center gap-1.5 overflow-hidden rounded-lg border border-white/20 bg-white/10 py-3 font-mono text-[9px] font-black tracking-wider text-slate-200 transition-all duration-200 active:border-lofi-mid/50 active:bg-lofi-mid/10 active:text-white"
            aria-label={`Filter by ${cat}`}
          >
            <!-- Flash Effect Shadow -->
            <span class="flash-effect absolute inset-0 -translate-x-full bg-lofi-mid/30 transition-transform duration-300 ease-out"></span>
            <span class="relative z-10 text-lofi-mid/50 text-[8px]">></span>
            <span class="relative z-10 uppercase truncate">{cat}</span>
            <!-- Active Indicator -->
            <div class="absolute bottom-0 left-0 h-[2px] w-0 bg-lofi-accent transition-all duration-500 marker-line"></div>
          </button>
        ))}
      </div>
    </div>


    <!-- The Rack Grid -->
    <div 
      id="tech-rack"
      class="reveal reveal-scale grid grid-cols-2 gap-3 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-4"
    >
      {
        techStack.map((tech: any, index: number) => (
          <div
            class="tech-card group relative overflow-hidden rounded-xl border border-white/5 bg-[#0A0A0A]/95 p-5 transition-all duration-500"
            data-category={tech.category}
            style={`transition-delay: ${index * 30}ms`}
          >
            <!-- Background Scanning Line (Triggered on reveal) -->
            <div class="tech-scan pointer-events-none absolute inset-0 -z-10 translate-y-[-100%] bg-gradient-to-b from-transparent via-lofi-pop/[0.15] to-transparent opacity-0"></div>

            <!-- LED Status Indicator -->
            <div class="absolute top-4 right-4 flex items-center gap-2">
                <span class="font-mono text-[7px] font-bold text-white/20 uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity">{t("stack.status.online")}</span>
                <div class={`h-1.5 w-1.5 rounded-full ${tech.tag === "OPTIMIZING" ? "bg-lofi-pop shadow-[0_0_10px_rgba(250,145,207,0.6)]" : "bg-emerald-500 shadow-[0_0_10px_rgba(16,185,129,0.6)]"} group-hover:animate-pulse`}></div>
            </div>

            <div class="flex items-start gap-4">
              <!-- Icon Container with Rotating Energy -->
              <div class="energy-border relative flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border border-white/5 bg-white/[0.03] group-hover:bg-lofi-accent/[0.05] transition-colors duration-500">
                <Icon
                  name={tech.icon}
                  class={`relative z-10 text-3xl ${tech.color} opacity-80 transition-all duration-500 group-hover:scale-110 group-hover:opacity-100 group-hover:drop-shadow-[0_0_20px_rgba(255,255,255,0.3)]`}
                />
              </div>

              <!-- Module Info -->
              <div class="flex flex-1 flex-col justify-center overflow-hidden">
                <div class="flex flex-col">
                  <span class="truncate font-mono text-[13px] font-black tracking-tighter text-white uppercase group-hover:text-lofi-accent transition-colors">
                    {tech.name}
                  </span>
                  <div class="mt-1 flex items-center gap-2">
                    <span class="flex-none rounded bg-black/80 px-2 py-0.5 font-mono text-[7px] font-bold tracking-widest text-lofi-soft uppercase border border-white/10">
                      {tech.role}
                    </span>
                  </div>
                </div>
                
                <div class="mt-4 flex flex-col gap-1">
                   <div class="flex items-center justify-between font-mono text-[8px] font-medium tracking-[0.2em] text-white/20 uppercase">
                      <span class="group-hover:text-white/40 transition-colors">{tech.category}</span>
                      <span class={`flex items-center gap-1 ${tech.tag === "OPTIMIZING" ? "text-lofi-pop/50" : "text-emerald-500/40"}`}>
                        <span class="inline-block h-1 w-1 rounded-full bg-current opacity-50"></span>
                        {tech.tag}
                      </span>
                   </div>
                </div>
              </div>
            </div>

            <!-- Holographic Overlays -->
            <div class="grid-bg pointer-events-none absolute inset-0 opacity-[0.05] bg-[radial-gradient(#ffffff,transparent_1px)] [background-size:12px_12px] group-hover:opacity-25 transition-opacity"></div>
            <div class="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-10 transition-opacity duration-700 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] bg-[length:100%_2px,3px_100%]"></div>
          </div>
        ))
      }
    </div>
    
    <!-- Mobile Integration Metadata -->
    <div class="reveal mt-12 flex flex-col items-center gap-6 lg:hidden">
       <button 
         id="initialize-full-stack"
         class="group relative flex items-center gap-3 overflow-hidden rounded-xl border border-white/10 bg-white/5 px-8 py-4 font-mono text-[10px] font-black tracking-[0.3em] text-white uppercase transition-all hover:border-lofi-accent/50 hover:bg-lofi-accent/10 active:scale-95"
      >
        <span class="relative z-10 text-lofi-accent opacity-40 group-hover:opacity-100 transition-colors">>_</span>
        <span class="relative z-10" id="expansion-text">LOAD_EXTENDED_PROTOCOL</span>
        <Icon name="tabler:cpu" size={16} class="relative z-10 text-lofi-accent opacity-50 group-hover:rotate-180 transition-transform duration-700" />
      </button>

      <div class="flex items-center gap-4 opacity-20">
         <div class="h-px w-8 bg-gradient-to-r from-transparent to-white"></div>
         <span class="font-mono text-[8px] tracking-[0.4em] uppercase">Architecture_Integrity_Verified</span>
         <div class="h-px w-8 bg-gradient-to-l from-transparent to-white"></div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Simplified Energy Border */
  .energy-border {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
  }
  
  .group:hover .energy-border {
    border-color: rgba(165, 166, 246, 0.3);
    box-shadow: 0 0 15px rgba(165, 166, 246, 0.1);
  }

  /* Filter Logic State Transitions */
  .tech-card {
  }

  /* Materialization Animation (Premium) */
  .animate-materialize {
    animation: materialize 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes materialize {
    from {
      opacity: 0;
      transform: scale(0.9) translateY(20px);
      filter: blur(15px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
      filter: blur(0);
    }
  }

  /* Active Filter Indicator */
  .marker-line.active {
    width: 100%;
    box-shadow: 0 0 15px rgba(165, 166, 246, 0.4);
  }

  .filter-btn.active-filter {
    border-color: rgba(165, 166, 246, 0.5);
    background: rgba(165, 166, 246, 0.05);
    color: white;
    box-shadow: 0 0 20px rgba(165, 166, 246, 0.1);
  }

  /* Flash Effect Logic */
  .flash-active .flash-effect {
    animation: flash-wave 0.5s ease-out forwards;
  }

  @keyframes flash-wave {
    0% { transform: translateX(-100%); opacity: 0; }
    50% { opacity: 1; }
    100% { transform: translateX(100%); opacity: 0; }
  }

  /* Scan Animation (Optimized to run once or on demand) */
  .run-scan {
    animation: scan-line 2.5s cubic-bezier(0.45, 0.05, 0.55, 0.95) forwards;
    opacity: 1;
  }

  @keyframes scan-line {
    0% { transform: translateY(-100%); opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { transform: translateY(100%); opacity: 0; }
  }

  .scrollbar-none::-webkit-scrollbar { display: none; }
  .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
  const setupTechStack = () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.tech-card');
    const rack = document.getElementById('tech-rack');
    
    // IntersectionObserver for Staggered Power-up
    const powerUpObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const visibleCards = Array.from(cards).filter(c => !c.classList.contains('hidden'));
          visibleCards.forEach((card, i) => {
            setTimeout(() => {
              card.classList.add('animate-materialize');
              const scanLine = card.querySelector('.tech-scan');
              scanLine?.classList.add('run-scan');
            }, i * 100);
          });
          powerUpObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });

    if (rack) powerUpObserver.observe(rack);

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        
        filterBtns.forEach(b => {
          const marker = b.querySelector('.marker-line');
          if (b === btn) {
            b.classList.add('text-white', 'flash-active', 'active-filter');
            marker?.classList.add('active');
            setTimeout(() => b.classList.remove('flash-active'), 500);
          } else {
            b.classList.remove('text-white', 'active-filter');
            marker?.classList.remove('active');
          }
        });

        let visibleCount = 0;
        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          const isMatch = filter === 'ALL' || category === filter;
          
          if (isMatch) {
            card.classList.remove('hidden');
            card.classList.remove('animate-materialize');
            const scanLine = card.querySelector('.tech-scan');
            scanLine?.classList.remove('run-scan');
            
            void (card as HTMLElement).offsetWidth;
            
            setTimeout(() => {
              (card as HTMLElement).style.animationDelay = `0ms`;
              card.classList.add('animate-materialize');
              scanLine?.classList.add('run-scan');
            }, visibleCount * 60);
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });

    const expansionBtn = document.getElementById('initialize-full-stack');
    const expansionText = document.getElementById('expansion-text');
    expansionBtn?.addEventListener('click', () => {
      if (expansionText) expansionText.textContent = "PROTOCOL_ESTABLISHED_";
      expansionBtn.classList.add('border-lofi-accent/50', 'bg-lofi-accent/20', 'text-lofi-accent');
    });
  };

  setupTechStack();
  document.addEventListener("astro:after-swap", setupTechStack);
</script>
