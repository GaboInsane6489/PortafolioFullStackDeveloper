---
import { Icon } from "astro-icon/components";
---

<section
  class="relative border-t border-white/5 py-16 md:py-24 lg:py-32"
  id="about-me"
>
  <div
    class="pointer-events-none absolute inset-0 [background-image:radial-gradient(rgba(252,211,77,0.03)_1px,transparent_1px)] [mask-image:linear-gradient(180deg,white,transparent)] [background-size:24px_24px] opacity-40"
  >
  </div>

  <div class="relative mx-auto w-full max-w-[1100px] px-6 sm:px-12 lg:px-16">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="space-y-8 lg:col-span-7">
        <div class="space-y-4">
          <div class="reveal flex items-center gap-3">
            <div class="h-px w-8 bg-amber-300/60"></div>
            <span
              class="text-[9px] font-bold tracking-[0.4em] text-amber-300/80 uppercase"
            >
              Professional Summary
            </span>
          </div>

          <h2
            class="reveal font-serif text-4xl leading-[1.1] tracking-tighter text-white delay-100 md:text-6xl lg:text-7xl"
          >
            Engineering with structure,
            <br />
            <span class="font-light text-white/30 italic"
              >not improvisation.</span
            >
          </h2>
        </div>

        <div
          class="reveal space-y-4 text-base leading-relaxed text-gray-400 delay-200 md:text-lg"
        >
          <p>
            I am a <span class="font-medium text-white"
              >Full Stack Developer</span
            > focused on building modern, maintainable, and performance-oriented web
            applications.
          </p>
          <p>
            Through my work on projects like <span
              class="font-medium text-amber-200/90 underline decoration-amber-500/20 underline-offset-4"
              >Instalaciones García</span
            >, I've mastered the art of shipping features in production.
          </p>
        </div>

        <div class="flex flex-wrap gap-2 pt-2">
          {
            [
              "Code Reviews",
              "PR Strategies",
              "CI/CD",
              "Clean Architecture",
            ].map((tag, index) => (
              <span
                class="reveal rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[9px] font-bold tracking-widest text-amber-200/60 uppercase backdrop-blur-sm"
                style={`transition-delay: ${(index + 4) * 100}ms`}
              >
                {tag}
              </span>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col justify-center space-y-6 lg:col-span-5 lg:pb-4">
        <div
          class="reveal reveal-right space-y-5 border-l border-amber-900/30 pl-6 delay-500"
        >
          {
            [
              { label: "Location", value: "Caracas, Venezuela" },
              { label: "Philosophy", value: "Scalable Systems" },
              { label: "Availability", value: "Remote / Global" },
            ].map((item) => (
              <div class="group cursor-default">
                <p class="text-[9px] font-black tracking-widest text-amber-600/60 uppercase">
                  {item.label}
                </p>
                <p class="text-base text-white/70 italic transition-colors group-hover:text-amber-300 md:text-lg">
                  {item.value}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="reveal reveal-scale group relative mt-16 delay-700">
      <div
        class="absolute -inset-4 -z-10 rounded-[3rem] bg-gradient-to-b from-amber-500/5 to-transparent opacity-0 blur-3xl transition-opacity duration-700 group-hover:opacity-100"
      >
      </div>

      <div
        class="overflow-hidden rounded-xl border border-white/10 bg-[#1A1513] shadow-2xl"
      >
        <div class="flex h-9 items-center justify-between bg-[#241C19] px-4">
          <div class="flex items-center gap-4">
            <div class="flex gap-1.5">
              <div class="h-2.5 w-2.5 rounded-full bg-[#ef9f76]/40"></div>
              <div class="h-2.5 w-2.5 rounded-full bg-[#e5c890]/40"></div>
              <div class="h-2.5 w-2.5 rounded-full bg-[#a6d189]/40"></div>
            </div>
            <div
              class="flex h-9 items-center gap-1.5 border-t border-t-amber-500/50 bg-[#1A1513] px-3"
            >
              <Icon
                name="tabler:brand-typescript"
                size={12}
                class="text-[#8caaee]"
              />
              <span class="font-mono text-[10px] text-[#c6d0f5]"
                >AboutMe.tsx</span
              >
            </div>
          </div>
          <span class="hidden font-mono text-[9px] text-white/20 md:block">
            GaboDev — Studio Code</span
          >
        </div>

        <div class="relative aspect-video lg:aspect-auto">
          <div
            class="absolute top-0 bottom-0 left-0 flex w-10 flex-col items-center space-y-1 bg-black/20 pt-4 font-mono text-[9px] text-white/5 select-none"
          >
            {Array.from({ length: 8 }).map((_, i) => <span>{i + 104}</span>)}
          </div>

          <video
            src="/videos/Programando.mp4"
            class="h-full w-full object-cover pl-10 transition-all duration-700 group-hover:brightness-110"
            autoplay
            loop
            muted
            playsinline></video>
        </div>
      </div>

      <div
        class="reveal reveal-right absolute -right-4 -bottom-4 hidden rounded-lg border border-white/10 bg-[#1A1513]/95 p-4 shadow-2xl backdrop-blur-xl delay-1000 md:block lg:-right-6 lg:-bottom-6"
      >
        <p class="font-serif text-lg leading-tight text-[#eebebe] italic">
          "Writing code is easy.<br />Building systems is the craft."
        </p>
      </div>
    </div>
  </div>
</section>
