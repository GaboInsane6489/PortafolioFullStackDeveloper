---
import { Icon } from "astro-icon/components";

const sections = [
  { label: "Home", href: "#hero", icon: "tabler:home" },
  { label: "About", href: "#about-me", icon: "tabler:user" },
  { label: "Projects", href: "#projects", icon: "tabler:folder" },
  { label: "Experience", href: "#experience", icon: "tabler:briefcase" },
  { label: "Stack", href: "#tech-stack", icon: "tabler:cpu" },
  { label: "Contact", href: "#contact", icon: "tabler:mail" },
];
---

<aside class="fixed left-6 top-1/2 z-40 hidden -translate-y-1/2 flex-col items-center gap-6 md:flex">
  <!-- Navigation Dock -->
  <nav class="glass-panel flex flex-col items-center gap-2 rounded-2xl p-2">
    {
      sections.map((section) => (
        <a
          href={section.href}
          id={`nav-${section.href.replace("#", "")}`}
          class="nav-link group relative flex h-10 w-10 items-center justify-center rounded-xl text-gray-400 transition-all hover:bg-white/10 hover:text-white"
          data-section={section.href.replace("#", "")}
          aria-label={section.label}
        >
          <Icon
            name={section.icon}
            size={20}
            class="transition-transform group-hover:scale-110"
          />

          <!-- Tooltip -->
          <div class="pointer-events-none absolute left-14 z-50 rounded-md border border-white/10 bg-[#0A0908] px-3 py-1.5 opacity-0 shadow-xl transition-all duration-300 group-hover:left-12 group-hover:opacity-100">
            <span class="whitespace-nowrap font-mono text-[10px] font-bold tracking-widest text-gray-300 uppercase">
              {section.label}
            </span>
            <!-- Arrow -->
            <div class="absolute -left-1 top-1/2 h-2 w-2 -translate-y-1/2 rotate-45 border-b border-l border-white/10 bg-[#0A0908]"></div>
          </div>

          <!-- Active Indicator -->
          <div class="active-indicator absolute -left-1 h-3 w-1 opacity-0 rounded-r-full bg-amber-500 transition-all duration-300"></div>
        </a>
      ))
    }
  </nav>

  <!-- Source Code / Config -->
  <div class="glass-panel flex flex-col items-center gap-2 rounded-2xl p-2">
    <a 
      href="https://github.com/GaboInsane6489" 
      target="_blank"
      class="group relative flex h-10 w-10 items-center justify-center rounded-xl text-gray-400 transition-all hover:bg-white/10 hover:text-white" 
      aria-label="View Source"
    >
      <Icon name="tabler:code" size={20} />
      
      <!-- Tooltip -->
      <div class="pointer-events-none absolute left-14 z-50 rounded-md border border-white/10 bg-[#0A0908] px-3 py-1.5 opacity-0 shadow-xl transition-all duration-300 group-hover:left-12 group-hover:opacity-100">
        <span class="whitespace-nowrap font-mono text-[10px] font-bold tracking-widest text-gray-300 uppercase">
          Source
        </span>
        <!-- Arrow -->
         <div class="absolute -left-1 top-1/2 h-2 w-2 -translate-y-1/2 rotate-45 border-b border-l border-white/10 bg-[#0A0908]"></div>
      </div>
    </a>
  </div>
</aside>

<script>
  function initScrollSpy() {
    const observerOptions = {
      root: null,
      rootMargin: "-20% 0px -60% 0px",
      threshold: 0,
    };

    const updateActiveState = (id: string | null) => {
      if (!id) return;

      document.querySelectorAll(".nav-link").forEach((link) => {
        const isCurrent = link.getAttribute("data-section") === id;
        
        // Visual state updates
        link.classList.toggle("text-amber-400", isCurrent);
        link.classList.toggle("bg-white/5", isCurrent); // Active background
        link.classList.toggle("text-gray-400", !isCurrent);

        const indicator = link.querySelector(".active-indicator") as HTMLElement | null;
        if (indicator) {
          indicator.style.opacity = isCurrent ? "1" : "0";
          indicator.style.height = isCurrent ? "20px" : "0px";
        }
      });
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          updateActiveState(entry.target.id);
        }
      });
    }, observerOptions);

    document.querySelectorAll("section[id]").forEach((section) => {
      observer.observe(section);
    });
  }

  // Run on load and after Astro swaps
  initScrollSpy();
  document.addEventListener("astro:after-swap", initScrollSpy);
</script>
