---
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
import { Icon } from "astro-icon/components";
import EmblaCarousel from "../components/EmblaCarousel.astro";

const luzInteriorImages = Array.from(
  { length: 11 },
  (_, i) => `/images/LuzInterior${i + 1}.webp`,
);

const InstalacionesGarciasImages = Array.from(
  { length: 13 },
  (_, i) => `/images/InstalacionesGarcias${i + 1}.webp`,
);

const HarryPotterHeadForumImages = Array.from(
  { length: 15 },
  (_, i) => `/images/HarryPotterHead${i + 1}.webp`,
);
---

<PortfolioLayout>
  <!-- ===================================================== -->
  <!-- HERO / PROFILE -->
  <!-- ===================================================== -->
  <section
    class="relative w-full overflow-hidden border-t border-white/5 py-32 lg:py-48"
    id="hero"
  >
    <div
      class="absolute inset-0 [background-image:radial-gradient(rgba(252,211,77,0.03)_1px,transparent_1px)] [background-size:40px_40px] opacity-60"
    >
    </div>

    <div
      class="absolute top-1/4 left-0 -z-10 h-[400px] w-[400px] rounded-full bg-amber-500/5 blur-[120px]"
    >
    </div>

    <div
      class="relative mx-auto w-full max-w-[1300px] px-8 sm:px-12 lg:px-16 xl:px-20"
    >
      <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-12">
        <div class="space-y-10 lg:col-span-7">
          <div class="space-y-6">
            <div class="flex items-center gap-4">
              <div class="h-px w-12 bg-amber-400/40"></div>
              <span
                class="text-[10px] font-black tracking-[0.6em] text-amber-400/60 uppercase"
              >
                Full Stack Developer Junior
              </span>
            </div>

            <h1
              class="font-serif text-6xl leading-[0.85] tracking-tighter text-white sm:text-7xl xl:text-9xl"
            >
              Gabriel <span class="font-light text-white/40 italic"
                >González</span
              >
              <br />
              <span
                class="font-sans text-3xl tracking-tight text-amber-200/40 italic sm:text-4xl xl:text-5xl"
              >
                Building scalable digital systems
              </span>
            </h1>
          </div>

          <p
            class="max-w-xl text-lg leading-relaxed text-gray-400/80 md:text-xl"
          >
            I bridge the gap between <span class="text-white"
              >clean architecture</span
            > and high-quality user experiences. Specializing in modern, performance-oriented
            applications that scale.
          </p>

          <div class="flex flex-wrap items-center gap-8 pt-4">
            <div class="flex gap-4">
              <a
                href="#projects"
                class="group relative overflow-hidden rounded-full bg-white px-8 py-3 text-sm font-bold text-black transition-all hover:bg-amber-300"
              >
                <span class="relative z-10">View Projects</span>
              </a>
              <a
                href="#contact"
                class="rounded-full border border-white/10 bg-white/5 px-8 py-3 text-sm font-bold text-white transition-all hover:bg-white/10"
              >
                Contact
              </a>
            </div>
            <div class="hidden h-px w-12 bg-white/10 md:block"></div>
            <div class="flex gap-4 text-gray-500">
              <span
                class="text-[10px] font-black tracking-widest uppercase italic"
                >Available for remote</span
              >
            </div>
          </div>
        </div>

        <div class="flex justify-center lg:col-span-5 lg:justify-end">
          <div class="group relative">
            <div
              class="absolute -inset-8 -z-10 translate-x-6 translate-y-6 border border-amber-500/10 transition-all duration-1000 group-hover:translate-x-0 group-hover:translate-y-0"
            >
            </div>

            <div
              class="animate-bounce-slow absolute top-10 -left-12 z-20 hidden lg:block"
            >
              <div
                class="rounded-lg border border-white/10 bg-zinc-900/90 p-3 shadow-2xl backdrop-blur-md"
              >
                <div class="mb-2 flex gap-1.5">
                  <div class="h-1.5 w-1.5 rounded-full bg-red-500/40"></div>
                  <div class="h-1.5 w-1.5 rounded-full bg-amber-500/40"></div>
                </div>
                <code class="font-mono text-[10px] text-amber-200/50"
                  >portfolio.config.js</code
                >
              </div>
            </div>

            <div
              class="relative overflow-hidden border border-white/10 bg-zinc-900 shadow-2xl transition-all duration-700 group-hover:border-amber-500/30"
            >
              <div
                class="absolute inset-0 z-10 bg-amber-900/10 mix-blend-color transition-colors duration-700 group-hover:bg-transparent"
              >
              </div>

              <img
                src="/images/FotoPerfil.webp"
                alt="Gabriel González"
                class="w-[300px] contrast-[1.1] grayscale-[40%] transition-all duration-700 group-hover:scale-105 group-hover:grayscale-0 sm:w-[340px] md:w-[380px]"
                loading="lazy"
              />

              <div
                class="absolute inset-x-0 bottom-0 z-20 h-24 bg-gradient-to-t from-zinc-950 to-transparent"
              >
              </div>
            </div>

            <div
              class="absolute -right-4 -bottom-4 z-30 bg-amber-500 px-4 py-1 text-[9px] font-black tracking-[0.2em] text-black uppercase"
            >
              Full Stack Junior Developer_
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    @keyframes bounce-slow {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-10px);
      }
    }
    .animate-bounce-slow {
      animation: bounce-slow 4s ease-in-out infinite;
    }
  </style>

  <!-- ===================================================== -->
  <!-- ABOUT ME -->
  <!-- ===================================================== -->
  <section
    class="relative border-t border-white/5 py-32 lg:py-48"
    id="about-me"
  >
    <div
      class="absolute inset-0 [background-image:radial-gradient(rgba(252,211,77,0.05)_1px,transparent_1px)] [mask-image:linear-gradient(180deg,white,transparent)] [background-size:32px_32px] opacity-40"
    >
    </div>

    <div class="relative mx-auto w-full max-w-[1100px] px-8 sm:px-12 lg:px-16">
      <div class="grid grid-cols-1 gap-20 lg:grid-cols-12">
        <div class="space-y-12 lg:col-span-7">
          <div class="space-y-6">
            <div class="flex items-center gap-4">
              <div class="h-px w-12 bg-amber-300/60"></div>
              <span
                class="text-[10px] font-bold tracking-[0.6em] text-amber-300/80 uppercase"
                >Professional Summary</span
              >
            </div>

            <h2
              class="font-serif text-5xl leading-tight tracking-tighter text-white md:text-7xl"
            >
              Engineering with structure,
              <br />
              <span class="font-light text-white/40 italic"
                >not improvisation.</span
              >
            </h2>
          </div>

          <div class="space-y-6 text-lg leading-relaxed text-gray-400">
            <p>
              I am a <span class="font-medium text-white"
                >Full Stack Developer</span
              > focused on building modern, maintainable, and performance-oriented
              web applications. I bridge the gap between complex backend logic and
              intuitive frontend experiences.
            </p>
            <p>
              Through my work on projects like <span
                class="font-medium text-amber-200/90">Instalaciones García</span
              > and the <span class="font-medium text-amber-200/90"
                >Harry Potter Forum</span
              >, I've mastered the art of shipping features in production
              environments.
            </p>
          </div>

          <div class="flex flex-wrap gap-3 pt-4">
            {
              [
                "Code Reviews",
                "PR Strategies",
                "CI/CD",
                "Clean Architecture",
              ].map((tag) => (
                <span class="rounded-full border border-white/10 bg-[#4D4543]/40 px-4 py-1 text-[11px] font-bold tracking-widest text-amber-200/60 uppercase backdrop-blur-sm">
                  {tag}
                </span>
              ))
            }
          </div>
        </div>

        <div class="flex flex-col justify-end space-y-8 lg:col-span-5 lg:pb-4">
          <div class="space-y-4 border-l border-amber-900/30 pl-8">
            {
              [
                { label: "Location", value: "Caracas, Venezuela" },
                { label: "Philosophy", value: "Scalable & Organized Scale" },
                { label: "Availability", value: "Open to Remote / Global" },
              ].map((item) => (
                <div class="group">
                  <p class="text-[10px] font-black tracking-widest text-amber-600/60 uppercase">
                    {item.label}
                  </p>
                  <p class="text-lg text-white/70 italic transition-colors group-hover:text-amber-300">
                    {item.value}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="group relative mt-24">
        <div
          class="absolute -inset-4 -z-10 rounded-[3rem] bg-gradient-to-b from-[#4D4543]/20 to-transparent opacity-0 blur-3xl transition-opacity duration-700 group-hover:opacity-100"
        >
        </div>

        <div
          class="overflow-hidden rounded-xl border border-[#4D4543] bg-[#2C2421] shadow-[0_20px_50px_rgba(0,0,0,0.5)]"
        >
          <div class="flex h-10 items-center justify-between bg-[#241C19] px-4">
            <div class="flex items-center gap-5">
              <div class="flex gap-1.5">
                <div class="h-3 w-3 rounded-full bg-[#ef9f76]/50"></div>
                <div class="h-3 w-3 rounded-full bg-[#e5c890]/50"></div>
                <div class="h-3 w-3 rounded-full bg-[#a6d189]/50"></div>
              </div>
              <div
                class="flex h-10 items-center gap-1 border-t border-t-[#ef9f76] bg-[#2C2421] px-4 py-2"
              >
                <Icon
                  name="tabler:brand-typescript"
                  size={14}
                  class="text-[#8caaee]"
                />
                <span class="font-mono text-[11px] text-[#c6d0f5]"
                  >AboutMe.tsx</span
                >
              </div>
            </div>
            <span
              class="hidden font-mono text-[10px] tracking-tight text-white/20 sm:block"
            >
              GaboDev — Visual Studio Code
            </span>
            <div class="flex gap-3 text-white/30">
              <Icon name="tabler:layout-sidebar-left-collapse" size={16} />
              <Icon name="tabler:layout-bottombar-collapse" size={16} />
            </div>
          </div>

          <div class="relative">
            <div
              class="absolute top-0 bottom-0 left-0 flex w-12 flex-col items-center space-y-1 bg-[#241C19]/50 pt-4 font-mono text-[10px] text-white/10 select-none"
            >
              {Array.from({ length: 12 }).map((_, i) => <span>{i + 104}</span>)}
            </div>

            <video
              src="/videos/Programando.mp4"
              class="w-full object-cover pl-12 transition-all duration-700 group-hover:brightness-110"
              autoplay
              loop
              muted></video>

            <div
              class="pointer-events-none absolute inset-0 border-t border-white/5"
            >
            </div>
          </div>
        </div>

        <div
          class="absolute -right-6 -bottom-6 hidden rounded-xl border border-[#4D4543] bg-[#2C2421]/95 p-6 shadow-2xl backdrop-blur-xl lg:block"
        >
          <p class="font-serif text-xl text-[#eebebe] italic">
            "Writing code is easy.<br />Building systems is the craft."
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================== -->
  <!-- FEATURED PROJECT -->
  <!-- ===================================================== -->
  <section
    id="projects"
    class="relative overflow-hidden border-t border-white/5 py-24 lg:py-32"
  >
    <div
      class="absolute inset-0 [background-image:linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] [background-size:14px_24px]"
    >
    </div>

    <div class="relative mx-auto max-w-[1200px] px-8 sm:px-12 lg:px-16">
      <header class="grid grid-cols-1 items-end gap-12 lg:grid-cols-12">
        <div class="space-y-8 lg:col-span-8">
          <div class="flex items-center gap-6">
            <div class="h-[1px] w-12 bg-blue-400/40"></div>
            <span
              class="text-[10px] font-black tracking-[0.8em] text-blue-400/60 uppercase"
            >
              Featured Case Study
            </span>
          </div>

          <h2
            class="font-serif text-7xl leading-[0.9] tracking-tighter text-white md:text-9xl"
          >
            Luz Interior
          </h2>

          <p class="max-w-2xl text-xl leading-relaxed font-light text-gray-400">
            Engineered a <span class="text-white"
              >structured digital platform</span
            > emphasizing atomic design principles. A high-performance ecosystem built
            for seamless scalability and modular logic.
          </p>
        </div>

        <div class="space-y-6 border-l border-white/10 pb-2 pl-8 lg:col-span-4">
          <div>
            <p
              class="text-[10px] font-bold tracking-[0.3em] text-white/20 uppercase"
            >
              Core Architecture
            </p>
            <p class="mt-1 font-serif text-sm text-gray-400 italic">
              Modular & Scalable System
            </p>
          </div>
          <div>
            <p
              class="text-[10px] font-bold tracking-[0.3em] text-white/20 uppercase"
            >
              Status
            </p>
            <div class="mt-2 flex items-center gap-2">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500"
              ></span>
              <p class="text-sm font-medium tracking-wide text-gray-400">
                Production Ready
              </p>
            </div>
          </div>
        </div>
      </header>

      <div class="mt-20 flex flex-wrap gap-3">
        {
          [
            {
              name: "React",
              icon: "tabler:brand-react",
              color: "text-blue-400",
            },
            {
              name: "TypeScript",
              icon: "tabler:brand-typescript",
              color: "text-blue-500",
            },
            {
              name: "Supabase",
              icon: "tabler:brand-supabase",
              color: "text-emerald-500",
            },
            {
              name: "Tailwind",
              icon: "tabler:brand-tailwind",
              color: "text-cyan-400",
            },
            {
              name: "Vercel",
              icon: "tabler:brand-vercel",
              color: "text-white",
            },
          ].map((tech) => (
            <div class="group flex items-center gap-2.5 rounded-full border border-white/5 bg-white/[0.03] px-5 py-2 text-xs font-medium text-gray-400 backdrop-blur-md transition-all hover:border-blue-500/30 hover:bg-blue-500/5">
              <Icon
                name={tech.icon}
                class={`${tech.color} opacity-60 transition-opacity group-hover:opacity-100`}
                size={18}
              />
              <span>{tech.name}</span>
            </div>
          ))
        }
      </div>

      <div class="group relative mt-16">
        <div
          class="absolute inset-0 -z-10 scale-75 rounded-full bg-blue-500/5 blur-[120px]"
        >
        </div>

        <EmblaCarousel images={luzInteriorImages} />
      </div>
    </div>
  </section>

  <section
    id="instalaciones-garcia"
    class="relative border-t border-white/5 py-16 lg:py-24"
  >
    <div class="mx-auto max-w-[1200px] px-8 sm:px-12 lg:px-16">
      <header class="max-w-4xl">
        <div class="mb-12 flex items-center gap-6">
          <div class="h-[1px] w-12 bg-emerald-500/30"></div>
          <span
            class="text-[10px] font-bold tracking-[0.8em] text-gray-500 uppercase"
          >
            Enterprise Solution
          </span>
        </div>

        <h2
          class="font-serif text-6xl leading-[1.05] tracking-tighter text-white md:text-8xl"
        >
          Instalaciones García
          <span
            class="mt-6 block font-sans text-xl font-light tracking-normal text-white/30 italic md:text-3xl"
          >
            Service management system for a real company.
          </span>
        </h2>

        <div class="mt-16 grid grid-cols-1 gap-12 md:grid-cols-2 md:items-end">
          <p class="text-lg leading-relaxed text-gray-400/80 lg:text-xl">
            Developed a comprehensive ERP-lite platform tailored for
            infrastructure services. The solution centralizes service tracking,
            automates client workflows, and optimizes real-time resource
            communication.
          </p>

          <div
            class="h-fit border-l border-white/10 pl-8 md:border-r md:border-l-0 md:pr-8 md:pl-0 md:text-right"
          >
            <p
              class="text-[10px] font-bold tracking-[0.3em] text-white/20 uppercase"
            >
              Project Role
            </p>
            <p class="mt-2 text-sm font-medium tracking-wide text-gray-400">
              Lead Product Engineer
            </p>
          </div>
        </div>
      </header>

      <div class="mt-24 border-y border-white/5 py-10">
        <h3
          class="mb-8 text-center font-serif text-xs tracking-[0.3em] text-white/30 uppercase"
        >
          Technical Ecosystem
        </h3>
        <ul class="flex flex-wrap justify-center gap-4">
          {
            [
              { name: "Astro", icon: "tabler:brand-astro" },
              { name: "JavaScript", icon: "tabler:brand-javascript" },
              { name: "React", icon: "tabler:brand-react" },
              { name: "TailwindCSS", icon: "tabler:brand-tailwind" },
              { name: "Supabase", icon: "tabler:brand-supabase" },
              { name: "Vercel", icon: "tabler:brand-vercel" },
            ].map((tech) => (
              <li class="flex items-center gap-3 rounded-xl border border-white/5 bg-white/[0.02] px-6 py-3.5 text-sm text-gray-400 backdrop-blur-sm transition-all hover:border-emerald-500/20 hover:bg-white/[0.05] hover:text-white">
                <Icon name={tech.icon} class="opacity-70" size="20" />
                <span class="font-medium tracking-wide">{tech.name}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="group relative mt-12">
        <div
          class="absolute inset-0 -z-10 mx-auto max-w-5xl translate-y-12 rounded-full bg-emerald-600/[0.03] blur-[140px]"
        >
        </div>

        <div
          class="relative z-10 mx-auto max-w-5xl transition-transform duration-700 ease-in-out group-hover:scale-[1.01]"
        >
          <EmblaCarousel images={InstalacionesGarciasImages} />
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================== -->
  <!-- Experience -->
  <!-- ===================================================== -->
  <section
    id="experience"
    class="relative border-t border-white/5 py-16 lg:py-24"
  >
    <div class="mx-auto max-w-[1200px] px-8 sm:px-12 lg:px-16">
      <header class="max-w-4xl">
        <div class="mb-12 flex items-center gap-6">
          <div class="h-[1px] w-12 bg-indigo-500/40"></div>
          <span
            class="text-[10px] font-bold tracking-[0.8em] text-gray-500 uppercase"
          >
            Professional Experience
          </span>
        </div>

        <h2
          class="font-serif text-6xl leading-[1.05] tracking-tighter text-white md:text-8xl"
        >
          Harry Potter Head Forum
          <span
            class="mt-6 block font-sans text-xl font-light tracking-normal text-white/30 italic md:text-3xl"
          >
            High-traffic production environment & community management.
          </span>
        </h2>

        <div class="mt-16 grid grid-cols-1 gap-12 md:grid-cols-2 md:items-end">
          <p class="text-lg leading-relaxed text-gray-400/80 lg:text-xl">
            Contributed to a live ecosystem, mastering professional workflows:
            from ticket-driven development and branching strategies to code
            reviews and controlled production deployments.
          </p>

          <div
            class="h-fit border-l border-white/10 pl-8 md:border-r md:border-l-0 md:pr-8 md:pl-0 md:text-right"
          >
            <p
              class="text-[10px] font-bold tracking-[0.3em] text-white/20 uppercase"
            >
              Core Focus
            </p>
            <p class="mt-2 text-sm font-medium tracking-wide text-gray-400">
              Full Stack Development & DevOps
            </p>
          </div>
        </div>
      </header>

      <div class="mt-24 border-y border-white/5 py-10">
        <h3
          class="mb-8 text-center font-serif text-xs tracking-[0.3em] text-white/30 uppercase"
        >
          Professional Toolchain
        </h3>
        <ul class="flex flex-wrap justify-center gap-4">
          {
            [
              { name: "PHP", icon: "tabler:brand-php" },
              { name: "Laravel", icon: "tabler:brand-laravel" },
              { name: "MySQL", icon: "tabler:brand-mysql" },
              { name: "Git", icon: "tabler:brand-git" },
              { name: "JavaScript", icon: "tabler:brand-javascript" },
              { name: "React", icon: "tabler:brand-react" },
              { name: "TailwindCSS", icon: "tabler:brand-tailwind" },
              { name: "Supabase", icon: "tabler:brand-supabase" },
              { name: "Vercel", icon: "tabler:brand-vercel" },
            ].map((tech) => (
              <li class="flex items-center gap-3 rounded-xl border border-white/5 bg-white/[0.02] px-6 py-3.5 text-sm text-gray-400 backdrop-blur-sm transition-all hover:border-indigo-500/20 hover:bg-white/[0.05] hover:text-white">
                <Icon name={tech.icon} class="opacity-70" size={20} />
                <span class="font-medium tracking-wide">{tech.name}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="group relative mt-12">
        <div
          class="absolute inset-0 -z-10 mx-auto max-w-5xl translate-y-12 rounded-full bg-indigo-600/[0.04] blur-[140px]"
        >
        </div>

        <div
          class="relative z-10 mx-auto max-w-5xl transition-transform duration-700 ease-in-out group-hover:scale-[1.01]"
        >
          <EmblaCarousel images={HarryPotterHeadForumImages} />
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================== -->
  <!-- ENGINEERING / OPEN SOURCE / STACK / FOUNDATION -->
  <!-- ===================================================== -->

  <!-- ================= ENGINEERING & OPEN SOURCE ================= -->
  <section
    id="engineering"
    class="relative overflow-hidden border-t border-white/5 py-36"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_10%,rgba(255,255,255,0.04),transparent_60%)]"
    >
    </div>

    <div class="relative mx-auto w-full max-w-[1300px] px-6 sm:px-12 lg:px-20">
      <!-- HEADER -->
      <header class="max-w-4xl space-y-10">
        <div class="flex items-center gap-4">
          <div class="h-px w-12 bg-white"></div>
          <span
            class="text-[10px] font-bold tracking-[0.6em] text-white/60 uppercase"
          >
            Engineering & Open Source
          </span>
        </div>

        <h2
          class="font-serif text-4xl leading-[0.95] tracking-tight text-white/80 md:text-6xl"
        >
          Code is not just written.
          <br />
          <span class="font-light text-white/40 italic">
            It is architected, documented and maintained.
          </span>
        </h2>

        <p class="max-w-2xl text-lg leading-relaxed text-gray-400">
          My GitHub reflects structured repositories, production-grade
          documentation, scalable architectural decisions and disciplined
          contribution patterns.
        </p>
      </header>

      <!-- GITHUB GRID -->
      <div class="mt-24 grid gap-20 lg:grid-cols-2">
        <article class="group space-y-8">
          <div class="flex items-center gap-4">
