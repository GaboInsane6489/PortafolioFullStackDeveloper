---
import { Icon } from "astro-icon/components";
import EmblaCarousel from "../EmblaCarousel.astro";

const HarryPotterHeadForumImages = Array.from(
  { length: 15 },
  (_, i) => `/images/HarryPotterHead${i + 1}.webp`,
);
---

<section
  id="experience"
  class="relative border-t border-white/5 py-24 lg:py-40"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(252,211,77,0.02),transparent_50%)]"
  >
  </div>

  <div class="relative mx-auto w-full max-w-[1400px] px-6">
    <div class="grid grid-cols-1 gap-16 lg:grid-cols-12">
      <div class="space-y-6 lg:sticky lg:top-32 lg:col-span-4 lg:h-fit">
        <div class="reveal flex items-center gap-3">
          <span class="h-[1px] w-8 bg-amber-500/40"></span>
          <span
            class="font-mono text-[10px] font-bold tracking-[0.3em] text-amber-500 uppercase"
          >
            Career Path
          </span>
        </div>
        <h2
          class="reveal font-serif text-5xl leading-tight text-white md:text-6xl"
        >
          Professional <br class="hidden lg:block" />
          <span class="text-white/30 italic">Timeline</span>
        </h2>
        <p
          class="reveal max-w-sm text-lg leading-relaxed font-light text-gray-500"
        >
          A chronological log of my development journey, from academic
          foundation to leading <span class="text-white/60"
            >production-grade systems</span
          >.
        </p>
      </div>

      <div
        class="relative ml-4 space-y-20 border-l border-white/10 pl-10 md:pl-16 lg:col-span-8 lg:ml-0"
      >
        <div class="reveal reveal-right group relative">
          <div
            class="absolute top-2 -left-[50px] h-4 w-4 rounded-full border-2 border-amber-500 bg-[#0A0908] transition-transform duration-500 group-hover:scale-125 lg:-left-[74px] lg:h-6 lg:w-6"
          >
            <span
              class="absolute inset-0 animate-ping rounded-full bg-amber-500/40"
            ></span>
            <span class="absolute inset-1 rounded-full bg-amber-500"></span>
          </div>

          <div class="space-y-4">
            <div
              class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"
            >
              <h3
                class="font-serif text-2xl text-white transition-colors group-hover:text-amber-400 md:text-3xl"
              >
                Lead Product Engineer
              </h3>
              <span
                class="w-fit rounded-full border border-amber-500/20 bg-amber-500/5 px-3 py-1 font-mono text-[10px] font-bold tracking-tighter text-amber-500"
              >
                2024 — PRESENT
              </span>
            </div>
            <div class="flex items-center gap-2 text-gray-400">
              <Icon
                name="tabler:briefcase"
                size={18}
                class="text-amber-500/50"
              />
              <span class="font-medium">Instalaciones García</span>
            </div>
            <p
              class="max-w-2xl text-base leading-relaxed text-gray-500 md:text-lg"
            >
              Spearheaded the development of a custom ERP solution. Transitioned
              the company from manual spreadsheet workflows to a <strong
                class="text-base font-medium text-white/80"
                >fully digital, cloud-based ecosystem</strong
              > using React and Supabase.
            </p>
          </div>
        </div>

        <div class="reveal reveal-right group relative delay-100">
          <div
            class="absolute top-2 -left-[50px] h-4 w-4 rounded-full border-2 border-white/20 bg-[#0A0908] transition-all duration-500 group-hover:border-amber-500 lg:-left-[74px] lg:h-6 lg:w-6"
          >
          </div>

          <div class="space-y-6">
            <div class="space-y-4">
              <div
                class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"
              >
                <h3
                  class="font-serif text-2xl text-white transition-colors group-hover:text-white md:text-3xl"
                >
                  Full Stack & DevOps
                </h3>
                <span
                  class="w-fit rounded-full border border-white/10 bg-white/5 px-3 py-1 font-mono text-[10px] font-bold text-gray-500"
                >
                  2023 — 2024
                </span>
              </div>
              <h4 class="text-lg text-gray-400">Harry Potter Head Forum</h4>
              <p
                class="max-w-2xl text-base leading-relaxed text-gray-500 md:text-lg"
              >
                Orchestrated the engineering of a community platform with <span
                  class="text-white/60">20k+ daily users</span
                >. Architected CI/CD pipelines and optimized queries by 40%.
              </p>
            </div>

            <div
              class="reveal reveal-scale mt-6 max-w-2xl overflow-hidden rounded-2xl border border-white/10 bg-black shadow-2xl transition-transform duration-500 group-hover:scale-[1.01]"
            >
              <div class="aspect-video sm:aspect-auto">
                <EmblaCarousel images={HarryPotterHeadForumImages} />
              </div>
              <div
                class="flex items-center justify-between bg-[#0A0908] px-5 py-3 text-[10px] font-bold tracking-[0.2em] text-gray-600 uppercase"
              >
                <span class="flex items-center gap-2 italic">
                  <Icon name="tabler:archive" size={14} /> Legacy System Archive
                </span>
                <span class="opacity-40">v2.4.0</span>
              </div>
            </div>
          </div>
        </div>

        <div class="reveal reveal-right group relative delay-200">
          <div
            class="absolute top-2 -left-[50px] h-4 w-4 rounded-full border-2 border-white/20 bg-[#0A0908] transition-all group-hover:border-amber-500/50 lg:-left-[74px] lg:h-6 lg:w-6"
          >
          </div>
          <div class="space-y-3">
            <div
              class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"
            >
              <h3 class="font-serif text-2xl text-white md:text-3xl">
                Computer Engineering
              </h3>
              <span
                class="w-fit rounded-full border border-blue-500/20 bg-blue-500/5 px-3 py-1 font-mono text-[10px] font-bold text-blue-400"
              >
                UCAB • 3RD SEMESTER
              </span>
            </div>
            <p
              class="max-w-2xl text-base leading-relaxed text-gray-500 italic md:text-lg"
            >
              Deepening knowledge in algorithms, system architecture, and
              software engineering principles at Universidad Católica Andrés
              Bello.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
