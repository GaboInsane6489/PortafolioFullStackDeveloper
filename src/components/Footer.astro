---
import { Icon } from 'astro-icon/components'

const links = [
  { label: "Inicio", href: "/" },
  { label: "Proyectos", href: "#projects" },
  { label: "Sobre mí", href: "#about" },
  { label: "Contacto", href: "#contact" },
];
---
<footer
  class="bg-black border-t border-white/10 text-white pt-20 pb-10 relative z-10"
>
  <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-3 gap-12 text-sm">
    
    <!-- Marca / Identidad -->
    <div class="space-y-4">
      <p class="font-bold uppercase tracking-widest">
        Gabriel González
      </p>

      <p class="text-gray-400 max-w-sm leading-relaxed">
        Desarrollador Full Stack enfocado en rendimiento, arquitectura limpia y
        experiencias web de alto nivel.
      </p>
    </div>

    <!-- Navegación interna -->
    <nav aria-label="Footer navigation">
      <h4 class="text-xs uppercase tracking-widest text-gray-500 mb-4">
        Navegación
      </h4>

      <ul class="space-y-3">
        {links.map(link => (
          <li>
            <a
              href={link.href}
              class="hover:opacity-70 transition"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Redes sociales -->
    <div>
      <h4 class="text-xs uppercase tracking-widest text-gray-500 mb-4">
        Social
      </h4>

      <ul class="space-y-4">
        <li>
          <a
            href="https://github.com"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 hover:opacity-70 transition"
          >
            <Icon name="tabler:brand-github" size="18" />
            GitHub
          </a>
        </li>

        <li>
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 hover:opacity-70 transition"
          >
            <Icon name="tabler:brand-linkedin" size="18" />
            LinkedIn
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Copyright -->
  <div class="border-t border-white/10 mt-16 pt-6 text-center text-xs text-gray-500">
    © {new Date().getFullYear()} Gabriel González — Full Stack Developer
  </div>
</footer>
