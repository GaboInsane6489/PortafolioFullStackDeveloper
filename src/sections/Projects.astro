---
import { Icon } from "astro-icon/components";
import { getCollection, type CollectionEntry } from "astro:content";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allProjects = await getCollection("projects");
const projects = allProjects
  .filter((p: CollectionEntry<"projects">) => p.id.startsWith(`${lang}/`))
  .sort((a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) => a.data.order - b.data.order);
---

<section id="projects" class="relative overflow-hidden py-12 pb-12 lg:pb-24">
  <div class="pointer-events-none absolute top-0 left-1/2 h-full w-full -translate-x-1/2 bg-[radial-gradient(circle_at_top,rgba(165,166,246,0.05),transparent_60%)]"></div>

  <div class="relative mx-auto w-full max-w-[1400px] px-6">
    <div class="mb-6 flex flex-col justify-between gap-3 md:flex-row md:items-end lg:mb-10">
      <div class="reveal space-y-1">
        <div class="flex items-center gap-3">
          <span class="h-px w-6 bg-lofi-accent/50"></span>
          <span class="font-mono text-[9px] font-bold tracking-[0.4em] text-lofi-accent drop-shadow-[0_0_5px_currentColor] uppercase">{t("projects.badge")}</span>
        </div>
        <h2 class="font-serif text-3xl leading-tight text-white md:text-4xl lg:text-6xl">
          {t("projects.title1")}
          <span class="bg-gradient-to-r from-lofi-accent to-lofi-soft bg-clip-text text-transparent italic">{t("projects.title2")}</span>
        </h2>
      </div>
      <p class="reveal hidden max-w-[320px] font-mono text-[10px] leading-relaxed text-slate-300 md:block md:text-right" set:html={t("projects.description")} />
    </div>

    {/* Bento Grid Index */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        projects.map((project: any, i: number) => {
          return (
            <a
              href={`/${lang}/projects/${project.id.split("/")[1]}`}
              style={`transition-delay: ${(i % 3) * 100}ms`}
              class="project-card group relative flex flex-col overflow-hidden rounded-[2rem] border border-white/5 bg-white/[0.02] backdrop-blur-sm p-2 transition-all duration-500 hover:border-lofi-accent/30 reveal reveal-scale z-10 [transform-style:preserve-3d]"
            >
              <div class="card-content flex h-full flex-col p-1 transition-transform duration-300 ease-out [transform-style:preserve-3d]">
                <div class="relative aspect-video overflow-hidden rounded-2xl border border-white/5 [transform:translateZ(20px)]">
                  <img
                    src={project.data.mainImage}
                    alt={project.data.title}
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                  />
                  
                  {/* HUD INSPECTOR: Disabling pointer events to pass clicks to the parent link */}
                  <div class="absolute inset-0 z-20 flex flex-col items-center justify-center bg-black/60 opacity-0 backdrop-blur-sm transition-opacity duration-300 group-hover:opacity-100 pointer-events-none">
                    <div class="mb-4 h-px w-2/3 bg-gradient-to-r from-transparent via-lofi-accent to-transparent" />
                    <div class="flex flex-col items-center gap-2 font-mono">
                      <span class="text-[10px] font-black tracking-[0.5em] text-lofi-accent drop-shadow-[0_0_8px_currentColor] uppercase animate-pulse">
                        {project.data.badge}
                      </span>
                      <div class="flex items-center gap-4 py-1">
                        <div class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_10px_rgba(16,185,129,1)] animate-pulse" />
                        <span class="text-[9px] font-bold text-white/90 tracking-widest">
                          {project.data.status}
                        </span>
                      </div>
                    </div>
                    <div class="mt-4 h-px w-2/3 bg-gradient-to-r from-transparent via-lofi-accent to-transparent" />
                    <div class="scanner-line pointer-events-none absolute inset-x-0 h-10 w-full bg-gradient-to-b from-transparent via-lofi-accent/40 to-transparent" />
                  </div>
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none" />
                </div>

                <div class="flex flex-1 flex-col p-5 [transform:translateZ(30px)]">
                  <div class="mb-2 flex items-center justify-between">
                    <span class="font-mono text-[9px] font-bold tracking-widest text-white/50 uppercase">
                      ID_NODE: 0x{i + 1}
                    </span>
                    <Icon
                      name="tabler:arrow-up-right"
                      class="h-5 w-5 text-lofi-pop/50 transition-all group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-lofi-pop group-hover:drop-shadow-[0_0_10px_currentColor]"
                    />
                  </div>

                  <h3 class="mb-2 font-serif text-2xl text-white transition-colors group-hover:text-lofi-soft flex items-baseline gap-2">
                    <span class="text-xs text-lofi-accent opacity-50 font-mono">/</span>
                    {project.data.title}
                  </h3>

                  <p
                    class="mb-4 line-clamp-2 text-xs leading-relaxed text-slate-300 group-hover:text-slate-100 transition-colors"
                    set:html={project.data.description}
                  />

                  <div class="mt-auto flex flex-wrap gap-2">
                    {project.data.techStack.slice(0, 5).map((tech: string) => {
                      const techLower = tech.toLowerCase();
                      let iconName = "tabler:code";
                      if (techLower.includes("astro")) iconName = "tabler:brand-astro";
                      else if (techLower.includes("react")) iconName = "tabler:brand-react";
                      else if (techLower.includes("tailwind")) iconName = "tabler:brand-tailwind";
                      else if (techLower.includes("framer")) iconName = "tabler:brand-framer-motion";
                      else if (techLower.includes("vite")) iconName = "tabler:brand-vite";
                      else if (techLower.includes("node")) iconName = "tabler:brand-nodejs";
                      else if (techLower.includes("typescript") || techLower.includes("ts"))
                        iconName = "tabler:brand-typescript";
                      else if (techLower.includes("javascript") || techLower.includes("js"))
                        iconName = "tabler:brand-javascript";
                      else if (techLower.includes("css") || techLower.includes("html"))
                        iconName = "tabler:browser";
                      else if (techLower.includes("next")) iconName = "tabler:brand-nextjs";
                      else if (techLower.includes("supabase")) iconName = "tabler:brand-supabase";
                      else if (techLower.includes("postgres") || techLower.includes("sql"))
                        iconName = "tabler:database";
                      else if (techLower.includes("convex")) iconName = "tabler:brand-databricks";

                      return (
                        <div class="flex items-center gap-1.5 rounded-lg border border-white/5 bg-white/[0.02] px-2 py-1 transition-all hover:bg-lofi-accent/10 hover:border-lofi-accent/30 group-hover:border-white/10">
                          <Icon
                            name={iconName}
                            class="h-3.5 w-3.5 text-slate-300 transition-all group-hover:text-lofi-accent group-hover:drop-shadow-[0_0_8px_currentColor]"
                          />
                          <span class="font-mono text-[8.5px] font-bold text-slate-300 uppercase tracking-widest group-hover:text-white drop-shadow-sm">
                            {tech}
                          </span>
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>

              {/* Decorators: pointer-events-none */}
              <div class="absolute -right-2 -bottom-2 h-16 w-16 opacity-30 group-hover:opacity-100 transition-opacity pointer-events-none drop-shadow-[0_0_5px_currentColor]">
                <svg viewBox="0 0 100 100" class="h-full w-full text-lofi-pop fill-current">
                  <path d="M 100 0 L 100 100 L 0 100 Z" />
                </svg>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .project-card {
    perspective: 1000px;
    -webkit-tap-highlight-color: transparent;
  }
  
  .scanner-line {
    animation: scan 3s linear infinite;
  }

  @keyframes scan {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(200%); }
  }
</style>

<script>
  function setupTiltEffect() {
    const cards = document.querySelectorAll<HTMLElement>('.project-card');
    
    cards.forEach(card => {
      const content = card.querySelector<HTMLElement>('.card-content');
      if (!content) return;

      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        
        const rotateX = (y - centerY) / 80;
        const rotateY = (centerX - x) / 80;
        
        content.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
      });
      
      card.addEventListener('mouseleave', () => {
        content.style.transform = 'rotateX(0deg) rotateY(0deg)';
      });
    });
  }

  setupTiltEffect();
  document.addEventListener('astro:after-swap', setupTiltEffect);
</script>
