---
import { Icon } from "astro-icon/components";
import EmblaCarousel from "../components/ui/EmblaCarousel.astro";

const luzInteriorImages = Array.from(
  { length: 11 },
  (_, i) => `/images/LuzInterior${i + 1}.webp`,
);
const InstalacionesGarciasImages = Array.from(
  { length: 13 },
  (_, i) => `/images/InstalacionesGarcias${i + 1}.webp`,
);
---

<section id="projects" class="relative overflow-hidden pb-24 lg:pb-40">
  <div
    class="pointer-events-none absolute top-0 left-1/2 h-full w-full -translate-x-1/2 bg-[radial-gradient(circle_at_top,rgba(252,211,77,0.05),transparent_60%)]"
  >
  </div>

  <div class="relative mx-auto w-full max-w-[1400px] px-6">
    <div
      class="mb-16 flex flex-col justify-between gap-6 md:flex-row md:items-end lg:mb-28"
    >
      <div class="reveal space-y-4">
        <div class="flex items-center gap-3">
          <span class="h-px w-8 bg-amber-500/50"></span>
          <span
            class="font-mono text-[10px] font-bold tracking-[0.4em] text-amber-500 uppercase"
            >Selected Works</span
          >
        </div>
        <h2
          class="font-serif text-5xl leading-[1.1] text-white md:text-7xl lg:text-8xl"
        >
          Digital <span class="font-light text-white/30 italic"
            >Case Studies</span
          >
        </h2>
      </div>
      <p
        class="reveal max-w-[280px] text-sm leading-relaxed font-light text-gray-500 md:text-right"
      >
        A curation of production-grade systems focusing on <span
          class="text-white/60">architecture</span
        > and <span class="text-white/60">performance</span>.
      </p>
    </div>

    <div class="space-y-32 md:space-y-48">
      <article class="group relative grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div
          class="reveal reveal-left flex flex-col justify-center space-y-8 lg:col-span-5"
        >
          <div class="space-y-4">
            <div class="flex items-center gap-3 text-amber-500/80">
              <Icon name="tabler:school" class="text-xl" />
              <span
                class="font-mono text-[10px] font-black tracking-widest uppercase"
                >EdTech Operating System</span
              >
            </div>
            <h3 class="font-serif text-4xl text-white md:text-6xl">
              Martí Academy OS
            </h3>
            <p class="text-lg leading-relaxed text-gray-400">
              A robust educational platform built to handle complex academic
              workflows. Engineered with <span class="text-amber-500/50"
                >scalable architecture</span
              >, real-time data synchronization, and an intuitive UI for
              efficient institution management.
            </p>
          </div>

          <div class="flex flex-wrap gap-3">
            <span
              class="flex items-center gap-2 rounded-full border border-white/5 bg-white/[0.03] px-4 py-1.5 text-[10px] font-bold text-white/60"
            >
              <Icon name="tabler:brand-nextjs" class="text-white" /> Next.js 16
            </span>
            <span
              class="flex items-center gap-2 rounded-full border border-white/5 bg-white/[0.03] px-4 py-1.5 text-[10px] font-bold text-white/60"
            >
              <Icon name="tabler:database" class="text-blue-400" /> Supabase
            </span>
          </div>

          <div class="pt-4">
            <a
              href="https://github.com/GaboInsane6489/Marti-Academy-OS"
              target="_blank"
              rel="noopener noreferrer"
              class="group/link inline-flex items-center gap-3 font-mono text-xs font-bold tracking-widest text-amber-500"
            >
              <span
                class="border-b border-amber-500/30 pb-1 transition-all group-hover/link:border-amber-500"
                >EXPLORE ARCHITECTURE</span
              >
              <Icon
                name="tabler:chevron-right"
                class="transition-transform group-hover/link:translate-x-1"
              />
            </a>
          </div>
        </div>

        <div class="reveal reveal-right relative lg:col-span-7">
          <div
            class="relative aspect-[16/10] overflow-hidden rounded-2xl border border-white/10 bg-[#050505] shadow-2xl"
          >
            <div
              class="absolute inset-0 flex items-center justify-center bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.02),transparent)]"
            >
              <div
                class="rounded-lg border border-white/5 bg-black/40 px-6 py-3 font-mono text-[10px] font-bold tracking-[0.3em] text-white/20 backdrop-blur-xl"
              >
                SYSTEM_PREVIEW.PROT
              </div>
            </div>
          </div>
          <div
            class="absolute -inset-4 -z-10 bg-amber-500/5 opacity-0 blur-3xl transition-opacity duration-700 group-hover:opacity-100"
          >
          </div>
        </div>
      </article>

      <article class="group relative grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="reveal reveal-left order-2 lg:order-1 lg:col-span-7">
          <div
            class="relative overflow-hidden rounded-2xl border border-white/10 bg-[#0A0908] shadow-2xl"
          >
            <div
              class="flex items-center justify-between border-b border-white/5 bg-white/[0.02] px-4 py-3"
            >
              <div class="flex gap-1.5">
                <div class="h-2 w-2 rounded-full bg-white/10"></div>
                <div class="h-2 w-2 rounded-full bg-white/10"></div>
                <div class="h-2 w-2 rounded-full bg-white/10"></div>
              </div>
              <div
                class="flex-1 text-center font-mono text-[8px] font-bold tracking-[0.2em] text-white/20 uppercase"
              >
                LUZ_INTERIOR_v2.0
              </div>
            </div>
            <EmblaCarousel images={luzInteriorImages} />
          </div>
        </div>

        <div
          class="reveal reveal-right order-1 flex flex-col justify-center space-y-8 lg:order-2 lg:col-span-5"
        >
          <div class="space-y-4 text-right lg:text-left">
            <div
              class="flex items-center justify-end gap-3 text-purple-400/80 lg:justify-start"
            >
              <Icon name="tabler:bulb" class="text-xl" />
              <span
                class="font-mono text-[10px] font-black tracking-widest uppercase"
                >Growth Platform</span
              >
            </div>
            <h3 class="font-serif text-4xl text-white md:text-6xl">
              Mi Luz Interior
            </h3>
            <p class="text-lg leading-relaxed text-gray-400">
              A modern application designed for <span
                class="font-serif text-purple-400/50 italic"
                >personal reconstruction</span
              > and tracking. Built with complex state management, modular components,
              and a focus on seamless, privacy-first UX.
            </p>
          </div>

          <div class="flex justify-end lg:justify-start">
            <a
              href="https://github.com/GaboInsane6489/LuzInterior"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-4 rounded-full border border-white/10 bg-white/5 px-6 py-2 font-mono text-[10px] font-bold tracking-widest text-white transition-all hover:bg-white/10"
            >
              VIEW REPOSITORY <Icon name="tabler:brand-github" />
            </a>
          </div>
        </div>
      </article>

      <article class="group relative grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div
          class="reveal reveal-left flex flex-col justify-center space-y-8 lg:col-span-5"
        >
          <div class="space-y-4">
            <div class="flex items-center gap-3 text-blue-400/80">
              <Icon name="tabler:tool" class="text-xl" />
              <span
                class="font-mono text-[10px] font-black tracking-widest uppercase"
                >Enterprise Solution</span
              >
            </div>
            <h3 class="font-serif text-4xl text-white md:text-6xl">
              Instalaciones García
            </h3>
            <p class="text-lg leading-relaxed text-gray-400">
              Production-ready platform for a real-world client featuring <span
                class="font-bold text-blue-400/50">high performance</span
              > and SEO optimization. Designed to streamline field operations, improve
              load times, and drive conversion.
            </p>
          </div>
          <div
            class="inline-flex items-center gap-2 self-start rounded-md border border-blue-500/20 bg-blue-500/10 px-3 py-1 font-mono text-[9px] font-black tracking-tighter text-blue-400"
          >
            DEPLOYED IN PRODUCTION
          </div>

          <div class="pt-4">
            <a
              href="https://github.com/GaboInsane6489/instalacionesgarciasfronted"
              target="_blank"
              rel="noopener noreferrer"
              class="group/link inline-flex items-center gap-3 font-mono text-xs font-bold tracking-widest text-blue-400"
            >
              <span
                class="border-b border-blue-500/30 pb-1 transition-all group-hover/link:border-blue-500"
                >VIEW REPOSITORY</span
              >
              <Icon
                name="tabler:chevron-right"
                class="transition-transform group-hover/link:translate-x-1"
              />
            </a>
          </div>
        </div>

        <div class="reveal reveal-right lg:col-span-7">
          <div
            class="relative overflow-hidden rounded-2xl border border-white/10 bg-[#0A0908] shadow-2xl transition-transform duration-500 group-hover:scale-[1.01]"
          >
            <EmblaCarousel images={InstalacionesGarciasImages} />
          </div>
        </div>
      </article>
    </div>
  </div>
</section>
