---
import TopNavbar from "../components/TopNavbar.astro";
import SideNavbar from "../components/SideNavbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/index.css";
import "flowbite";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="title"
      content="Gabriel González | Digital Architect & Full Stack Developer"
    />
    <meta
      name="description"
      content="Immersive portfolio of Gabriel González. specialized in scalable digital systems, clean architecture, and high-performance web applications."
    />
    <meta
      name="keywords"
      content="Gabriel González, Full Stack Developer, Software Architect, React, Astro, Scalable Systems"
    />
    <meta name="author" content="Gabriel González" />
    <meta name="theme-color" content="#0A0908" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Gabriel González | Digital Architect" />
    <meta
      property="og:description"
      content="Building scalable systems with precision and craft."
    />
    <meta property="og:image" content="/images/og-image.jpg" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" href="/images/LogoPortafolio.webp" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <title>Gabriel González | Digital Architect</title>
  </head>
  <body
    class="bg-brand-dark font-sans text-white antialiased selection:bg-amber-500/30"
  >
    <!-- 🎥 Video Background System -->
    <div class="pointer-events-none fixed inset-0 -z-50 overflow-hidden">
      <video
        class="absolute h-full w-full object-cover opacity-40 mix-blend-luminosity"
        src="/videos/Train-Station-Rainy-Day.mp4"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"></video>

      <!-- Noise Overlay -->
      <div
        class="absolute inset-0 opacity-[0.15] mix-blend-overlay"
        style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"
      >
      </div>

      <!-- Gradient Overlay -->
      <div
        class="absolute inset-0 bg-gradient-to-b from-[#0A0908]/90 via-[#0A0908]/80 to-[#0A0908]"
      >
      </div>

      <!-- Grid Pattern -->
      <div
        class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] bg-[size:4rem_4rem]"
      >
      </div>
    </div>

    <!-- Top Navbar -->
    <TopNavbar />

    <!-- Main Layout -->
    <div class="relative z-10 flex min-h-screen flex-col md:flex-row">
      <!-- Side Navbar (Desktop Only) -->
      <aside class="fixed top-0 left-0 z-40 hidden h-screen w-20 md:block">
        <SideNavbar />
      </aside>

      <!-- Content Area -->
      <div class="flex flex-1 flex-col md:pl-20">
        <main class="mx-auto w-full max-w-[1600px] flex-1">
          <slot />
        </main>

        <footer class="border-t border-white/5 bg-[#0A0908]">
          <Footer />
        </footer>
      </div>
    </div>
  </body>
</html>
