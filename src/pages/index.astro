---
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
import { Icon } from "astro-icon/components";
import EmblaCarousel from "../components/EmblaCarousel.astro";

const luzInteriorImages = Array.from(
  { length: 11 },
  (_, i) => `/images/LuzInterior${i + 1}.webp`
);
---

<PortfolioLayout>

  <!-- ===================================================== -->
  <!-- HERO / PROFILE -->
  <!-- ===================================================== -->
  <section class="relative w-full border-t border-white/5 py-28 lg:py-36">

    <div class="mx-auto w-full max-w-[1300px] px-8 sm:px-12 lg:px-16 xl:px-20">

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-20 items-center">

        <!-- PROFILE TEXT -->
        <div class="lg:col-span-7 space-y-10">

          <div class="flex items-center gap-4">
            <div class="h-px w-12 bg-white"></div>
            <span class="text-[10px] tracking-[0.6em] text-gray-400 uppercase font-bold">
              Full Stack Developer
            </span>
          </div>

          <h1 class="font-serif text-5xl sm:text-6xl md:text-7xl xl:text-8xl leading-[0.9] tracking-tighter">
            Gabriel González
            <br />
            <span class="italic font-light text-white/40">
              Building scalable digital systems
            </span>
          </h1>

          <p class="text-lg md:text-xl text-gray-400 leading-relaxed max-w-2xl">
            I design and develop modern, maintainable and performance-oriented
            web applications. My focus is clean architecture, scalable
            systems, and high-quality user experiences.
          </p>

          <div class="text-[10px] uppercase tracking-[0.4em] text-gray-500 font-bold">
            Clean Architecture · Performance · Scalability · UX
          </div>

        </div>

        <!-- PROFILE IMAGE -->
        <div class="lg:col-span-5 flex justify-center lg:justify-end">

          <div class="relative group">

            <div class="absolute -inset-6 border border-white/10 -z-10 translate-x-4 translate-y-4 transition-all duration-700 group-hover:translate-x-0 group-hover:translate-y-0"></div>

            <img
              src="/images/FotoPerfil.webp"
              alt="Gabriel González Profile Picture"
              class="w-[280px] sm:w-[320px] md:w-[360px] object-cover border border-white/5"
              loading="lazy"
            />

          </div>

        </div>

      </div>

    </div>
  </section>



  <!-- ===================================================== -->
  <!-- ABOUT ME -->
  <!-- ===================================================== -->
  <section class="py-32 border-t border-white/5">

    <div class="mx-auto w-full max-w-[1000px] px-8 sm:px-12 lg:px-16 space-y-16">

      <div class="space-y-8">

        <div class="flex items-center gap-4">
          <div class="h-px w-12 bg-white"></div>
          <span class="text-[10px] tracking-[0.6em] text-gray-400 uppercase font-bold">
            Professional Summary
          </span>
        </div>

        <h2 class="font-serif text-4xl md:text-6xl leading-tight tracking-tighter">
          Engineering with structure,
          <br />
          <span class="italic font-light text-white/40">
            not improvisation
          </span>
        </h2>

      </div>

      <div class="space-y-8 text-gray-400 leading-loose text-lg">

        <p>
          I am a Full Stack Developer focused on building modern,
          maintainable, and performance-oriented web applications. I work
          across both frontend and backend, prioritizing clean architecture,
          best practices, and solutions designed to scale in an organized way.
        </p>

        <p>
          Throughout my training as a University-certified Full Stack Developer
          and my hands-on experience, I have built and maintained real-world
          projects in collaborative environments.
        </p>

        <p>
          Notable examples include <span class="text-white font-medium">Instalaciones García</span>,
          a scalable service management system, and my work on
          <span class="text-white font-medium"> Harry Potter Foro</span>,
          where I implemented complex features such as achievement systems,
          notifications, database migrations, and event-driven logic directly
          in a production environment.
        </p>

        <p>
          I have real work experience collaborating in teams that follow
          professional workflows: ticket systems, branching strategies, clean
          commits, pull requests, squash merges, code reviews, and controlled
          deployments.
        </p>

        <p>
          My role has involved fixing real production bugs, improving existing
          logic, and ensuring system stability.
        </p>

      </div>

      <div class="pt-10 border-t border-white/5 text-sm text-gray-500 space-y-2">
        <p>Location: Caracas, Venezuela</p>
        <p>High-tech workspace · Server architecture environment</p>
        <p>Open to remote opportunities</p>
      </div>

    </div>

  </section>



  <!-- ===================================================== -->
  <!-- FEATURED PROJECT -->
  <!-- ===================================================== -->
  <section id="projects" class="py-32 border-t border-white/5">

    <div class="mx-auto w-full max-w-[1200px] px-8 sm:px-12 lg:px-16">

      <div class="max-w-3xl space-y-10">

        <div class="flex items-center gap-4">
          <div class="h-px w-12 bg-white"></div>
          <span class="text-[10px] tracking-[0.6em] text-gray-400 uppercase font-bold">
            Featured Project
          </span>
        </div>

        <h2 class="font-serif text-4xl md:text-6xl leading-[0.9] tracking-tighter">
          Luz Interior
          <br />
          <span class="italic font-light text-white/40">
            Modular architecture & scalable system design
          </span>
        </h2>

        <p class="text-lg text-gray-400 leading-relaxed max-w-xl">
          A structured digital platform built with reusable components,
          modular architecture, and performance-focused implementation.
        </p>

      </div>

      <div class="mt-20 grid grid-cols-1 lg:grid-cols-2 gap-20 items-start">

        <div class="space-y-10 max-w-xl">

          <div>
            <h3 class="text-xl font-serif mb-4">Tech Stack</h3>
            <ul class="space-y-3 text-gray-400">
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-javascript" size="18" />
                JavaScript
              </li>
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-react" size="18" />
                React
              </li>
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-tailwind" size="18" />
                TailwindCSS
              </li>
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-supabase" size="18" />
                Supabase
              </li>
              <li class="flex items-center gap-3">
                <Icon name="tabler:brand-vercel" size="18" />
                Vercel
              </li>
            </ul>
          </div>

        </div>

        <div>
          <EmblaCarousel images={luzInteriorImages} />
        </div>

      </div>

    </div>

  </section>

</PortfolioLayout>
