---
import { Icon } from "astro-icon/components";

const techStack = [
  // ... (tu array techStack se mantiene igual)
  {
    name: "Next.js",
    icon: "tabler:brand-nextjs",
    color: "text-white",
    category: "Frontend",
  },
  {
    name: "React",
    icon: "tabler:brand-react",
    color: "text-sky-400",
    category: "Frontend",
  },
  {
    name: "Astro",
    icon: "tabler:brand-astro",
    color: "text-orange-400",
    category: "Frontend",
  },
  {
    name: "TypeScript",
    icon: "tabler:brand-typescript",
    color: "text-blue-500",
    category: "Frontend",
  },
  {
    name: "Tailwind",
    icon: "tabler:brand-tailwind",
    color: "text-cyan-400",
    category: "Frontend",
  },
  {
    name: "Node.js",
    icon: "tabler:brand-nodejs",
    color: "text-green-500",
    category: "Backend",
  },
  {
    name: "Laravel",
    icon: "tabler:brand-laravel",
    color: "text-red-500",
    category: "Backend",
  },
  {
    name: "Supabase",
    icon: "tabler:brand-supabase",
    color: "text-emerald-500",
    category: "Database",
  },
  {
    name: "PostgreSQL",
    icon: "tabler:database",
    color: "text-blue-400",
    category: "Database",
  },
  {
    name: "MongoDB",
    icon: "tabler:brand-mongodb",
    color: "text-green-600",
    category: "Database",
  },
  {
    name: "Vercel",
    icon: "tabler:brand-vercel",
    color: "text-white",
    category: "Deploy",
  },
  {
    name: "GitHub",
    icon: "tabler:brand-github",
    color: "text-white",
    category: "Deploy",
  },
];
---

<section
  id="tech-stack"
  class="relative overflow-hidden border-b border-white/5 py-20 lg:py-32"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(252,211,77,0.02),transparent_70%)]"
  >
  </div>

  <div class="relative mx-auto w-full max-w-[1600px] px-6 sm:px-12 lg:px-16">
    <div class="mb-12 flex flex-col items-center text-center md:mb-20">
      <div class="reveal flex items-center gap-3">
        <span class="h-px w-6 bg-amber-500/40"></span>
        <span
          class="font-mono text-[10px] font-bold tracking-[0.3em] text-amber-500 uppercase"
        >
          Core Arsenal
        </span>
        <span class="h-px w-6 bg-amber-500/40"></span>
      </div>

      <h2
        class="reveal mt-4 font-serif text-3xl leading-tight text-white delay-100 md:text-5xl lg:text-6xl"
      >
        Systems engineered from<br />
        <span
          class="bg-gradient-to-r from-gray-400 to-white bg-clip-text text-transparent italic"
        >
          interface to infrastructure.
        </span>
      </h2>
    </div>

    <div
      class="reveal reveal-scale relative mx-auto max-w-5xl rounded-2xl border border-white/5 bg-white/[0.01] p-6 backdrop-blur-sm delay-200 md:p-12 lg:p-16"
    >
      <div
        class="absolute top-0 left-1/2 h-px w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-amber-500/30 to-transparent"
      >
      </div>

      <div
        class="grid grid-cols-3 gap-x-4 gap-y-10 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 lg:gap-y-14"
      >
        {
          techStack.map((tech) => (
            <div class="group relative flex flex-col items-center">
              <div class="absolute inset-0 -z-10 rounded-full bg-amber-500/5 opacity-0 blur-xl transition-opacity duration-500 group-hover:opacity-100" />

              <div class="relative flex h-14 w-14 items-center justify-center rounded-xl border border-white/10 bg-[#0A0908] shadow-lg transition-all duration-500 group-hover:-translate-y-1.5 group-hover:border-amber-500/30 group-hover:shadow-amber-500/10 md:h-20 md:w-20 md:rounded-2xl">
                <Icon
                  name={tech.icon}
                  size={28}
                  class={`${tech.color} transition-all duration-500 group-hover:scale-110 md:hidden`}
                />
                <Icon
                  name={tech.icon}
                  size={40}
                  class={`${tech.color} hidden transition-all duration-500 group-hover:scale-110 md:block`}
                />
              </div>

              <div class="mt-3 flex flex-col items-center text-center">
                <span class="font-mono text-[10px] font-bold tracking-wider text-white transition-colors duration-300 group-hover:text-amber-400 md:text-[11px]">
                  {tech.name}
                </span>
                <span class="mt-0.5 font-mono text-[8px] tracking-tight text-gray-600 uppercase md:tracking-[0.1em]">
                  {tech.category}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
