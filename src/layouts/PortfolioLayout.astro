---
import TopNavbar from "../components/TopNavbar.astro";
import SideNavbar from "../components/SideNavbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/index.css";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/webp" href="/images/LogoPortafolio.webp" />
    <title>Gabriel González | Full Stack Developer</title>
  </head>

  <body class="bg-black text-white min-h-screen overflow-x-hidden">

    <!-- 🎥 Video Background -->
    <div class="fixed inset-0 -z-20 pointer-events-none">
      <video
        class="w-full h-full object-cover"
        src="/videos/Train-Station-Rainy-Day.mp4"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
      ></video>
      <div class="absolute inset-0 bg-black/60"></div>
    </div>

    <!-- Top Navbar -->
    <TopNavbar />

    <!-- Layout principal -->
    <div class="grid grid-cols-1 md:grid-cols-[96px_1fr] min-h-screen relative z-10">

      <!-- Side Navbar -->
      <aside class="hidden md:flex">
        <SideNavbar />
      </aside>

      <!-- Columna de contenido -->
      <div class="flex flex-col min-h-[calc(100vh-6rem)]">

        <main class="flex-1">
          <slot />
        </main>

        <footer class="bg-black/80 backdrop-blur border-t border-white/10">
          <Footer />
        </footer>

      </div>
    </div>
  </body>
</html>
