---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  { label: t("nav.startup"), href: "#hero" },
  { label: t("nav.projects"), href: "#projects" },
  { label: t("nav.exp"), href: "#experience" },
  { label: t("nav.lab"), href: "#laboratory" },
];

const socials = [
  {
    label: "GitHub",
    href: "https://github.com/GaboInsane6489",
    icon: "tabler:brand-github",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/gabriel-gonzalez-fullstack/",
    icon: "tabler:brand-linkedin",
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/dreamsfallen6488/",
    icon: "tabler:brand-instagram",
  },
  {
    label: "YouTube",
    href: "https://www.youtube.com/@Gabo6489Gaming-pe2tg",
    icon: "tabler:brand-youtube",
  },
];
---

<footer
  class="relative w-full overflow-hidden border-t border-white/5 bg-[#0A0908] pt-20 pb-10 text-white md:pt-24 md:pb-12"
>
  <div class="pointer-events-none absolute inset-0 z-0">
    <div
      class="absolute inset-0 [background-image:linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] [background-size:32px_32px]"
    >
    </div>
    <div
      class="absolute inset-0 [background-image:linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.02),rgba(0,255,0,0.01),rgba(0,0,255,0.02))] [background-size:100%_4px,3px_100%]"
    >
    </div>

    <div
      class="absolute -top-24 -left-24 h-72 w-72 rounded-full bg-amber-500/5 blur-[100px] md:h-96 md:w-96 md:blur-[120px]"
    >
    </div>
    <div
      class="absolute -right-24 -bottom-24 h-72 w-72 rounded-full bg-blue-500/5 blur-[100px] md:h-96 md:w-96 md:blur-[120px]"
    >
    </div>

    <div
      class="absolute top-0 left-0 h-[2px] w-full bg-gradient-to-r from-transparent via-amber-500/40 to-transparent"
    >
      <div class="absolute inset-0 animate-pulse bg-amber-400 blur-[2px]"></div>
    </div>
  </div>

  <div class="relative z-10 mx-auto max-w-[1600px] px-6 lg:px-12">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-12">
      <div
        class="flex flex-col items-center space-y-8 text-center lg:col-span-5 lg:items-start lg:text-left"
      >
        <div
          class="flex flex-col items-center gap-5 sm:flex-row lg:items-start"
        >
          <div
            class="group relative h-16 w-16 transition-transform active:scale-95 md:h-14 md:w-14"
          >
            <div
              class="animate-spin-slow absolute inset-0 rounded-xl border border-amber-500/20 bg-amber-500/5 [animation-duration:10s]"
            >
            </div>
            <div
              class="absolute inset-2 flex items-center justify-center overflow-hidden rounded-lg border border-white/10 bg-[#0D0C0B] shadow-2xl"
            >
              <img
                src="/images/LogoPortafolio.webp"
                alt="Logo"
                class="h-8 w-8 object-contain transition-transform group-hover:scale-110"
              />
            </div>
          </div>
          <div class="flex flex-col">
            <h2
              class="text-2xl font-black tracking-tighter text-white uppercase italic sm:text-3xl"
            >
              Gabriel González
            </h2>
            <div
              class="flex items-center justify-center gap-2 font-mono text-[9px] font-bold tracking-[0.4em] text-amber-500 lg:justify-start"
            >
              <span
                class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-amber-500"
              ></span>
              SYSTEM ARCHITECT // V_02
            </div>
          </div>
        </div>

        <p
          class="max-w-md font-sans text-sm leading-relaxed font-light text-gray-400 sm:text-base"
          set:html={t("footer.tagline")}
        />

        <a
          href="mailto:gabrielgg2005ve@gmail.com"
          class="group relative inline-flex w-full items-center justify-center gap-4 overflow-hidden rounded-xl border border-white/5 bg-white/[0.02] px-6 py-4 transition-all active:scale-[0.98] active:bg-amber-500/10 sm:w-auto md:py-3"
        >
          <Icon name="tabler:mail" size={20} class="text-amber-500" />
          <span class="font-mono text-xs tracking-widest text-gray-300"
            >GABRIELGG2005VE@GMAIL.COM</span
          >
        </a>
      </div>

      <div
        class="grid grid-cols-2 gap-8 sm:gap-12 lg:col-span-3 lg:block lg:space-y-10"
      >
        <h4
          class="col-span-2 flex items-center gap-3 font-mono text-[10px] font-bold tracking-[0.5em] text-gray-600 uppercase lg:col-auto lg:mb-10"
        >
          <span class="h-[1px] w-4 bg-gray-800"></span> // {t("footer.index")}
        </h4>
        <ul
          class="col-span-2 grid grid-cols-2 gap-4 lg:col-auto lg:block lg:space-y-5"
        >
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="group flex items-center py-2 text-gray-500 transition-all active:text-amber-500 lg:py-0 lg:hover:text-white"
                >
                  <span class="font-mono text-[11px] tracking-[0.2em] uppercase">
                    {link.label}
                  </span>
                  <Icon
                    name="tabler:chevron-right"
                    size={14}
                    class="ml-auto text-amber-500 opacity-40 lg:ml-2 lg:opacity-0 lg:group-hover:opacity-100"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-4">
        <h4
          class="mb-8 flex items-center gap-3 font-mono text-[10px] font-bold tracking-[0.5em] text-gray-600 uppercase"
        >
          <span class="h-[1px] w-4 bg-gray-800"></span> // {t("footer.nodes")}
        </h4>
        <div class="grid grid-cols-2 gap-4">
          {
            socials.map((social) => (
              <a
                href={social.href}
                target="_blank"
                class="group relative flex flex-col gap-3 rounded-2xl border border-white/5 bg-white/[0.02] p-5 transition-all active:scale-95 active:border-amber-500/40 active:bg-amber-500/5 lg:hover:-translate-y-2 lg:hover:bg-white/[0.03]"
              >
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-black/50 text-gray-500 shadow-inner group-active:text-amber-500 lg:group-hover:text-amber-500">
                  <Icon name={social.icon} size={22} />
                </div>
                <span class="font-mono text-[10px] tracking-widest text-gray-500 uppercase group-active:text-white lg:group-hover:text-white">
                  {social.label}
                </span>
                <div class="absolute top-3 right-3 h-1.5 w-1.5 rounded-full bg-white/5 group-active:bg-amber-500 lg:group-hover:bg-amber-500" />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div
      class="mt-20 flex flex-col items-center justify-between gap-10 border-t border-white/5 pt-12 md:flex-row"
    >
      <div class="flex flex-col items-center space-y-3 md:items-start">
        <p
          class="font-mono text-[10px] tracking-[0.3em] text-gray-500 uppercase"
        >
          &copy; {new Date().getFullYear()} Gabriel González // <span
            class="text-amber-500/40">{t("footer.secured")}</span
          >
        </p>
        <div class="h-1 w-32 overflow-hidden rounded-full bg-white/5">
          <div class="animate-loading-bar h-full w-1/3 bg-amber-500/50"></div>
        </div>
      </div>

      <div
        class="flex w-full flex-col items-center gap-4 sm:flex-row sm:justify-center md:w-auto"
      >
        <div
          class="flex items-center gap-3 rounded-full border border-white/5 bg-black/40 px-6 py-3 shadow-xl backdrop-blur-sm"
        >
          <div class="relative h-2 w-2">
            <div
              class="absolute inset-0 animate-ping rounded-full bg-green-500 opacity-20"
            >
            </div>
            <div
              class="h-full w-full rounded-full bg-green-500 shadow-[0_0_10px_rgba(34,197,94,0.8)]"
            >
            </div>
          </div>
          <span
            class="font-mono text-[9px] tracking-tighter text-gray-400 uppercase"
            >{t("footer.status")}</span
          >
          <div class="mx-3 h-4 w-px bg-white/10"></div>
          <span class="font-mono text-[9px] text-amber-500/70 uppercase"
            >LATENCY: 14MS</span
          >
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  @keyframes loading-bar {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(400%);
    }
  }
  .animate-loading-bar {
    animation: loading-bar 3s infinite linear;
  }
  .animate-spin-slow {
    animation: spin 12s linear infinite;
  }
  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* Optimización para evitar resaltado azul feo en móvil al tocar */
  a,
  button {
    -webkit-tap-highlight-color: transparent;
  }
</style>
