---
import { Icon } from "astro-icon/components";
import EmblaCarousel from "../EmblaCarousel.astro";

const HarryPotterHeadForumImages = Array.from(
  { length: 15 },
  (_, i) => `/images/HarryPotterHead${i + 1}.webp`,
);
---

<section
  id="experience"
  class="relative border-b border-white/5 py-20 lg:py-32"
>
  <div class="relative mx-auto w-full max-w-[1600px] px-6 sm:px-12 lg:px-16">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="space-y-6 lg:sticky lg:top-32 lg:col-span-4 lg:h-fit">
        <div class="reveal flex items-center gap-3">
          <span class="h-px w-8 bg-amber-500/40"></span>
          <span
            class="font-mono text-[10px] font-bold tracking-[0.3em] text-amber-500 uppercase"
          >
            Career Path
          </span>
        </div>
        <h2
          class="reveal font-serif text-4xl leading-tight text-white delay-100 md:text-5xl"
        >
          Professional <br class="hidden lg:block" /> Timeline
        </h2>
        <p
          class="reveal max-w-sm text-base leading-relaxed font-light text-gray-400 delay-200"
        >
          A chronological log of my development journey, from academic
          foundation to leading production-grade systems.
        </p>
      </div>

      <div
        class="relative ml-2 space-y-16 border-l border-white/10 pl-8 md:pl-12 lg:col-span-8 lg:ml-0"
      >
        <div class="reveal reveal-right group relative">
          <div
            class="absolute top-1.5 -left-[41px] h-4 w-4 rounded-full border border-amber-500 bg-[#0A0908] transition-all duration-500 group-hover:scale-125 group-hover:bg-amber-500 lg:-left-[57px] lg:h-5 lg:w-5"
          >
            <span
              class="absolute inset-0 rounded-full bg-amber-500 opacity-0 transition-opacity group-hover:animate-ping group-hover:opacity-40"
            ></span>
          </div>

          <div class="space-y-3">
            <div
              class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"
            >
              <h3
                class="font-serif text-xl text-white transition-colors group-hover:text-amber-400 md:text-2xl"
              >
                Lead Product Engineer
              </h3>
              <span
                class="w-fit rounded border border-amber-500/20 bg-amber-500/10 px-2 py-0.5 font-mono text-[10px] text-amber-500"
              >
                2024 — Present
              </span>
            </div>
            <h4 class="text-base font-medium text-gray-400 md:text-lg">
              Instalaciones García
            </h4>
            <p
              class="max-w-2xl text-sm leading-relaxed text-gray-500 md:text-base"
            >
              Spearheaded the development of a custom ERP solution. Transitioned
              the company from manual spreadsheet workflows to a fully digital,
              cloud-based ecosystem using <span class="text-white"
                >React and Supabase</span
              >.
            </p>
          </div>
        </div>

        <div class="reveal reveal-right group relative delay-200">
          <div
            class="absolute top-1.5 -left-[41px] h-4 w-4 rounded-full border border-white/20 bg-[#0A0908] transition-all duration-500 group-hover:border-amber-500 group-hover:bg-amber-500 lg:-left-[57px] lg:h-5 lg:w-5"
          >
          </div>

          <div class="space-y-6">
            <div class="space-y-3">
              <div
                class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"
              >
                <h3 class="font-serif text-xl text-white md:text-2xl">
                  Full Stack Developer & DevOps
                </h3>
                <span
                  class="w-fit rounded bg-white/5 px-2 py-0.5 font-mono text-[10px] text-gray-500"
                  >2023 — 2024</span
                >
              </div>
              <h4 class="text-base text-gray-400 md:text-lg">
                Harry Potter Head Forum
              </h4>
              <p
                class="max-w-2xl text-sm leading-relaxed text-gray-500 md:text-base"
              >
                Orchestrated the engineering of a high-traffic community
                platform (<strong class="text-gray-300">20k+ daily users</strong
                >). Architected CI/CD pipelines and optimized database queries
                by 40%.
              </p>
            </div>

            <div
              class="reveal reveal-scale mt-4 overflow-hidden rounded-xl border border-white/10 bg-black shadow-2xl transition-transform duration-500 group-hover:scale-[1.01] sm:max-w-md"
            >
              <div class="aspect-video sm:aspect-auto">
                <EmblaCarousel images={HarryPotterHeadForumImages} />
              </div>
              <div
                class="flex items-center justify-between bg-[#0A0908] px-4 py-2 text-[9px] tracking-widest text-gray-600 uppercase"
              >
                <span class="flex items-center gap-2">
                  <Icon name="tabler:archive" size={12} /> Legacy System Archive
                </span>
                <span class="text-[8px] opacity-50">v2.4.0</span>
              </div>
            </div>
          </div>
        </div>

        <div class="reveal reveal-right group relative delay-300">
          <div
            class="absolute top-1.5 -left-[41px] h-4 w-4 rounded-full border border-white/20 bg-[#0A0908] transition-all group-hover:border-amber-500 lg:-left-[57px] lg:h-5 lg:w-5"
          >
          </div>
          <div class="space-y-2">
            <div
              class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"
            >
              <h3 class="font-serif text-xl text-white md:text-2xl">
                Computer Engineering Student
              </h3>
              <span
                class="w-fit rounded bg-white/5 px-2 py-0.5 font-mono text-[10px] text-gray-500"
                >Present</span
              >
            </div>
            <h4 class="text-base text-gray-400 md:text-lg">
              UCAB (Andrés Bello)
            </h4>
            <p
              class="max-w-2xl text-sm leading-relaxed text-gray-500 italic md:text-base"
            >
              Currently in 3rd Semester. Deepening knowledge in algorithms,
              system architecture, and software engineering principles.
            </p>
          </div>
        </div>

        <div class="reveal reveal-right group relative delay-400">
          <div
            class="absolute top-1.5 -left-[41px] h-4 w-4 rounded-full border border-white/20 bg-[#0A0908] transition-all group-hover:border-amber-500 lg:-left-[57px] lg:h-5 lg:w-5"
          >
          </div>
          <div class="space-y-2">
            <div
              class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"
            >
              <h3 class="font-serif text-xl text-white md:text-2xl">
                Technical Degree in CS
              </h3>
              <span
                class="w-fit rounded bg-white/5 px-2 py-0.5 font-mono text-[10px] text-gray-500"
                >2023</span
              >
            </div>
            <h4 class="text-base text-gray-400 md:text-lg">
              University Certified Program
            </h4>
            <p
              class="max-w-2xl text-sm leading-relaxed text-gray-500 md:text-base"
            >
              Intensive 1-year hybrid program focused on industry standards and
              full-stack implementation.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
