---
import { Icon } from "astro-icon/components";
---

<section
  id="engineering"
  class="relative overflow-hidden border-t border-white/5 py-16 lg:py-20"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(252,211,77,0.03),transparent_70%)]"
  >
  </div>

  <div class="relative mx-auto w-full max-w-[1300px] px-6 sm:px-12 lg:px-20">
    <div
      class="mb-10 flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-end"
    >
      <div class="space-y-4">
        <div class="reveal flex items-center gap-3">
          <span class="h-px w-8 bg-amber-500/50"></span>
          <span
            class="text-[10px] font-bold tracking-[0.4em] text-amber-500 uppercase"
            >Engineering Systems</span
          >
        </div>
        <h2
          class="reveal font-serif text-4xl leading-none text-white md:text-5xl"
        >
          Core <span class="font-light text-white/40 italic">Architecture</span>
        </h2>
      </div>
      <p class="reveal max-w-md text-sm leading-relaxed text-gray-400">
        Mi flujo de trabajo transforma lógica compleja en repositorios
        mantenibles. Código que no solo funciona, sino que escala.
      </p>
    </div>

    <div class="grid gap-4 lg:grid-cols-12 lg:grid-rows-2">
      <div
        class="reveal reveal-scale group relative col-span-12 row-span-2 overflow-hidden rounded-3xl border border-white/10 bg-black/40 lg:col-span-8"
      >
        <video
          src="/videos/Programando2.mp4"
          class="h-full w-full object-cover opacity-100 transition-transform duration-700 group-hover:scale-[1.02]"
          autoplay
          loop
          muted
          playsinline></video>

        <div
          class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"
        >
        </div>
        <div class="absolute bottom-6 left-6 flex items-center gap-4">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-full border border-amber-500/30 bg-black/60 backdrop-blur-md"
          >
            <Icon
              name="tabler:device-analytics"
              class="animate-pulse text-amber-400"
              size={20}
            />
          </div>
          <div>
            <p
              class="font-mono text-[10px] tracking-[0.2em] text-amber-500 uppercase"
            >
              System_Active
            </p>
            <p class="text-sm font-medium text-white/90">
              Architecture Deep Dive
            </p>
          </div>
        </div>
      </div>

      <article
        class="reveal reveal-left group relative col-span-12 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] lg:col-span-4"
      >
        <img
          src="/images/GitHub1.webp"
          alt="GitHub Overview"
          class="h-full w-full object-cover object-top opacity-80 transition-all duration-500 group-hover:scale-105 group-hover:opacity-100"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-[#0A0908] via-transparent to-transparent opacity-60"
        >
        </div>
        <div class="absolute inset-0 flex flex-col justify-between p-6">
          <Icon name="tabler:brand-github" class="text-amber-400" size={24} />
          <span
            class="w-fit rounded bg-black/40 p-1 px-2 font-mono text-[10px] font-bold tracking-widest text-white/60 uppercase backdrop-blur-sm"
            >Engineering Identity</span
          >
        </div>
      </article>

      <article
        class="reveal reveal-left group relative col-span-12 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] delay-100 lg:col-span-4"
      >
        <img
          src="/images/GitHub4.webp"
          alt="Commit Activity"
          class="h-full w-full object-cover opacity-80 transition-all duration-500 group-hover:opacity-100"
        />
        <div
          class="absolute inset-x-0 bottom-0 border-t border-amber-500/20 bg-amber-500/10 p-3 backdrop-blur-md"
        >
          <p
            class="font-mono text-[9px] font-bold tracking-tighter text-amber-400 uppercase"
          >
            Commit_Cycle: Constant & Disciplined
          </p>
        </div>
      </article>

      <div class="col-span-12 mt-2 grid gap-4 sm:grid-cols-3">
        {
          [
            {
              title: "Code Quality",
              icon: "tabler:square-rounded-check",
              img: "/images/GitHub3.webp",
            },
            {
              title: "Docs Standards",
              icon: "tabler:copy-check",
              img: "/images/GitHub5.webp",
            },
            {
              title: "System Thinking",
              icon: "tabler:hierarchy-2",
              img: "/images/GitHub2.webp",
            },
          ].map((item, i) => (
            <div
              class={`reveal delay-[${(i + 3) * 100}ms] group relative aspect-[2/1] overflow-hidden rounded-xl border border-white/10 bg-white/[0.03]`}
            >
              <img
                src={item.img}
                alt={item.title}
                class="h-full w-full object-cover opacity-70 transition-all group-hover:opacity-100"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent" />
              <div class="absolute bottom-3 left-3 flex items-center gap-2">
                <Icon name={item.icon} size={14} class="text-amber-400" />
                <span class="text-[9px] font-bold tracking-[0.2em] text-white uppercase">
                  {item.title}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
