---
import { Icon } from "astro-icon/components";

const links = [
  { label: "Home", href: "/" },
  { label: "Projects", href: "#projects" },
  { label: "Experience", href: "#experience" },
  { label: "Contact", href: "#contact" },
];

const socials = [
  {
    label: "GitHub",
    href: "https://github.com/GaboInsane6489",
    icon: "tabler:brand-github",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/gabriel-gonzalez-fullstack/",
    icon: "tabler:brand-linkedin",
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/dreamsfallen6488/",
    icon: "tabler:brand-instagram",
  },
  {
    label: "YouTube",
    href: "https://www.youtube.com/@Gabo6489Gaming-pe2tg",
    icon: "tabler:brand-youtube",
  },
];
---

<footer
  class="bg-brand-dark relative w-full overflow-hidden border-t border-white/5 pt-20 pb-10 text-white"
>
  <!-- Grid Texture -->
  <div class="grid-bg pointer-events-none absolute inset-0 opacity-30"></div>

  <div class="relative z-10 mx-auto max-w-[1600px] px-6 lg:px-12">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-8">
      <!-- Brand & Vision -->
      <div class="space-y-6 lg:col-span-5">
        <div class="flex items-center gap-3">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/5"
          >
            <span class="font-mono text-xl font-bold text-amber-500">G</span>
          </div>
          <span class="text-xl font-bold tracking-tight">Gabriel González</span>
        </div>

        <p class="max-w-md leading-relaxed font-light text-gray-400">
          Engineering scalable digital ecosystems with a focus on <span
            class="font-medium text-white">performance</span
          >, <span class="font-medium text-white">clean architecture</span>, and <span
            class="font-medium text-white">user-centric design</span
          >.
        </p>

        <div class="pt-4">
          <a
            href="mailto:contact@gabrielgonzalez.dev"
            class="group inline-flex items-center gap-2 font-mono text-sm text-gray-400 transition-colors hover:text-amber-400"
          >
            <Icon name="tabler:mail" />
            <span>contact@gabrielgonzalez.dev</span>
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <div class="lg:col-span-3">
        <h4
          class="mb-6 font-mono text-xs font-bold tracking-widest text-gray-500 uppercase"
        >
          Index
        </h4>
        <ul class="space-y-3">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="group flex items-center gap-2 text-sm text-gray-400 transition-colors hover:text-white"
                >
                  <span class="h-px w-0 bg-amber-500 transition-all group-hover:w-4" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Socials -->
      <div class="lg:col-span-4">
        <h4
          class="mb-6 font-mono text-xs font-bold tracking-widest text-gray-500 uppercase"
        >
          Connect
        </h4>
        <div class="grid grid-cols-2 gap-4">
          {
            socials.map((social) => (
              <a
                href={social.href}
                target="_blank"
                class="group flex items-center gap-3 rounded-lg border border-white/5 bg-white/[0.02] p-4 transition-all hover:border-amber-500/30 hover:bg-white/5"
              >
                <div class="rounded-md bg-white/5 p-2 text-gray-400 transition-colors group-hover:text-amber-400">
                  <Icon name={social.icon} size={20} />
                </div>
                <span class="text-sm font-medium text-gray-300 group-hover:text-white">
                  {social.label}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div
      class="mt-20 flex flex-col items-center justify-between gap-6 border-t border-white/5 pt-8 md:flex-row"
    >
      <p class="font-mono text-xs text-gray-600">
        &copy; {new Date().getFullYear()} Gabriel González. All rights reserved.
      </p>

      <div class="flex items-center gap-2 font-mono text-xs text-gray-600">
        <span class="h-2 w-2 animate-pulse rounded-full bg-green-500/50"></span>
        <span>Systems Operational</span>
      </div>
    </div>
  </div>
</footer>
