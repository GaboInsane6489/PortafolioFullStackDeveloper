---
import { getCollection, type CollectionEntry, render } from "astro:content";
import PortfolioLayout from "../../../layouts/PortfolioLayout.astro";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
  const allProjects = await getCollection("projects");
  return allProjects.map((project: CollectionEntry<"projects">, index) => {
    const [lang, slug] = project.id.split("/");
    // Filter collection by language for internal navigation
    const projectsInLang = allProjects.filter(p => p.id.startsWith(`${lang}/`));
    const projectIndex = projectsInLang.findIndex(p => p.id === project.id);
    const nextProject = projectsInLang[(projectIndex + 1) % projectsInLang.length];
    
    return {
      params: { lang, slug },
      props: { project, nextProject },
    };
  });
}

interface Props {
  project: CollectionEntry<"projects">;
  nextProject: CollectionEntry<"projects">;
}

const { project, nextProject } = Astro.props;
const { lang } = Astro.params;
const { Content } = await render(project);
const { title, description, techStack, mainImage, images, githubUrl, liveUrl, status } = project.data;

const projectShortTitle = title.split(' ')[0].toLowerCase();
---

<PortfolioLayout>
  <div class="relative min-h-screen pt-12 pb-24 md:pt-16 md:pb-40 selection:bg-lofi-accent/30 overflow-x-hidden">
    <!-- --- DOSSIER BACKGROUND: Technical Grid --- -->
    <div class="pointer-events-none fixed inset-0 z-0 opacity-[0.03]">
       <div class="absolute inset-y-0 left-[20%] w-px bg-white"></div>
       <div class="absolute inset-y-0 left-[80%] w-px bg-white"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-[1250px] px-6 sm:px-12 lg:px-16">
      
      {/* 1. PROJECT HEADER: Compact Integrated ID */}
      <header class="mb-10 space-y-4 reveal">
        <div class="flex flex-wrap items-center gap-3 border-b border-white/10 pb-4">
          <div class="flex items-center gap-2">
             <div class="h-1.5 w-1.5 rounded-full bg-emerald-500 shadow-[0_0_5px_#10B981]"></div>
             <span class="font-mono text-[9px] font-black tracking-[0.3em] text-white/90 uppercase italic">{status || 'STABLE'}</span>
          </div>
          <span class="font-mono text-[9px] text-white/20">/</span>
          <span class="font-mono text-[9px] font-bold text-white/30 tracking-widest uppercase">{project.id.toUpperCase()}</span>
          <span class="font-mono text-[9px] text-white/20">/</span>
          <span class="font-mono text-[9px] font-bold text-white/30 tracking-widest uppercase italic">0x{projectShortTitle}_sys</span>
        </div>

        <div class="space-y-2">
           <h1 class="font-sans text-[clamp(1.8rem,7vw,3.2rem)] font-black tracking-tighter text-white leading-[1.05]">
             {title}<span class="text-lofi-accent animate-pulse italic">_</span>
           </h1>
           <p class="max-w-xl text-base font-normal leading-relaxed text-white/50" set:html={description} />
        </div>
      </header>

      {/* 2. DOSSIER ARCHITECTURE: Interleaved Narrative & Visuals */}
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16 items-start">
        
        {/* MEDIA: Secondary Figures (Interleaved) */}
        <div class="lg:col-span-8 space-y-12">
          
          {/* Main Primary View */}
          <div class="reveal reveal-scale">
            <div class="group relative rounded-xl border border-white/20 bg-lofi-base/40 p-1.5 backdrop-blur-md shadow-2xl transition-all duration-700 hover:border-lofi-accent/30">
               <div class="absolute -top-1 -right-1 h-3 w-3 border-t-2 border-r-2 border-lofi-accent/50"></div>
               <div class="absolute -bottom-1 -left-1 h-3 w-3 border-b-2 border-l-2 border-white/20"></div>
               
               <div class="overflow-hidden rounded-lg bg-[#050505] relative">
                  <div class="absolute inset-x-0 top-0 z-30 h-1/2 w-full animate-scanline bg-gradient-to-b from-transparent via-lofi-accent/5 to-transparent"></div>
                  <img src={mainImage} alt={title} class="w-full h-auto object-cover grayscale-[20%] transition-all duration-1000 group-hover:grayscale-0 group-hover:scale-[1.01]" />
                  <div class="absolute bottom-3 left-3 flex items-center gap-2 rounded border border-white/10 bg-black/60 px-2 py-1 font-mono text-[8px] text-white/60">
                     <span class="h-1 w-1 rounded-full bg-lofi-accent underline"></span>
                     PRIMARY_PAYLOAD::ROOT
                  </div>
               </div>
            </div>
          </div>

          {/* ASYMMETRIC NARRATIVE START */}
          <div class="reveal">
             <div class="flex items-center gap-4 mb-8">
                <span class="font-mono text-[10px] font-black tracking-[0.4em] text-white/30 uppercase">SYSTEM_LOGS</span>
                <div class="h-px flex-1 bg-white/5"></div>
             </div>
             
             <article class="prose prose-invert prose-lofi max-w-none">
                <div class="font-sans text-[15px] font-normal leading-relaxed text-white/60 space-y-8
                  prose-h2:font-sans prose-h2:text-xl prose-h2:font-black prose-h2:tracking-tight prose-h2:text-white prose-h2:mb-4
                  prose-p:mb-6
                  prose-strong:text-white prose-strong:font-black
                  prose-blockquote:border-l-2 prose-blockquote:border-lofi-accent prose-blockquote:bg-lofi-accent/[0.03] prose-blockquote:py-3 prose-blockquote:px-6 prose-blockquote:rounded-r-lg prose-blockquote:text-white/80">
                   <Content />
                </div>
             </article>
          </div>

          {/* INTERLEAVED GALLERY BREAK: Figures 01-02 */}
          {images && images.length > 0 && (
             <div class="grid grid-cols-1 md:grid-cols-2 gap-8 reveal">
                {images.slice(0, 2).map((img : string, i : number) => (
                   <div class="group relative rounded-lg border border-white/10 p-1 bg-black/40 transition-all hover:border-lofi-accent/20">
                      <div class="absolute top-2 left-2 z-20 font-mono text-[7px] text-white/30 tracking-widest uppercase">ASSET_REF_{i+1}</div>
                      <img src={img} alt={`Asset ${i}`} class="w-full aspect-[4/3] object-cover rounded shadow-inner opacity-80 group-hover:opacity-100 transition-opacity" />
                   </div>
                ))}
             </div>
          )}
        </div>

        {/* PROPERTY INSPECTOR: Compact Tight Column */}
        <aside class="lg:col-span-4 lg:sticky lg:top-12 space-y-8 reveal reveal-right delay-200">
          
          {/* CTAs: Streamlined */}
          <div class="grid grid-cols-1 gap-3">
             {liveUrl && (
                <a href={liveUrl} target="_blank" class="group flex items-center justify-between gap-3 overflow-hidden rounded-lg bg-white px-5 py-3 text-black transition-all hover:shadow-[0_0_20px_white/20] active:scale-95">
                   <div class="flex items-center gap-3">
                      <Icon name="tabler:rocket" size={16} class="text-black/60" />
                      <span class="font-mono text-[9px] font-black tracking-[0.2em] uppercase">ACCESS::STABLE</span>
                   </div>
                   <Icon name="tabler:arrow-up-right" size={12} class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                </a>
             )}
             {githubUrl && (
                <a href={githubUrl} target="_blank" class="group flex items-center justify-between gap-3 overflow-hidden rounded-lg border border-white/10 bg-black/40 px-5 py-3 text-white transition-all hover:border-lofi-accent/40 active:scale-95">
                   <div class="flex items-center gap-3">
                      <Icon name="tabler:brand-github" size={16} class="text-white/40 group-hover:text-lofi-accent transition-colors" />
                      <span class="font-mono text-[9px] font-black tracking-[0.2em] uppercase">DECRYPT::SRC</span>
                   </div>
                   <Icon name="tabler:code" size={12} class="text-white/20 group-hover:text-lofi-accent transition-colors" />
                </a>
             )}
          </div>

          {/* TECH STACK: Dynamic Gutter */}
          <div class="space-y-4 rounded-xl border border-white/5 bg-white/[0.01] p-5">
             <div class="flex items-center justify-between border-b border-white/5 pb-3">
                <span class="font-mono text-[9px] font-black tracking-[0.3em] text-white/20 uppercase">TECH_CORE</span>
                <span class="font-mono text-[9px] text-lofi-accent/60 italic overflow-hidden">[{techStack.length}]</span>
             </div>
             <div class="flex flex-wrap gap-2">
                {techStack.map((tech: string) => (
                   <span class="font-mono text-[9px] font-black text-white/50 tracking-tight uppercase hover:text-white transition-colors cursor-default">
                      {tech}
                   </span>
                ))}
             </div>
          </div>

          {/* PROJECT METADATA: High Index */}
          <div class="space-y-4 px-2">
             <div class="flex items-center justify-between gap-4">
                <span class="font-mono text-[8px] text-white/20 uppercase">INIT_BUILD</span>
                <span class="text-[10px] font-black text-white uppercase tracking-tighter">Q-01 // ARC-X</span>
             </div>
             <div class="flex items-center justify-between gap-4">
                <span class="font-mono text-[8px] text-white/20 uppercase">LOC_REG</span>
                <div class="h-1 w-24 rounded bg-white/5 overflow-hidden">
                   <div class="h-full w-2/3 bg-lofi-accent rounded animate-pulse"></div>
                </div>
             </div>
          </div>
        </aside>
      </div>

      {/* 3. ADDITIONAL ASSETS: Detailed Observation Grid */}
      {images && images.length > 2 && (
         <section class="mt-24 space-y-12">
            <div class="flex items-center gap-4">
               <span class="font-mono text-[10px] font-black tracking-[0.4em] text-white/10 uppercase">EXTENDED_ASSET_CACHE</span>
               <div class="h-px flex-1 bg-white/5"></div>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 reveal">
               {images.slice(2).map((img : string, i : number) => (
                  <div class="group relative rounded-xl border border-white/5 bg-white/[0.02] p-1 transition-all hover:bg-white/[0.04]">
                     <img src={img} alt={`Asset Cache ${i}`} class="w-full aspect-video object-cover rounded-lg grayscale-[40%] group-hover:grayscale-0 transition-all duration-700" loading="lazy" />
                     <div class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-all transform translate-x-2 group-hover:translate-x-0">
                        <span class="font-mono text-[7px] text-white bg-lofi-accent px-1.5 py-0.5 rounded italic">NODE_0x0{i+3}</span>
                     </div>
                  </div>
               ))}
            </div>
         </section>
      )}

      {/* 4. NEXT PROTOCOL NAVIGATION: Minimalist */}
      {nextProject && (
         <footer class="mt-32 pt-16 border-t border-white/10 reveal">
            <a href={`/${lang}/projects/${nextProject.id.split('/')[1]}`} class="group relative flex items-center justify-between p-8 rounded-2xl border border-white/5 bg-white/[0.01] hover:border-lofi-accent/20 transition-all overflow-hidden">
               <div class="space-y-2 relative z-10">
                  <span class="font-mono text-[8px] font-black tracking-[0.5em] text-white/20 uppercase">UPCOMING_MODULE</span>
                  <h4 class="font-sans text-2xl font-black tracking-tighter text-white group-hover:text-lofi-accent transition-colors">
                     {nextProject.data.title}
                  </h4>
               </div>
               <div class="flex items-center gap-4 relative z-10">
                  <span class="font-mono text-[9px] font-black text-white/20 uppercase hidden sm:block">REQUEST_INIT</span>
                  <div class="h-10 w-10 flex items-center justify-center rounded-full border border-white/10 text-white transition-all group-hover:bg-lofi-accent group-hover:border-lofi-accent group-hover:text-black">
                     <Icon name="tabler:chevron-right" size={20} />
                  </div>
               </div>
               <div class="absolute inset-0 bg-gradient-to-r from-lofi-accent/[0.03] to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            </a>
         </footer>
      )}
    </div>
  </div>
</PortfolioLayout>

<style>
   @keyframes scanline {
     0% { transform: translateY(-100%); }
     100% { transform: translateY(200%); }
   }
   .animate-scanline { animation: scanline 12s infinite linear; }
</style>
