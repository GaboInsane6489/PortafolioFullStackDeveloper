---
import { Icon } from "astro-icon/components";

const sections = [
  { label: "Overview", href: "#overview", icon: "tabler:layout-dashboard" },
  { label: "Proyectos", href: "#projects", icon: "tabler:folder" },
  { label: "Stack", href: "#stack", icon: "tabler:stack" },
  { label: "Contacto", href: "#contact", icon: "tabler:mail" },
];
---

<aside
  class="sticky top-16 h-[calc(100vh-4rem)]
         w-24 bg-black/40 backdrop-blur-md
         border-r border-white/10
         flex flex-col items-center py-16"
>
  <!-- Identificador -->
  <div
    class="w-10 h-10 border border-white/20 rounded-xl
           flex items-center justify-center
           text-xs font-bold mb-10"
  >
    <a href="#overview">
      <Icon name="tabler:timeline" size="20" />
    </a>
  </div>

  <!-- Navegación -->
  <nav class="flex-1 flex flex-col gap-8">
    {sections.map(section => (
      <a
        href={section.href}
        title={section.label}
        class="text-gray-500 hover:text-white transition"
      >
        <Icon name={section.icon} size="20" />
      </a>
    ))}
  </nav>
</aside>
